  <script>
    window.dataLayer = window.dataLayer || [];
    window.dlmAnalyticsContext = window.dlmAnalyticsContext || {};
    window.dlmAnalyticsContext.site_language = (function (rawLocale) {
      var normalized = String(rawLocale || '').trim();
      if (!normalized) return 'en';
      return normalized.split(/[-_]/)[0].toLowerCase();
    })({{ request.locale.iso_code | json }});
    window.dataLayer.push({ site_language: window.dlmAnalyticsContext.site_language });
  </script>

  <script defer src="{{ 'constants.js' | asset_url }}"></script>
  <script defer src="{{ 'pubsub.js' | asset_url }}"></script>
  <script defer src="{{ 'global.js' | asset_url }}"></script>
  {%- if request.page_type == 'index' -%}
    <script defer src="{{ 'homepage-collection-card-images.js' | asset_url }}"></script>
  {%- endif -%}
  <script>
    (function () {
      var analyticsUrl = {{ 'analytics.js' | asset_url | json }};
      if (!analyticsUrl) return;
      var hasLoaded = false;

      function loadAnalytics() {
        if (hasLoaded) return;
        hasLoaded = true;
        var script = document.createElement('script');
        script.src = analyticsUrl;
        script.defer = true;
        script.dataset.dlmAnalytics = 'true';
        document.head.appendChild(script);
      }

      function scheduleIdleLoad() {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadAnalytics, { timeout: 2500 });
        } else {
          window.setTimeout(loadAnalytics, 1800);
        }
      }

      window.addEventListener('load', scheduleIdleLoad, { once: true });
      document.addEventListener('pointerdown', loadAnalytics, { once: true, passive: true, capture: true });
      document.addEventListener('keydown', loadAnalytics, { once: true, capture: true });
    })();
  </script>
  {%- if settings.animations_reveal_on_scroll -%}
