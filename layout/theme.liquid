<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
<head>
<link rel="stylesheet" href="{{ 'component-list-social.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-payment.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rating.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'section-footer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'mask-blobs.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-newsletter.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'quantity-popover.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'quick-order-list.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'template-collection.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-volume-pricing.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-card.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'section-collection-list.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-slideshow.css' | asset_url }}" media="print" onload="this.media='all'">
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="theme-color" content="">
  {%- liquid
    assign resolved_canonical_url = canonical_url | default: request.url | default: request.origin
    if request.page_type == 'product' and resolved_canonical_url contains '?'
      assign resolved_canonical_url = resolved_canonical_url | split: '?' | first
    endif

    assign parameterized_product_noindex = false
    if request.page_type == 'product'
      assign request_query_string = request.query_string | default: ''
      if request_query_string != blank
        assign parameterized_product_noindex = true
      endif
    endif
  -%}
  {% comment %}theme-check-disable RemoteAsset{% endcomment %}
  <link rel="canonical" href="{{ resolved_canonical_url | escape }}">
  {% comment %}theme-check-enable RemoteAsset{% endcomment %}
 <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">

  {% if template == 'product' %}
  {%- assign taxonomy_category1 = product.metafields.custom.category1 | default: '' | strip -%}
  {%- assign taxonomy_subcategory = product.metafields.custom.subcategory | default: '' | strip -%}
  {%- assign taxonomy_type = product.metafields.custom.type | default: product.type | default: '' | strip -%}
  {%- assign taxonomy_style = product.metafields.custom.style | default: '' | strip -%}
  {%- assign taxonomy_pattern = product.metafields.custom.pattern | default: '' | strip -%}
  {%- for tag in product.tags -%}
    {%- assign normalized_tag = tag | strip -%}
    {%- assign normalized_tag_downcase = normalized_tag | downcase -%}
    {%- if taxonomy_category1 == blank and normalized_tag_downcase contains 'category1:' -%}
      {%- assign taxonomy_category1 = normalized_tag | split: ':' | last | strip -%}
    {%- elsif taxonomy_category1 == blank and normalized_tag_downcase contains 'category:' -%}
      {%- assign taxonomy_category1 = normalized_tag | split: ':' | last | strip -%}
    {%- endif -%}
    {%- if taxonomy_subcategory == blank and normalized_tag_downcase contains 'subcategory:' -%}
      {%- assign taxonomy_subcategory = normalized_tag | split: ':' | last | strip -%}
    {%- endif -%}
    {%- if taxonomy_type == blank and normalized_tag_downcase contains 'type:' -%}
      {%- assign taxonomy_type = normalized_tag | split: ':' | last | strip -%}
    {%- endif -%}
    {%- if taxonomy_style == blank and normalized_tag_downcase contains 'style:' -%}
      {%- assign taxonomy_style = normalized_tag | split: ':' | last | strip -%}
    {%- endif -%}
    {%- if taxonomy_pattern == blank and normalized_tag_downcase contains 'pattern:' -%}
      {%- assign taxonomy_pattern = normalized_tag | split: ':' | last | strip -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if taxonomy_category1 != blank -%}
  <meta name="custom-category1" content="{{ taxonomy_category1 | escape }}">
  {%- endif -%}
  {%- if taxonomy_subcategory != blank -%}
  <meta name="custom-subcategory" content="{{ taxonomy_subcategory | escape }}">
  {%- endif -%}
  {%- if taxonomy_type != blank -%}
  <meta name="custom-type" content="{{ taxonomy_type | escape }}">
  {%- endif -%}
  {%- if taxonomy_style != blank -%}
  <meta name="custom-style" content="{{ taxonomy_style | escape }}">
  {%- endif -%}
  {%- if taxonomy_pattern != blank -%}
  <meta name="custom-pattern" content="{{ taxonomy_pattern | escape }}">
  {%- endif -%}
  {%- assign product_lcp_media = product.featured_media -%}
  {%- if product_lcp_media == blank -%}
    {%- assign product_lcp_media = product.selected_or_first_available_variant.featured_media -%}
  {%- endif -%}
  {%- if product_lcp_media != blank and product_lcp_media.preview_image != blank -%}
    {%- assign product_lcp_image = product_lcp_media.preview_image -%}
    {% comment %}theme-check-disable AssetPreload{% endcomment %}
    <link
      rel="preload"
      as="image"
      href="{{ product_lcp_image | image_url: width: 823 }}"
      imagesrcset="
        {%- if product_lcp_image.width >= 493 -%}{{ product_lcp_image | image_url: width: 493 }} 493w,{%- endif -%}
        {%- if product_lcp_image.width >= 600 -%}{{ product_lcp_image | image_url: width: 600 }} 600w,{%- endif -%}
        {%- if product_lcp_image.width >= 713 -%}{{ product_lcp_image | image_url: width: 713 }} 713w,{%- endif -%}
        {%- if product_lcp_image.width >= 823 -%}{{ product_lcp_image | image_url: width: 823 }} 823w,{%- endif -%}
        {%- if product_lcp_image.width >= 990 -%}{{ product_lcp_image | image_url: width: 990 }} 990w,{%- endif -%}
        {%- if product_lcp_image.width >= 1100 -%}{{ product_lcp_image | image_url: width: 1100 }} 1100w,{%- endif -%}
        {{ product_lcp_image | image_url }} {{ product_lcp_image.width }}w
      "
      imagesizes="(min-width: 990px) 50vw, 100vw"
    >
    {% comment %}theme-check-enable AssetPreload{% endcomment %}
  {%- endif -%}
  {% endif %}

  {%- liquid
    assign resolved_page_title = page_title
    assign resolved_page_description = page_description
    assign collection_seo_display_title = blank
    assign collection_seo_meta_title = blank
    assign collection_seo_meta_description = blank
    assign collection_seo_force_theme = blank
    assign product_seo_description = blank
    assign append_shop_name_to_title = true

    if request.page_type == 'collection' and collection != blank
      capture collection_seo_display_title
        render 'collection-seo-fallback', collection: collection, field: 'display_title'
      endcapture
      assign collection_seo_display_title = collection_seo_display_title | strip

      capture collection_seo_meta_title
        render 'collection-seo-fallback', collection: collection, field: 'meta_title'
      endcapture
      assign collection_seo_meta_title = collection_seo_meta_title | strip

      capture collection_seo_meta_description
        render 'collection-seo-fallback', collection: collection, field: 'meta_description'
      endcapture
      assign collection_seo_meta_description = collection_seo_meta_description | strip

      capture collection_seo_force_theme
        render 'collection-seo-fallback', collection: collection, field: 'force_theme_seo'
      endcapture
      assign collection_seo_force_theme = collection_seo_force_theme | strip
    elsif request.page_type == 'product' and product != blank
      capture product_seo_description
        render 'product-seo-description-fallback', product: product, collection: collection, page_description: resolved_page_description
      endcapture
      assign product_seo_description = product_seo_description | strip
    endif

    if request.page_type == 'index'
      assign resolved_page_title = 'Mommy and Me Dresses | Family Matching Outfits'
      assign resolved_page_description = 'Shop mommy and me dresses, mother daughter matching outfits, and family matching clothes for photos, vacations, and everyday moments.'
      assign append_shop_name_to_title = false
    elsif request.page_type == 'blog' and blog != blank and blog.handle == 'news'
      assign resolved_page_title = 'Style Journal'
    endif

    if request.page_type == 'collection' and collection != blank
      if collection_seo_force_theme == 'true'
        assign append_shop_name_to_title = false
        if collection_seo_meta_title != blank
          assign resolved_page_title = collection_seo_meta_title
        elsif collection_seo_display_title != blank
          assign resolved_page_title = collection_seo_display_title
        endif
      elsif collection.handle == 'all' or collection.handle == 'swimsuits' or resolved_page_title == blank or resolved_page_title == collection.title
        if collection_seo_meta_title != blank
          assign resolved_page_title = collection_seo_meta_title
        elsif collection_seo_display_title != blank
          assign resolved_page_title = collection_seo_display_title
        endif
      endif
    endif

    if request.page_type == 'collection' and collection != blank and collection_seo_force_theme == 'true' and collection_seo_meta_description != blank
      assign resolved_page_description = collection_seo_meta_description
    elsif request.page_type == 'product' and product != blank and product_seo_description != blank
      assign resolved_page_description = product_seo_description
    elsif resolved_page_description == blank
      if request.page_type == 'collection' and collection != blank and collection_seo_meta_description != blank
        assign resolved_page_description = collection_seo_meta_description
      elsif request.page_type == 'blog' and blog != blank and blog.handle == 'news'
        assign resolved_page_description = 'Outfit guides, styling tips, and shopping advice for mommy and me, daddy and me, and family matching looks.'
      elsif request.page_type == 'article' and article != blank
        assign resolved_page_description = article.excerpt | default: article.content | strip_html | truncatewords: 28
      endif
    endif

    if resolved_page_description != blank
      assign resolved_page_description = resolved_page_description | replace: '30-day easy returns', 'easy returns' | replace: '30-Day Easy Returns', 'Easy Returns' | replace: '30-DAY EASY RETURNS', 'EASY RETURNS'
    endif
  -%}

  <!-- Title and Meta Description for SEO -->
  <title>
    {{ resolved_page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- if append_shop_name_to_title -%}
      {%- unless resolved_page_title contains shop.name -%} &ndash; {{ shop.name }}{%- endunless -%}
    {%- endif -%}
  </title>
  {% if resolved_page_description %}
  <meta name="description" content="{{ resolved_page_description | replace: '30-day ', '' | replace: '30-Day ', '' | replace: '30-DAY ', '' | escape }}">
  {% endif %}

  <!-- Other Meta Tags -->
  <meta name="theme-color" content="{{ settings.color_theme }}">
  <meta name="author" content="{{ shop.name | escape }}">

