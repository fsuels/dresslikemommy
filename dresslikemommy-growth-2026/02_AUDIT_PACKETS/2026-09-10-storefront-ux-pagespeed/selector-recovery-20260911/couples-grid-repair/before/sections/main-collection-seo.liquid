{% if collection != blank %}
  {%- liquid
    capture collection_seo_display_title
      render 'collection-seo-fallback', collection: collection, field: 'display_title'
    endcapture
    assign collection_seo_display_title = collection_seo_display_title | strip
    assign collection_seo_display_title_escaped = collection_seo_display_title | escape

    capture collection_seo_hero_summary
      render 'collection-seo-fallback', collection: collection, field: 'hero_summary'
    endcapture
    assign collection_seo_hero_summary = collection_seo_hero_summary | strip

    capture collection_seo_body_description
      render 'collection-seo-fallback', collection: collection, field: 'body_description'
    endcapture
    assign collection_seo_body_description = collection_seo_body_description | strip
    assign collection_seo_body_description_render = collection_seo_body_description

    if collection_seo_body_description != blank and collection_seo_hero_summary != blank and collection_seo_body_description contains '</p>'
      assign first_body_paragraph = collection_seo_body_description | split: '</p>' | first | append: '</p>' | strip
      if first_body_paragraph == collection_seo_hero_summary
        assign collection_seo_body_description_render = collection_seo_body_description | replace_first: first_body_paragraph, '' | strip
      endif
    endif

    capture collection_seo_rich_content
      render 'collection-seo-content', collection: collection, field: 'rich_content'
    endcapture
    assign collection_seo_rich_content = collection_seo_rich_content | strip
  -%}

  {% if collection.handle == 'swimsuits' %}
    {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
    {{ 'section-collection-seo.css' | asset_url | stylesheet_tag }}

    {%- liquid
      assign related_family_swim_url = routes.collections_url | append: '/family-swimsuits'
      assign related_trunks_url = routes.collections_url | append: '/trunks'
      assign related_mommy_me_url = routes.collections_url | append: '/mommy-and-me'

      assign faq_question_1 = 'sections.collection_seo.swimsuits.faq_question_1' | t
      assign faq_answer_1 = 'sections.collection_seo.swimsuits.faq_answer_1' | t

      assign faq_question_2 = 'sections.collection_seo.swimsuits.faq_question_2' | t
      assign faq_answer_2 = 'sections.collection_seo.swimsuits.faq_answer_2' | t

      assign faq_question_3 = 'sections.collection_seo.swimsuits.faq_question_3' | t
      assign faq_answer_3 = 'sections.collection_seo.swimsuits.faq_answer_3' | t

      assign faq_question_4 = 'sections.collection_seo.swimsuits.faq_question_4' | t
      assign faq_answer_4 = 'sections.collection_seo.swimsuits.faq_answer_4' | t

      capture faq_answer_2_rich
        echo 'sections.collection_seo.swimsuits.faq_answer_2_rich_html' | t: family_swim_url: related_family_swim_url, trunks_url: related_trunks_url
      endcapture
      assign faq_answer_2_rich = faq_answer_2_rich | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'

      capture faq_answer_4_rich
        echo 'sections.collection_seo.swimsuits.faq_answer_4_rich_html' | t: family_swim_url: related_family_swim_url, trunks_url: related_trunks_url
      endcapture
      assign faq_answer_4_rich = faq_answer_4_rich | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
    -%}
  {% endif %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {% if collection.handle == 'swimsuits' %}
    <section class="collection-seo page-width section-{{ section.id }}-padding">
      <div class="collection-seo__panel color-{{ section.settings.color_scheme }} gradient">
        <div class="collection-seo__content">
          <p class="collection-seo__eyebrow">{{ 'sections.collection_seo.swimsuits.eyebrow' | t }}</p>
          <h2 class="collection-seo__title">{{ 'sections.collection_seo.swimsuits.title' | t }}</h2>
          <div class="collection-seo__copy">
            <p>{{ 'sections.collection_seo.swimsuits.copy_1' | t }}</p>
            <p>{{ 'sections.collection_seo.swimsuits.copy_2' | t }}</p>
          </div>
        </div>

        <aside class="collection-seo__aside" aria-label="{{ 'sections.collection_seo.swimsuits.related_aria' | t }}">
          <p class="collection-seo__aside-label">{{ 'sections.collection_seo.swimsuits.related_label' | t }}</p>
          <a href="{{ related_family_swim_url }}" class="collection-seo__link-card">
            <span class="collection-seo__link-title">{{ 'sections.collection_seo.swimsuits.family_swimwear_title' | t }}</span>
            <span class="collection-seo__link-caption">{{ 'sections.collection_seo.swimsuits.family_swimwear_caption' | t }}</span>
          </a>
          <a href="{{ related_trunks_url }}" class="collection-seo__link-card">
            <span class="collection-seo__link-title">{{ 'sections.collection_seo.swimsuits.trunks_title' | t }}</span>
            <span class="collection-seo__link-caption">{{ 'sections.collection_seo.swimsuits.trunks_caption' | t }}</span>
          </a>
          <a href="{{ related_mommy_me_url }}" class="collection-seo__link-card">
            <span class="collection-seo__link-title">{{ 'sections.breadcrumbs.cat_mommy_me' | t }}</span>
            <span class="collection-seo__link-caption">{{ 'sections.collection_seo.swimsuits.mommy_me_caption' | t }}</span>
          </a>
        </aside>
      </div>

      <div class="collection-seo__faq-card color-{{ section.settings.color_scheme }} gradient">
        <div class="collection-seo__faq-header">
          <p class="collection-seo__eyebrow">{{ 'sections.collection_seo.swimsuits.faq_eyebrow' | t }}</p>
          <h2 class="collection-seo__faq-title">{{ 'sections.collection_seo.swimsuits.faq_title' | t }}</h2>
        </div>

        <div class="collection-seo__faq-list">
          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_1 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>{{ faq_answer_1 }}</p>
              </div>
            </details>
          </div>

          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_2 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>{{ faq_answer_2_rich }}</p>
              </div>
            </details>
          </div>

          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_3 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>{{ faq_answer_3 }}</p>
              </div>
            </details>
          </div>

          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_4 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>{{ faq_answer_4_rich }}</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": {{ faq_question_1 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_1 | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ faq_question_2 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_2 | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ faq_question_3 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_3 | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ faq_question_4 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_4 | json }}
          }
        }
      ]
    }
    </script>
  {% elsif collection_seo_rich_content != blank %}
    {{ 'section-collection-seo.css' | asset_url | stylesheet_tag }}

    <section class="collection-seo-rich page-width page-width--narrow section-{{ section.id }}-padding">
      <div class="collection-seo-rich__panel rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ collection_seo_rich_content }}
      </div>
    </section>

    {% render 'faq-schema-from-html', content: collection_seo_rich_content %}
  {% elsif collection_seo_body_description_render != blank %}
    {{ 'section-collection-seo.css' | asset_url | stylesheet_tag }}

    <section class="collection-seo-rich page-width page-width--narrow section-{{ section.id }}-padding">
      <div class="collection-seo-rich__panel rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        <div class="collection-seo-rich__intro">
          <p class="collection-seo-rich__eyebrow">{{ 'sections.collection_seo.note_eyebrow' | t }}</p>
          <h2>{{ 'sections.collection_seo.closer_look_at' | t: title: collection_seo_display_title_escaped }}</h2>
        </div>
        <div class="collection-seo-rich__copy">
          {{ collection_seo_body_description_render }}
        </div>
      </div>
    </section>

    {% render 'faq-schema-from-html', content: collection_seo_body_description_render %}
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Collection SEO content",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ]
}
{% endschema %}
