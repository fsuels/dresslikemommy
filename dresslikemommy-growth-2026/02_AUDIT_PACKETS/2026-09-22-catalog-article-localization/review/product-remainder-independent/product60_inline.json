  {
    "i": 17,
    "locale": "sv",
    "text": "Unik design: Beige stickade tröjor i oversizemodell med ett tydligt svart hjärtmärke.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 18,
    "locale": "sv",
    "text": "Trendig streetwearstil: Har ärmar i denimstil och slitna detaljer i nederkanten.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 19,
    "locale": "sv",
    "text": "Bekväm passform: Lös och avslappnad passform för en snygg, ledig känsla.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 20,
    "locale": "sv",
    "text": "Matchande familjeset: Finns för vuxna och barn, perfekt för samordnade kläder.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 21,
    "locale": "sv",
    "text": "Mångsidig stil: Perfekt som vardagskläder, för familjeutflykter eller en trendig streetwearstil.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 22,
    "locale": "sv",
    "text": "Ta familjens stil till nästa nivå med våra Matchande familjetröjor i oversizemodell med hjärtmärken . De här snygga beige stickade tröjorna har iögonfallande svarta hjärtmärken och ärmar i denimstil som förenar mysig komfort med trendig stil. Den stora passformen och de slitna detaljerna i nederkanten skapar en avslappnad streetwearstil som passar moderna, modeintresserade familjer.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 23,
    "locale": "sv",
    "text": "Trendig design: Moderiktig oversizepassform med tydliga hjärtmärken.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 24,
    "locale": "sv",
    "text": "Perfekta för familjer: Storlekar för män, kvinnor och barn för en snygg familjestil.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 25,
    "locale": "sv",
    "text": "Hållbar komfort: Stickat material av hög kvalitet som andas för maximal komfort.",
    "tuples": [
      "7241201942625:sv"
    ]
  },
  {
    "i": 26,
    "locale": "sv",
    "text": "Mångsidig användning: Passar som avslappnad streetwear, vid familjeevenemang eller för vardagsutflykter.",
    "tuples": [
      "7241201942625:sv"
    ]
  }
]
