name = "dlm-merchant-feed-worker"
main = "src/worker.js"
compatibility_date = "2026-07-01"
workers_dev = true

# Supply MERCHANT_CONFIG_JSON from a reviewed copy of config.example.json.
# Store SHOPIFY_ADMIN_ACCESS_TOKEN with `wrangler secret put`; never in this file.
# A full US scan is expected to exceed the free plan's 50 external subrequests.
# Root must verify the current account's supported Worker limits before activation.
[triggers]
crons = ["0 */6 * * *"]

[[r2_buckets]]
binding = "MERCHANT_FEED_BUCKET"
bucket_name = "dlm-merchant-feeds"
