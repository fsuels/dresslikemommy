      </button>
    </div>
    <div class="dlm-policy-modal__body">
      <ul>
        <li>{{ dpm_privacy_line_1 }}</li>
        <li>{{ dpm_privacy_line_2 }}</li>
        <li>{{ dpm_privacy_line_3 }}</li>
        <li>{{ dpm_privacy_line_4 }}</li>
        <li>{{ dpm_privacy_line_5 }}</li>
      </ul>
    </div>
