        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>
  </div>
</div>

<script>
  (function () {
    if (window.DLMPolicyModal) return;

    var FOCUSABLE = [
      'a[href]',
      'area[href]',
      'button:not([disabled])',
      'input:not([disabled]):not([type="hidden"])',
      'select:not([disabled])',
      'textarea:not([disabled])',
      '[tabindex]:not([tabindex="-1"])'
    ].join(',');

    var openModal = null;
    var lastTrigger = null;
    var keydownHandler = null;

    function getModal(key) {
      return document.querySelector('[data-policy-modal="' + key + '"]');
    }

    function lockScroll() {
      // Lock the document (not <body>) — matches the shipping-country
      // checker and avoids reflowing sticky/fixed PDP elements.
      document.documentElement.classList.add('dlm-policy-modal-open');
    }

    function unlockScroll() {
      document.documentElement.classList.remove('dlm-policy-modal-open');
    }

    function trapFocus(modal, event) {
      var nodes = modal.querySelectorAll(FOCUSABLE);
      if (!nodes.length) return;
      var first = nodes[0];
      var last = nodes[nodes.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    function open(modal, trigger) {
      if (!modal || openModal === modal) return;
      if (openModal) close();
      openModal = modal;
      lastTrigger = trigger || null;
      modal.setAttribute('data-open', '');
      modal.setAttribute('aria-hidden', 'false');
      lockScroll();

      // Focus the dialog so screen readers announce the heading,
      // then move to the first focusable on next tick for keyboard users.
      var dialog = modal.querySelector('.dlm-policy-modal__dialog');
      if (dialog) {
        try { dialog.focus({ preventScroll: true }); } catch (e) { dialog.focus(); }
      }
      window.requestAnimationFrame(function () {
        var firstFocusable = modal.querySelector(FOCUSABLE);
        if (firstFocusable) {
          try { firstFocusable.focus({ preventScroll: true }); } catch (e) { firstFocusable.focus(); }
        }
      });

      keydownHandler = function (event) {
        if (event.key === 'Escape' || event.key === 'Esc') {
          event.stopPropagation();
          close();
        } else if (event.key === 'Tab') {
          trapFocus(modal, event);
        }
      };
      document.addEventListener('keydown', keydownHandler, true);
    }

    function close() {
      if (!openModal) return;
      var modal = openModal;
      modal.removeAttribute('data-open');
      modal.setAttribute('aria-hidden', 'true');
      unlockScroll();
      if (keydownHandler) {
        document.removeEventListener('keydown', keydownHandler, true);
        keydownHandler = null;
      }
      openModal = null;
      if (lastTrigger && typeof lastTrigger.focus === 'function') {
        try { lastTrigger.focus({ preventScroll: true }); } catch (e) { lastTrigger.focus(); }
      }
      lastTrigger = null;
    }

    document.addEventListener('click', function (event) {
      // Close handlers (backdrop + close button).
      var closeEl = event.target.closest('[data-policy-modal-close]');
      if (closeEl && openModal && openModal.contains(closeEl)) {
        event.preventDefault();
        close();
        return;
      }

      var trigger = event.target.closest('[data-policy-modal-trigger]');
      if (!trigger) return;

      // Respect modified clicks so right-click / cmd-click / middle-click
      // / shift-click can still open the real policy page in a new tab.
      if (event.defaultPrevented) return;
      if (event.button && event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      var key = trigger.getAttribute('data-policy-modal-trigger');
      var modal = getModal(key);
      if (!modal) return;

      event.preventDefault();
      open(modal, trigger);
    });

    window.DLMPolicyModal = { open: function (key) { open(getModal(key)); }, close: close };
  })();
</script>
