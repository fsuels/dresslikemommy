    "operations": {
      "order_operation": "query GrowthHeartbeatDelta($filter: String!, $after: String) {\n  shop { name ianaTimezone currencyCode primaryDomain { host } }\n  orders(first: 50, after: $after, query: $filter, sortKey: CREATED_AT) {\n    nodes {\n      id createdAt test cancelledAt sourceName\n      displayFinancialStatus displayFulfillmentStatus\n      currentSubtotalPriceSet { shopMoney { amount currencyCode } }\n      currentTotalPriceSet { shopMoney { amount currencyCode } }\n      currentTotalTaxSet { shopMoney { amount currencyCode } }\n      totalRefundedSet { shopMoney { amount currencyCode } }\n      lineItems(first:50) {\n        nodes { currentQuantity product { id } variant { id } }\n        pageInfo { hasNextPage endCursor }\n      }\n    }\n    pageInfo { hasNextPage endCursor }\n  }\n}",
      "fulfillment_operation": "query ChangedBasketFulfillment($id: ID!) {\n  shop { name primaryDomain { host } currencyCode }\n  order(id: $id) {\n    displayFinancialStatus displayFulfillmentStatus\n    currentSubtotalPriceSet { shopMoney { amount currencyCode } }\n    totalRefundedSet { shopMoney { amount currencyCode } }\n    fulfillments(first:50) {\n      status displayStatus totalQuantity deliveredAt inTransitAt estimatedDeliveryAt\n      trackingInfo { company }\n      fulfillmentLineItems(first:50) {\n        nodes { quantity lineItem { product { id } variant { id } } }\n        pageInfo { hasNextPage endCursor }\n      }\n      events(first:50) {\n        nodes { status happenedAt }\n        pageInfo { hasNextPage endCursor }\n      }\n    }\n  }\n}"
    }
  },
