  "query": "query DLMQualifiedOrders($query: String!, $after: String) {\n  shop { id name ianaTimezone currencyCode primaryDomain { host } }\n  orders(first: 50, after: $after, sortKey: CREATED_AT, query: $query) {\n    pageInfo { hasNextPage endCursor }\n    nodes {\n      id createdAt test cancelledAt sourceName displayFinancialStatus displayFulfillmentStatus\n      currentSubtotalPriceSet { shopMoney { amount currencyCode } }\n      currentTotalPriceSet { shopMoney { amount currencyCode } }\n      currentTotalTaxSet { shopMoney { amount currencyCode } }\n      totalRefundedSet { shopMoney { amount currencyCode } }\n      lineItems(first: 50) { pageInfo { hasNextPage endCursor } nodes { currentQuantity } }\n      fulfillments {\n        status displayStatus totalQuantity deliveredAt inTransitAt\n        events(first: 50) { pageInfo { hasNextPage endCursor } nodes { status happenedAt } }\n      }\n    }\n  }\n}",
