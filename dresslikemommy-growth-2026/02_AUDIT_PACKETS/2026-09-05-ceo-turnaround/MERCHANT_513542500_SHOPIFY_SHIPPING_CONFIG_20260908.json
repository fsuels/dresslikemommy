  "queries": {
    "inventory": "query MerchantShippingProfileInventory20260908($after: String) {\n  shop { id name myshopifyDomain currencyCode }\n  deliveryProfiles(first: 50, after: $after) {\n    nodes { id name default version activeMethodDefinitionsCount zoneCountryCount originLocationCount locationsWithoutRatesCount }\n    pageInfo { hasNextPage endCursor }\n  }\n}",
    "zones_rates": "query MerchantShippingZonesRates20260908($after: String) {\n  shop { id name myshopifyDomain currencyCode }\n  deliveryProfiles(first: 5, after: $after) {\n    nodes {\n      id name default version activeMethodDefinitionsCount zoneCountryCount originLocationCount locationsWithoutRatesCount\n      profileLocationGroups {\n        locationGroupZones(first: 10) {\n          nodes {\n            zone { id name countries { name code { countryCode restOfWorld } provinces { name code } } }\n            methodDefinitions(first: 10) {\n              nodes {\n                id name description active\n                methodConditions { field operator conditionCriteria { __typename } }\n                rateProvider {\n                  __typename\n                  ... on DeliveryRateDefinition { price { amount currencyCode } }\n                  ... on DeliveryParticipant { fixedFee { amount currencyCode } percentageOfRateFee }\n                }\n              }\n              pageInfo { hasNextPage endCursor }\n            }\n          }\n          pageInfo { hasNextPage endCursor }\n        }\n      }\n    }\n    pageInfo { hasNextPage endCursor }\n  }\n}",
    "weight_bounds": "query MerchantPriorityWeightBounds20260908($ids: [ID!]!) {\n  nodes(ids: $ids) {\n    ... on DeliveryMethodDefinition {\n      id\n      methodConditions {\n        field operator\n        conditionCriteria { __typename ... on Weight { value unit } }\n      }\n    }\n  }\n}",
    "weight_variables": {
