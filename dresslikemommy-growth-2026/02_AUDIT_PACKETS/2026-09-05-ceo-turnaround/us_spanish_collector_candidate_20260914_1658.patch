+
+test('legacy frozen snapshots preserve their original array behavior without invented scope provenance', async () => {
+  const p = product();
+  p.translations = [global('title', 'Conjunto azul a juego'), global('body_html', '<p>Conjunto azul de dos piezas.</p>')]
