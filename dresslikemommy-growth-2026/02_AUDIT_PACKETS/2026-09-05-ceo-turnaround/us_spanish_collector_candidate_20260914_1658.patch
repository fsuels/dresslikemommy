+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { collectCatalog } from '../src/collector.js';
+import { buildFeed } from '../src/generator.js';
+import { PRODUCTS_QUERY } from '../src/queries.js';
+import { config, market, now, product, snapshot, source } from './fixtures.js';
+
+const target = { ...market, key: 'us-es', locale: 'es', marketId: 'gid://shopify/Market/544735329',
+  landingBaseUrl: `${market.landingBaseUrl}/es`, landingQuery: { country: 'US', currency: 'USD' } };
+const global = (key, value, outdated = false) => ({ key, value, locale: 'es', outdated, market: null });
+const override = (key, value, outdated = false) => ({ ...global(key, value, outdated), market: { id: target.marketId } });
+function translated(id = 1) {
+  const p = product(id);
+  delete p.translations;
+  p.globalTranslations = [global('title', 'Conjunto azul a juego'), global('body_html', '<p>Conjunto azul de dos piezas.</p>')];
+  p.marketTranslations = [];
+  return p;
+}
+function apiFor(products) {
+  const requests = [];
+  const api = source(products, { intercept: (result, query, variables) => {
+    requests.push({ query, variables });
+    if (query.includes('query MerchantFeedIdentity')) result.shopLocales.push({ locale: 'es', primary: false, published: true });
+  } });
+  return { ...api, requests };
+}
+async function collect(products = [translated()], requested = target) {
+  const api = apiFor(products);
+  return { data: await collectCatalog(api.graphql, config, requested, { now: () => now }), api };
+}
+const build = (data, requested = target) => buildFeed(data, config, requested, { now });
+function failed(result, code) {
+  assert.equal(result.ok, false);
+  assert.equal(result.tsv, null);
+  assert.deepEqual(result.rows, []);
+  assert.deepEqual(result.rowIds, []);
+  assert.ok(result.diagnostics.errors.some(error => error.code === code));
+}
+
+test('one product query distinguishes global and market records with returned scope', () => {
+  assert.match(PRODUCTS_QUERY, /globalTranslations:\s*translations\(locale: \$locale\)/);
+  assert.match(PRODUCTS_QUERY, /marketTranslations:\s*translations\(locale: \$locale, marketId: \$marketId\)/);
+  assert.equal((PRODUCTS_QUERY.match(/market\s*\{\s*id\s*\}/g) || []).length, 2);
+  assert.match(PRODUCTS_QUERY, /globalTranslations:[^\n]+@include\(if: \$includeTranslations\)/);
+  assert.match(PRODUCTS_QUERY, /marketTranslations:[^\n]+@include\(if: \$includeMarketTranslations\)/);
+});
+
+test('absent override uses fresh global Spanish, retains raw scopes and records field provenance', async () => {
+  const p = translated(), original = structuredClone(p);
+  const { data, api } = await collect([p]);
+  assert.equal(api.calls(), 5, 'global and market content must share the existing product-page operation');
+  assert.deepEqual(data.products[0].globalTranslations, original.globalTranslations);
+  assert.deepEqual(data.products[0].marketTranslations, []);
+  assert.deepEqual(data.products[0].translations, original.globalTranslations);
+  assert.deepEqual(data.products[0].translationProvenance, {
+    locale: 'es', marketId: target.marketId,
+    fields: {
+      title: { scope: 'global', locale: 'es', marketId: null, outdated: false },
+      body_html: { scope: 'global', locale: 'es', marketId: null, outdated: false },
+      handle: { scope: 'source_handle', locale: null, marketId: null, outdated: null },
+    },
+  });
+  const request = api.requests.find(r => r.query.includes('query MerchantFeedProducts'));
+  assert.equal(request.variables.includeTranslations, true);
+  assert.equal(request.variables.includeMarketTranslations, true);
+  assert.equal(request.variables.marketId, target.marketId);
+  assert.equal(request.variables.country, 'US');
+  assert.equal(request.variables.locale, 'es');
+  const result = await build(data);
+  assert.equal(result.ok, true);
+  assert.equal(result.rows[0].title, 'Conjunto azul a juego');
+  assert.equal(result.rows[0].description, 'Conjunto azul de dos piezas.');
+  assert.equal(result.rows[0].id, 'shopify_US_1_101');
+  assert.equal(result.rows[0].item_group_id, 'shopify_US_1');
+  assert.equal(result.rows[0].price, '21.90 USD');
+  assert.equal(result.rows[0].link, 'https://www.dresslikemommy.com/es/products/matching-outfit-1?country=US&currency=USD&variant=101');
+  assert.equal(result.rows[0].excluded_destination, 'Shopping_ads');
+  assert.ok(!result.tsv.includes('Matching blue outfit') && !result.tsv.includes('Two-piece blue outfit.'));
+  delete data.products[0].globalTranslations; delete data.products[0].marketTranslations;
+  failed(await build(data), 'translation_scopes_missing');
+});
+
+test('current override wins by field, including over a stale lower-priority global field', async () => {
+  const p = translated(); p.globalTranslations[0].outdated = true;
+  p.marketTranslations = [override('title', 'Conjunto azul para Estados Unidos')];
+  const { data } = await collect([p]), result = await build(data);
+  assert.equal(result.ok, true);
+  assert.equal(result.rows[0].title, 'Conjunto azul para Estados Unidos');
+  assert.equal(result.rows[0].description, 'Conjunto azul de dos piezas.');
+  assert.equal(data.products[0].translationProvenance.fields.title.scope, 'market');
+  assert.equal(data.products[0].translationProvenance.fields.title.marketId, target.marketId);
+  assert.equal(data.products[0].translationProvenance.fields.body_html.scope, 'global');
+  assert.equal(data.products[0].globalTranslations[0].outdated, true);
+});
+
+test('stale title or body override cannot fall through to fresh global content or publish partial rows', async () => {
+  for (const key of ['title', 'body_html']) {
+    const p = translated(); p.marketTranslations = [override(key, 'Contenido del mercado anterior', true)];
+    const { data } = await collect([p, translated(2)]);
+    const selected = data.products[0].translations.find(t => t.key === key);
+    assert.equal(selected.outdated, true);
+    assert.equal(data.products[0].translationProvenance.fields[key].scope, 'market');
+    failed(await build(data), 'missing_or_stale_translation');
+  }
+});
+
+test('missing, stale and empty required global fields fail without English or cached-value fallback', async () => {
+  for (const key of ['title', 'body_html']) {
+    for (const mode of ['missing', 'stale', 'empty']) {
+      const p = translated();
+      if (mode === 'missing') p.globalTranslations = p.globalTranslations.filter(t => t.key !== key);
+      else if (mode === 'stale') p.globalTranslations.find(t => t.key === key).outdated = true;
+      else p.globalTranslations.find(t => t.key === key).value = '';
+      p.translations = [global('title', 'Cached title must not be used'), global('body_html', 'Cached English body must not be used')];
+      const { data } = await collect([p]);
+      failed(await build(data), 'missing_or_stale_translation');
+    }
+  }
+});
+
+test('translated handle uses global then market precedence, with the base handle only when absent', async () => {
+  const p = translated(); p.globalTranslations.push(global('handle', 'conjunto-azul'));
+  let result = await build((await collect([p])).data);
+  assert.ok(result.rows[0].link.includes('/es/products/conjunto-azul?'));
+  p.marketTranslations = [override('handle', 'conjunto-azul-estados-unidos')];
+  p.globalTranslations.find(t => t.key === 'handle').outdated = true;
+  const { data } = await collect([p]); result = await build(data);
+  assert.equal(result.ok, true);
+  assert.ok(result.rows[0].link.includes('/es/products/conjunto-azul-estados-unidos?'));
+  assert.equal(data.products[0].translationProvenance.fields.handle.scope, 'market');
+  p.marketTranslations = []; p.globalTranslations = p.globalTranslations.filter(t => t.key !== 'handle');
+  result = await build((await collect([p])).data);
+  assert.ok(result.rows[0].link.includes('/es/products/matching-outfit-1?'));
+});
+
+test('stale selected handles fail even when a fresh global handle exists', async () => {
+  const p = translated(); p.globalTranslations.push(global('handle', 'conjunto-azul'));
+  p.marketTranslations = [override('handle', 'conjunto-anterior', true)];
+  failed(await build((await collect([p])).data), 'stale_handle_translation');
+  p.marketTranslations = []; p.globalTranslations.find(t => t.key === 'handle').outdated = true;
+  failed(await build((await collect([p])).data), 'stale_handle_translation');
+});
+
+test('an explicit empty translated handle is rejected rather than relabeled as an absent handle', async () => {
+  for (const scope of ['globalTranslations', 'marketTranslations']) {
+    const p = translated(); p[scope].push(scope === 'globalTranslations' ? global('handle', '') : override('handle', ' '));
+    await assert.rejects(collect([p]), /empty_handle_translation/);
+  }
+});
+
+test('new collection requires complete and correctly scoped arrays, locale, boolean freshness and unique keys', async () => {
+  const cases = [
+    [p => { delete p.globalTranslations; }, 'translation_scopes_missing'],
+    [p => { delete p.marketTranslations; }, 'translation_scopes_missing'],
+    [p => { p.globalTranslations[0].market = { id: target.marketId }; }, 'translation_scope_mismatch'],
+    [p => { delete p.globalTranslations[0].market; }, 'translation_scope_mismatch'],
+    [p => { p.marketTranslations = [override('title', 'Otro mercado')]; p.marketTranslations[0].market.id = 'gid://shopify/Market/999'; }, 'translation_scope_mismatch'],
+    [p => { p.globalTranslations[0].locale = 'en'; }, 'translation_locale_mismatch'],
+    [p => { delete p.globalTranslations[0].outdated; }, 'invalid_translation_record'],
+    [p => { p.globalTranslations[0].value = null; }, 'invalid_translation_record'],
+    [p => { p.globalTranslations.push(global('title', 'Otro titulo')); }, 'duplicate_translation_key'],
+  ];
+  for (const [mutate, code] of cases) {
+    const p = translated(); mutate(p);
+    await assert.rejects(collect([p]), new RegExp(code));
+    failed(await build(snapshot([p], target)), code);
+  }
+});
+
+test('a locale without an explicit market resolves global content without assuming market provenance', async () => {
+  const unscoped = { ...target, marketId: null }, p = translated(); delete p.marketTranslations;
+  const { data, api } = await collect([p], unscoped), result = await build(data, unscoped);
+  assert.equal(result.ok, true);
+  assert.equal(data.products[0].translationProvenance.marketId, null);
+  assert.equal(data.products[0].translationProvenance.fields.title.scope, 'global');
+  assert.equal(api.requests.find(r => r.query.includes('query MerchantFeedProducts')).variables.includeMarketTranslations, false);
+});
+
+test('primary-English output keeps its frozen byte hash and does not use the translation scopes', async () => {
+  const p = translated(); p.marketTranslations = [override('title', 'No debe sustituir ingles', true)];
+  const { data, api } = await collect([p], market), result = await build(data, market);
