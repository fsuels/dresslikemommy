{%- liquid
  assign normalized_key = copy_key | default: '' | strip | handleize
  assign fallback_text = fallback | default: '' | strip

  case normalized_key
    when 'shop-by-category'
      assign normalized_key = 'heading-category'
    when 'shop-by-occasion'
      assign normalized_key = 'heading-occasion'
    when 'free-shipping-on-all-orders'
      assign normalized_key = 'trust-free-shipping'
    when 'matching-looks-for-family-moments'
      assign normalized_key = 'trust-matching-moments'
    when 'easy-outfits-for-photos-trips-and-celebrations'
      assign normalized_key = 'trust-easy-outfits'
    when 'helpful-sizing-support'
      assign normalized_key = 'trust-sizing-support'
    when 'family-matching-made-easy'
      assign normalized_key = 'trust-family-matching'
    when 'responds-within-1-business-day'
      assign normalized_key = 'trust-family-support'
    when 'most-loved'
      assign normalized_key = 'badge-most-loved'
    when 'vacation-favorite'
      assign normalized_key = 'badge-vacation-favorite'
    when 'spring-event-pick'
      assign normalized_key = 'badge-spring-event-pick'
    when 'new-pajama-drop'
      assign normalized_key = 'badge-new-pajama-drop'
    when 'shop-this-look'
      assign normalized_key = 'cta-shop-this-look'
    when 'shop-new-pajamas'
      assign normalized_key = 'cta-shop-new-pajamas'
    when 'shop-mother-daughter-wedding-guest-dresses'
      assign normalized_key = 'link-mother-daughter-dresses'
    when 'shop-matching-family-vacation-outfits'
      assign normalized_key = 'link-family-vacation'
    when 'browse-matching-dresses-for-spring-events'
      assign normalized_key = 'link-spring-dresses'
    when 'browse-the-new-pajama-drop'
      assign normalized_key = 'link-new-pajamas'
  endcase

  assign localized_text = fallback_text

  case normalized_key
    when 'heading-category', 'heading-occasion', 'trust-free-shipping', 'trust-matching-moments', 'trust-easy-outfits', 'trust-sizing-support', 'trust-family-matching', 'trust-family-support', 'mommy-me', 'family-matching', 'pajamas', 'matching-dresses', 'swimsuits', 'daddy-me', 'vacation', 'photo-days', 'birthdays', 'beach-days', 'caption-mommy-me', 'caption-family-matching', 'caption-pajamas', 'caption-matching-dresses', 'caption-swimsuits', 'caption-daddy-me', 'caption-vacation', 'caption-photo-days', 'caption-birthdays', 'caption-beach-days', 'badge-most-loved', 'badge-vacation-favorite', 'badge-spring-event-pick', 'badge-new-pajama-drop', 'cta-shop-this-look', 'cta-shop-new-pajamas', 'link-mother-daughter-dresses', 'link-family-vacation', 'link-spring-dresses', 'link-new-pajamas'
      assign locale_copy_key = normalized_key | replace: '-', '_' | prepend: 'sections.home_category_copy.'
      assign localized_text = locale_copy_key | t
  endcase

  echo localized_text
-%}
