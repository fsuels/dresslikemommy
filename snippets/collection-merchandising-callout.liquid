{%- liquid
  assign collection_handle = collection.handle | default: ''
  assign show_callout = false
  assign callout_eyebrow = ''
  assign callout_title = ''
  assign callout_body = ''
  assign primary_label = 'Shop the collection'
  assign primary_url = '#product-grid'
  assign secondary_label = ''
  assign secondary_url = ''
  assign tertiary_label = ''
  assign tertiary_url = ''
  assign callout_media = blank
  assign callout_media_source_product = blank
  assign callout_media_alt = collection.title | default: 'Matching collection'
  assign collection_live_count = collection.all_products_count | default: collection.products_count

  case collection_handle
    when 'matching-couples-t-shirts'
      assign show_callout = true
      assign callout_eyebrow = 'storefront.callout.matching_couples_t_shirts.callout_eyebrow' | t
      assign callout_title = 'storefront.callout.matching_couples_t_shirts.callout_title' | t
      assign callout_body = 'storefront.callout.matching_couples_t_shirts.callout_body' | t
      assign primary_label = 'storefront.callout.matching_couples_t_shirts.primary_label' | t
      assign primary_url = '#product-grid'
      assign secondary_label = 'storefront.callout.matching_couples_t_shirts.secondary_label' | t
      assign secondary_url = '/collections/matching-outfits'
    when 'mommy-and-me'
      assign show_callout = true
      assign callout_eyebrow = 'storefront.callout.mommy_and_me.callout_eyebrow' | t
      assign callout_title = 'storefront.callout.mommy_and_me.callout_title' | t
      assign callout_body = 'storefront.callout.mommy_and_me.callout_body' | t
      assign primary_label = 'storefront.callout.mommy_and_me.primary_label' | t
      assign primary_url = '#product-grid'
      assign secondary_label = 'storefront.callout.mommy_and_me.secondary_label' | t
      assign secondary_url = '/collections/new-pajama-drop'
      assign tertiary_label = 'storefront.callout.mommy_and_me.tertiary_label' | t
      assign tertiary_url = '/collections/pajamas'
    when 'matching-outfits', 'family-matching-outfits', 'new-women-outfits'
      assign show_callout = true
      assign callout_eyebrow = 'storefront.callout.matching_outfits.callout_eyebrow' | t
      assign callout_title = 'storefront.callout.matching_outfits.callout_title' | t
      assign callout_body = 'storefront.callout.matching_outfits.callout_body' | t
      assign primary_label = 'storefront.callout.matching_outfits.primary_label' | t
      assign primary_url = '#product-grid'
      assign secondary_label = 'storefront.callout.matching_outfits.secondary_label' | t
      assign secondary_url = '/collections/new-pajama-drop'
      assign tertiary_label = 'storefront.callout.matching_outfits.tertiary_label' | t
      assign tertiary_url = '/collections/pajamas'
    when 'pajamas'
      assign show_callout = true
      assign callout_eyebrow = 'storefront.callout.pajamas.callout_eyebrow' | t
      assign callout_title = 'storefront.callout.pajamas.callout_title' | t
      assign callout_body = 'storefront.callout.pajamas.callout_body' | t
      assign primary_label = 'storefront.callout.pajamas.primary_label' | t
      assign primary_url = '#product-grid'
      assign secondary_label = 'storefront.callout.pajamas.secondary_label' | t
      assign secondary_url = '/collections/new-pajama-drop'
      assign tertiary_label = 'storefront.callout.pajamas.tertiary_label' | t
      assign tertiary_url = '/collections/mommy-and-me'
    when 'new-pajama-drop'
      assign show_callout = true
      assign callout_eyebrow = 'storefront.callout.new_pajama_drop.callout_eyebrow' | t
      assign callout_title = 'storefront.callout.new_pajama_drop.callout_title' | t
      assign callout_body = 'storefront.callout.new_pajama_drop.callout_body' | t
      assign primary_label = 'storefront.callout.new_pajama_drop.primary_label' | t
      assign primary_url = '#product-grid'
      assign secondary_label = 'storefront.callout.new_pajama_drop.secondary_label' | t
      assign secondary_url = '/collections/pajamas'
    when 'new-matching-outfits'
      assign show_callout = true
      assign callout_eyebrow = 'storefront.callout.new_matching_outfits.callout_eyebrow' | t
      assign callout_title = 'storefront.callout.new_matching_outfits.callout_title' | t
      assign callout_body = 'storefront.callout.new_matching_outfits.callout_body' | t
      assign primary_label = 'storefront.callout.new_matching_outfits.primary_label' | t
      assign primary_url = '#product-grid'
      assign secondary_label = 'storefront.callout.new_matching_outfits.secondary_label' | t
      assign secondary_url = '/collections/mommy-and-me'
  endcase

  if routes.root_url != '/'
    if secondary_url != blank
      assign secondary_url = routes.root_url | append: secondary_url
    endif
    if tertiary_url != blank
      assign tertiary_url = routes.root_url | append: tertiary_url
    endif
  endif

  if collection.image != blank
    assign callout_media = collection.image
  elsif collection.products_count > 0 and collection.products.first.featured_media != blank
    assign callout_media = collection.products.first.featured_media.preview_image
    assign callout_media_source_product = collection.products.first
  endif
  if callout_media != blank
    capture callout_media_alt
      render 'product-image-alt', product: callout_media_source_product, media: callout_media, collection: collection, fallback_title: callout_media_alt
    endcapture
    assign callout_media_alt = callout_media_alt | strip
  endif
-%}

{%- if show_callout -%}
  <div class="collection-merchandising-callout">
    <div class="collection-merchandising-callout__content">
      <div class="collection-merchandising-callout__intro">
        {%- if callout_eyebrow != blank -%}
          <p class="collection-merchandising-callout__eyebrow">{{ callout_eyebrow }}</p>
        {%- endif -%}
        <h2 class="collection-merchandising-callout__title">{{ callout_title }}</h2>
        <p class="collection-merchandising-callout__body">{{ callout_body }}</p>
      </div>
      <div class="collection-merchandising-callout__utility">
        <ul class="collection-merchandising-callout__meta" role="list">
          <li>{{ 'storefront.callout.style_count' | t: count: collection_live_count }}</li>
          <li>{{ 'storefront.callout.shipping' | t }}</li>
          <li>{{ 'storefront.callout.returns' | t }}</li>
        </ul>
        <div class="collection-merchandising-callout__actions">
          <a href="{{ primary_url }}" class="button">{{ primary_label }}</a>
          {%- if secondary_url != blank and secondary_label != blank -%}
            <a href="{{ secondary_url }}" class="button button--secondary">{{ secondary_label }}</a>
          {%- endif -%}
        </div>
        {%- if tertiary_url != blank and tertiary_label != blank -%}
          <a href="{{ tertiary_url }}" class="collection-merchandising-callout__text-link">{{ tertiary_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if callout_media != blank -%}
      <div class="collection-merchandising-callout__media media">
        <img
          srcset="
            {%- if callout_media.width >= 360 -%}{{ callout_media | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if callout_media.width >= 535 -%}{{ callout_media | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if callout_media.width >= 750 -%}{{ callout_media | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if callout_media.width >= 990 -%}{{ callout_media | image_url: width: 990 }} 990w,{%- endif -%}
            {{ callout_media | image_url }} {{ callout_media.width }}w
          "
          src="{{ callout_media | image_url: width: 750 }}"
          sizes="(min-width: 990px) 24rem, 100vw"
          alt="{{ callout_media_alt | escape }}"
          loading="lazy"
          decoding="async"
          width="{{ callout_media.width }}"
          height="{{ callout_media.height }}"
        >
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
