  endcase

  # alias=role lookup. Lowercase tokens only; '|' and '=' never appear in a
  # token. 'baba' is Hungarian "baby" but Turkish "father", so it is added per
  # language below.
  assign dcf_alias = '|mother=mother|mom=mother|mommy=mother|mum=mother|mummy=mother|mama=mother|mamá=mother|mamma=mother|maman=mother|mère=mother|mere=mother|mãe=mother|mae=mother|madre=mother|mutter=mother|moeder=mother|mor=mother|äiti=mother|máma=mother|maminka=mother|mamă=mother|mamička=mother|majka=mother|mati=mother|anne=mother|anya=mother|ibu=mother|mẹ=mother|мама=mother|мать=mother|μαμά=mother|μητέρα=mother|אמא=mother|माँ=mother|मां=mother|الأم=mother|الام=mother|妈妈=mother|媽媽=mother|ママ=mother|엄마=mother|어머니=mother|แม่=mother|'
  assign dcf_alias = dcf_alias | append: 'father=father|dad=father|daddy=father|papa=father|papá=father|papà=father|pai=father|padre=father|père=father|pere=father|vater=father|vader=father|far=father|pappa=father|isä=father|tata=father|táta=father|tatínek=father|otec=father|ocko=father|oče=father|oči=father|otac=father|tėtis=father|apa=father|ayah=father|bố=father|cha=father|папа=father|отец=father|μπαμπάς=father|πατέρας=father|אבא=father|पिता=father|पापा=father|الأب=father|الاب=father|爸爸=father|パパ=father|아빠=father|아버지=father|พ่อ=father|'
  assign dcf_alias = dcf_alias | append: 'girl=girl|girls=girl|daughter=girl|hija=girl|niña=girl|nina=girl|filha=girl|menina=girl|figlia=girl|bambina=girl|ragazza=girl|tochter=girl|mädchen=girl|maedchen=girl|fille=girl|meisje=girl|pige=girl|jente=girl|flicka=girl|tyttö=girl|dziewczynka=girl|dívka=girl|dievča=girl|deklica=girl|djevojčica=girl|mergaitė=girl|fată=girl|lány=girl|kız=girl|kız çocuk=girl|bé gái=girl|anak perempuan=girl|девочка=girl|дочь=girl|κορίτσι=girl|ילדה=girl|אילדה=girl|लड़की=girl|البنت=girl|بنت=girl|ابنة=girl|الابنة=girl|فتاة=girl|الفتاة=girl|للبنات=girl|女孩=girl|女の子=girl|娘=girl|여아=girl|딸=girl|เด็กหญิง=girl|'
  assign dcf_alias = dcf_alias | append: 'boy=boy|boys=boy|son=boy|hijo=boy|niño=boy|nino=boy|filho=boy|menino=boy|figlio=boy|bambino=boy|ragazzo=boy|sohn=boy|junge=boy|fils=boy|garçon=boy|garcon=boy|jongen=boy|dreng=boy|gutt=boy|pojke=boy|poika=boy|chłopiec=boy|chlapec=boy|deček=boy|dječak=boy|berniukas=boy|băiat=boy|baiat=boy|fiú=boy|erkek=boy|erkek çocuk=boy|bé trai=boy|anak laki-laki=boy|мальчик=boy|сын=boy|αγόρι=boy|ילד=boy|लड़का=boy|الولد=boy|ولد=boy|ابن=boy|الابن=boy|فتى=boy|الفتى=boy|男孩=boy|男の子=boy|息子=boy|남아=boy|아들=boy|เด็กชาย=boy|'
  assign dcf_alias = dcf_alias | append: 'child=child|children=child|kid=child|kids=child|toddler=child|infant=child|infantil=child|enfant=child|enfants=child|niños=child|criança=child|bambini=child|kind=child|kinder=child|barn=child|lapsi=child|dziecko=child|dzieci=child|dítě=child|dieťa=child|otrok=child|dijete=child|vaikas=child|copil=child|gyerek=child|çocuk=child|trẻ em=child|anak=child|ребенок=child|ребёнок=child|детский=child|дети=child|παιδί=child|παιδικό=child|ילדים=child|बच्चा=child|طفل=child|الطفل=child|أطفال=child|اطفال=child|للأولاد=child|儿童=child|兒童=child|子供=child|キッズ=child|아동=child|어린이=child|เด็ก=child|'
  assign dcf_alias = dcf_alias | append: 'baby=baby|bebe=baby|bebé=baby|bebê=baby|bébé=baby|neonato=baby|niemowlę=baby|miminko=baby|bábätko=baby|dojenček=baby|beba=baby|kūdikis=baby|bebeluș=baby|bebek=baby|bebis=baby|vauva=baby|bayi=baby|em bé=baby|малыш=baby|младенец=baby|μωρό=baby|תינוק=baby|शिशु=baby|رضيع=baby|الرضيع=baby|بيبي=baby|婴儿=baby|嬰兒=baby|宝宝=baby|寶寶=baby|ベビー=baby|赤ちゃん=baby|아기=baby|베이비=baby|ทารก=baby|'
  assign dcf_alias = dcf_alias | append: 'adult=adult|adults=adult|adulto=adult|adulta=adult|adulte=adult|adultes=adult|erwachsene=adult|erwachsener=adult|volwassene=adult|voksen=adult|vuxen=adult|aikuinen=adult|dorosły=adult|dospělý=adult|dospelý=adult|odrasli=adult|odrasla osoba=adult|suaugęs=adult|felnőtt=adult|yetişkin=adult|dewasa=adult|người lớn=adult|взрослый=adult|ενήλικας=adult|מבוגר=adult|वयस्क=adult|بالغ=adult|بالغة=adult|بالغين=adult|البالغين=adult|الكبار=adult|للكبار=adult|成人=adult|大人=adult|성인=adult|ผู้ใหญ่=adult|'
  if dcf_lang == 'hu'
    assign dcf_alias = dcf_alias | append: 'baba=baby|'
  elsif dcf_lang == 'tr'
    assign dcf_alias = dcf_alias | append: 'baba=father|'
  endif

  assign dcf_role_keys = 'mother,father,girl,boy,child,baby,adult' | split: ','
  assign dcf_items = cart.items | sort: 'final_line_price' | reverse
  assign dcf_seen = ','
  assign dcf_shown = 0
  assign dcf_products_html = ''

  for item in dcf_items
    if dcf_shown >= dcf_limit
      break
    endif
    assign dcf_p = item.product
    assign dcf_pkey = ',' | append: item.product_id | append: ','
    if dcf_seen contains dcf_pkey
      continue
    endif
    assign dcf_seen = dcf_seen | append: item.product_id | append: ','
    if dcf_p == blank or dcf_p.has_only_default_variant
      continue
    endif

    # 1. Role option: first option whose values carry >= 2 different roles.
    # dcf_map entries: ¦<value>¤<role>¤=<size part of the value>¦
    assign dcf_role_pos = 0
    assign dcf_map = '¦'
    assign dcf_product_roles = ','
    for dcf_opt in dcf_p.options_with_values
      assign dcf_opt_map = '¦'
      assign dcf_opt_roles = ','
      assign dcf_opt_distinct = 0
      for dcf_value in dcf_opt.values
        assign dcf_val = dcf_value.name | default: dcf_value | append: ''
        assign dcf_norm = dcf_val | replace: '(', ' ' | replace: ')', ' ' | replace: ':', ' ' | replace: ',', ' ' | replace: '/', ' ' | strip
        assign dcf_lower = dcf_norm | downcase
        assign dcf_words = dcf_lower | split: ' '
        assign dcf_owords = dcf_norm | split: ' '
        assign dcf_r = ''
        assign dcf_rem = ''
        if dcf_words.size > 1
          assign dcf_tok = dcf_words[0] | append: ' ' | append: dcf_words[1]
          assign dcf_needle = '|' | append: dcf_tok | append: '='
          if dcf_alias contains dcf_needle
            assign dcf_r = dcf_alias | split: dcf_needle | last | split: '|' | first
            assign dcf_cut = dcf_owords[0] | append: ' ' | append: dcf_owords[1]
            assign dcf_rem = dcf_norm | remove_first: dcf_cut
          endif
        endif
        if dcf_r == '' and dcf_words.size > 0
          assign dcf_needle = '|' | append: dcf_words[0] | append: '='
          if dcf_alias contains dcf_needle
            assign dcf_r = dcf_alias | split: dcf_needle | last | split: '|' | first
            assign dcf_rem = dcf_norm | remove_first: dcf_owords[0]
          endif
        endif
        if dcf_r == '' and dcf_words.size > 0 and dcf_words[0] contains '-'
          assign dcf_tok = dcf_words[0] | split: '-' | first
          assign dcf_needle = '|' | append: dcf_tok | append: '='
          if dcf_tok != '' and dcf_alias contains dcf_needle
            assign dcf_r = dcf_alias | split: dcf_needle | last | split: '|' | first
            assign dcf_cut = dcf_owords[0] | split: '-' | first | append: '-'
            assign dcf_rem = dcf_norm | remove_first: dcf_cut
          endif
        endif
        if dcf_r == '' and dcf_words.size > 1
          assign dcf_needle = '|' | append: dcf_words.last | append: '='
          if dcf_alias contains dcf_needle
            assign dcf_r = dcf_alias | split: dcf_needle | last | split: '|' | first
            assign dcf_last_len = dcf_owords.last | size
            assign dcf_keep = dcf_norm | size | minus: dcf_last_len
            assign dcf_rem = dcf_norm | slice: 0, dcf_keep
          endif
        endif
        if dcf_r != ''
          assign dcf_rem = dcf_rem | strip
          assign dcf_rem_first = dcf_rem | slice: 0
          if dcf_rem_first == '-' or dcf_rem_first == '–' or dcf_rem_first == '·'
            assign dcf_rem = dcf_rem | slice: 1, 200 | strip
          endif
          assign dcf_opt_map = dcf_opt_map | append: dcf_val | append: '¤' | append: dcf_r | append: '¤=' | append: dcf_rem | append: '¦'
          assign dcf_rkey = ',' | append: dcf_r | append: ','
          unless dcf_opt_roles contains dcf_rkey
            assign dcf_opt_roles = dcf_opt_roles | append: dcf_r | append: ','
            assign dcf_opt_distinct = dcf_opt_distinct | plus: 1
          endunless
        endif
      endfor
      if dcf_opt_distinct >= 2
        assign dcf_role_pos = dcf_opt.position
        assign dcf_map = dcf_opt_map
        assign dcf_product_roles = dcf_opt_roles
        break
      endif
    endfor
    if dcf_role_pos == 0
      continue
    endif
    assign dcf_ri = dcf_role_pos | minus: 1

    # 2. Role of every variant, aligned with dcf_p.variants.
    assign dcf_vroles = ''
    for dcf_v in dcf_p.variants
      assign dcf_needle = '¦' | append: dcf_v.options[dcf_ri] | append: '¤'
      if dcf_map contains dcf_needle
        assign dcf_vr = dcf_map | split: dcf_needle | last | split: '¤' | first
      else
        assign dcf_vr = '-'
      endif
      assign dcf_vroles = dcf_vroles | append: dcf_vr | append: ','
    endfor
    assign dcf_vroles = dcf_vroles | split: ','

    # 3. Roles already in the cart for this product.
    assign dcf_in_cart = ','
    for dcf_line in cart.items
      if dcf_line.product_id == item.product_id
        assign dcf_needle = '¦' | append: dcf_line.variant.options[dcf_ri] | append: '¤'
        if dcf_map contains dcf_needle
          assign dcf_lr = dcf_map | split: dcf_needle | last | split: '¤' | first
          assign dcf_in_cart = dcf_in_cart | append: dcf_lr | append: ','
        endif
      endif
    endfor
    if dcf_in_cart == ','
      continue
    endif

    # 4. Offer each role of this design that is not in the cart. Kid and Adult
    # may be added again ("Another kid"), since families often need two.
    # A non-role option (Color, Type) must equal the cart line's value
    # whenever that role has the value at all; if the role never has it
    # (e.g. Type "Dress" for Dad), that option is not matched and its value
    # is shown in the size label instead.
    assign dcf_ref = item.variant
    assign dcf_chips = ''
    assign dcf_panels = ''
    assign dcf_chip_count = 0
    for dcf_role in dcf_role_keys
      if dcf_chip_count >= 4
        break
      endif
      assign dcf_rkey = ',' | append: dcf_role | append: ','
      unless dcf_product_roles contains dcf_rkey
        continue
      endunless
      assign dcf_have = false
      if dcf_in_cart contains dcf_rkey
        assign dcf_have = true
        if dcf_role != 'child' and dcf_role != 'adult'
          continue
        endif
      endif

      assign dcf_need1 = false
      assign dcf_need2 = false
      assign dcf_need3 = false
      for dcf_v in dcf_p.variants
        if dcf_vroles[forloop.index0] == dcf_role
          if dcf_v.option1 == dcf_ref.option1
            assign dcf_need1 = true
          endif
          if dcf_v.option2 == dcf_ref.option2
            assign dcf_need2 = true
          endif
          if dcf_v.option3 == dcf_ref.option3
            assign dcf_need3 = true
          endif
        endif
      endfor

      # Two option lists are built at once: plain "<size>" (used when every
      # size of this role has the same price) and "<size> — <price>".
      assign dcf_opts_plain = ''
      assign dcf_opts_priced = ''
      assign dcf_count = 0
      assign dcf_min = -1
      assign dcf_max = -1
      for dcf_v in dcf_p.variants
        unless dcf_v.available
          continue
        endunless
        if dcf_vroles[forloop.index0] != dcf_role
          continue
        endif
        assign dcf_extra = ''
        if dcf_role_pos != 1 and dcf_v.option1 != blank
          if dcf_need1
            if dcf_v.option1 != dcf_ref.option1
              continue
            endif
          else
            assign dcf_extra = dcf_extra | append: ' · ' | append: dcf_v.option1
          endif
        endif
        if dcf_role_pos != 2 and dcf_v.option2 != blank
          if dcf_need2
            if dcf_v.option2 != dcf_ref.option2
              continue
            endif
          else
            assign dcf_extra = dcf_extra | append: ' · ' | append: dcf_v.option2
          endif
        endif
        if dcf_role_pos != 3 and dcf_v.option3 != blank
          if dcf_need3
            if dcf_v.option3 != dcf_ref.option3
              continue
            endif
          else
            assign dcf_extra = dcf_extra | append: ' · ' | append: dcf_v.option3
          endif
        endif

        assign dcf_needle = '¦' | append: dcf_v.options[dcf_ri] | append: '¤'
        assign dcf_entry = dcf_map | split: dcf_needle | last | split: '¦' | first
        assign dcf_size = dcf_entry | remove_first: dcf_role | remove_first: '¤=' | strip
        if dcf_size == blank
          assign dcf_label = dcf_extra | remove_first: ' · ' | strip
        else
          assign dcf_label = dcf_size | append: dcf_extra
        endif
        if dcf_label == blank
          assign dcf_label = dcf_v.title
        endif
        assign dcf_count = dcf_count | plus: 1
        if dcf_min < 0 or dcf_v.price < dcf_min
          assign dcf_min = dcf_v.price
        endif
        if dcf_v.price > dcf_max
          assign dcf_max = dcf_v.price
        endif
        assign dcf_money_e = dcf_v.price | money | strip_html | escape
        assign dcf_size_e = dcf_size | escape
        assign dcf_label_e = dcf_label | escape
        assign dcf_open = '<option value="' | append: dcf_v.id | append: '" data-money="' | append: dcf_money_e | append: '" data-size="' | append: dcf_size_e | append: '">'
        assign dcf_opts_plain = dcf_opts_plain | append: dcf_open | append: dcf_label_e | append: '</option>'
        assign dcf_opts_priced = dcf_opts_priced | append: dcf_open | append: dcf_label_e | append: ' — ' | append: dcf_money_e | append: '</option>'
      endfor
      if dcf_count == 0
        continue
      endif
      assign dcf_uniform = false
      if dcf_min == dcf_max
        assign dcf_uniform = true
      endif

      case dcf_role
        when 'mother'
          assign dcf_role_label = t_mother
        when 'father'
          assign dcf_role_label = t_father
        when 'girl'
          assign dcf_role_label = t_girl
        when 'boy'
          assign dcf_role_label = t_boy
        when 'child'
          assign dcf_role_label = t_child
        when 'baby'
          assign dcf_role_label = t_baby
        else
          assign dcf_role_label = t_adult
      endcase
      assign dcf_chip_label = dcf_role_label
      if dcf_have and dcf_role == 'child'
        assign dcf_chip_label = t_another_child
      elsif dcf_have and dcf_role == 'adult'
        assign dcf_chip_label = t_another_adult
      endif

      assign dcf_id = 'DlmCf-' | append: dcf_surface | append: '-' | append: item.product_id | append: '-' | append: dcf_role
      assign dcf_min_money_e = dcf_min | money | strip_html | escape
      assign dcf_role_label_e = dcf_role_label | escape
      assign dcf_chip_label_e = dcf_chip_label | escape
      assign dcf_size_word_e = t_size | escape
      assign dcf_add_e = t_add | escape

      assign dcf_chip = '<button type="button" class="dlm-cf__chip" id="' | append: dcf_id | append: '-chip" aria-expanded="false" aria-controls="' | append: dcf_id | append: '-panel" data-dlm-cf-chip data-role="' | append: dcf_role | append: '" data-role-label="' | append: dcf_role_label_e | append: '"><span aria-hidden="true">+</span> ' | append: dcf_chip_label_e
      if dcf_uniform
        assign dcf_chip = dcf_chip | append: ' <span class="dlm-cf__chip-price">' | append: dcf_min_money_e | append: '</span>'
      endif
      assign dcf_chip = dcf_chip | append: '</button>'

      assign dcf_panel = '<div class="dlm-cf__panel" id="' | append: dcf_id | append: '-panel" role="group" aria-labelledby="' | append: dcf_id | append: '-chip" data-dlm-cf-panel hidden>'
      assign dcf_panel = dcf_panel | append: '<label class="visually-hidden" for="' | append: dcf_id | append: '-select">' | append: dcf_role_label_e | append: ' · ' | append: dcf_size_word_e | append: '</label>'
      assign dcf_panel = dcf_panel | append: '<select class="dlm-cf__select" id="' | append: dcf_id | append: '-select" data-dlm-cf-select><option value="" selected disabled>' | append: dcf_size_word_e | append: '</option>'
      if dcf_uniform
        assign dcf_panel = dcf_panel | append: dcf_opts_plain | append: '</select><span class="dlm-cf__price" data-dlm-cf-price data-default="' | append: dcf_min_money_e | append: '">' | append: dcf_min_money_e | append: '</span>'
      else
        assign dcf_panel = dcf_panel | append: dcf_opts_priced | append: '</select><span class="dlm-cf__price" data-dlm-cf-price data-default=""></span>'
      endif
      assign dcf_panel = dcf_panel | append: '<button type="button" class="dlm-cf__add" data-dlm-cf-add data-product-id="' | append: item.product_id | append: '" data-role="' | append: dcf_role | append: '" disabled>' | append: dcf_add_e | append: '</button></div>'

      assign dcf_chips = dcf_chips | append: dcf_chip
      assign dcf_panels = dcf_panels | append: dcf_panel
      assign dcf_chip_count = dcf_chip_count | plus: 1
    endfor

    if dcf_chip_count == 0
      continue
    endif

    assign dcf_title_e = dcf_p.title | split: ' | ' | first | escape
    assign dcf_url_e = dcf_p.url | escape
    assign dcf_product_html = '<div class="dlm-cf__product" data-product-id="' | append: item.product_id | append: '"><a class="dlm-cf__thumb" href="' | append: dcf_url_e | append: '" tabindex="-1" aria-hidden="true">'
    if dcf_p.featured_image
      assign dcf_img = dcf_p.featured_image | image_url: width: 96
      assign dcf_product_html = dcf_product_html | append: '<img src="' | append: dcf_img | append: '" alt="" width="44" height="44" loading="lazy">'
    endif
    assign dcf_product_html = dcf_product_html | append: '</a><div class="dlm-cf__main"><a class="dlm-cf__title" href="' | append: dcf_url_e | append: '">' | append: dcf_title_e | append: '</a><div class="dlm-cf__chips">' | append: dcf_chips | append: '</div>' | append: dcf_panels | append: '</div></div>'
    assign dcf_products_html = dcf_products_html | append: dcf_product_html
    assign dcf_shown = dcf_shown | plus: 1
  endfor
-%}
{%- if dcf_shown > 0 -%}
  <div
    class="dlm-cf dlm-cf--{{ dcf_surface }}"
    role="group"
    aria-labelledby="DlmCf-Heading-{{ dcf_surface }}"
    data-dlm-complete-family
    data-surface="{{ dcf_surface }}"
    data-msg-added="{{ t_added | escape }}"
    data-msg-error="{{ t_error | escape }}"
  >
    {%- if dcf_surface == 'cart' -%}
      <h2 class="dlm-cf__heading" id="DlmCf-Heading-{{ dcf_surface }}" tabindex="-1">{{ t_heading | escape }}</h2>
    {%- else -%}
      <h3 class="dlm-cf__heading" id="DlmCf-Heading-{{ dcf_surface }}" tabindex="-1">{{ t_heading | escape }}</h3>
    {%- endif -%}
    {{ dcf_products_html }}
    <p class="dlm-cf__error" role="alert" data-dlm-cf-error hidden></p>
    <p class="dlm-cf__note">{{ t_note | escape }}</p>
    <p class="visually-hidden" role="status" aria-live="polite" data-dlm-cf-status></p>
  </div>
{%- endif -%}
