{% comment %}
  Renders a visual card for the Family Matching desktop mega menu.

  Usage:
  {% render 'header-mega-menu-feature-card', menu_link: childlink, card_kind: 'feature' %}
{% endcomment %}

{%- liquid
  assign menu_link_title = menu_link.title | escape
  assign menu_link_display_title = menu_link.title | strip
  assign menu_link_url = menu_link.url
  assign menu_handle = menu_link.handle | default: ''
  assign linked_object = menu_link.object
  assign card_asset = blank
  assign menu_image = blank
  assign fallback_collection = blank
  assign custom_product_handle = blank
  assign custom_image_index = blank
  assign image_crop = 'center'
  assign image_width = 900
  assign image_height = 1200
  assign image_sizes = '(min-width: 990px) 18vw, 50vw'
  assign card_label = 'Trending now'
  assign card_description = blank
  assign card_cta = 'Shop now'

  if card_kind == 'promo'
    assign image_width = 1600
    assign image_height = 700
    assign image_sizes = '(min-width: 990px) 72vw, 100vw'
    assign card_label = 'Best-selling family looks'
    assign card_cta = 'Shop the edit'
  endif

  if menu_link_url contains '/collections/matching-hawaiian-outfits'
    assign card_asset = 'family-mega-menu-hawaiian-tropical.jpg'
    assign card_label = 'Resort favorite'
  elsif menu_link_url contains '/collections/matching-family-vacation-outfits'
    assign card_asset = 'family-mega-menu-vacation-outfits.jpg'
    assign card_label = 'Getaway edit'
  elsif menu_link_url contains '/collections/mother-daughter-matching-dresses'
    assign card_asset = 'family-mega-menu-mother-daughter-dresses.jpg'
    assign card_label = 'Dress best sellers'
  elsif menu_link_url contains '/collections/family-sets'
    assign card_asset = 'family-mega-menu-family-sets.jpg'
    assign card_label = 'Easy sets'
  elsif menu_link_url contains '/collections/family-sweaters'
    assign custom_product_handle = 'family-matching-cable-knit-sweaters-heart-embroidered-unisex-pullovers'
    assign custom_image_index = 2
    assign card_label = 'Cold-weather pick'
    assign image_crop = 'top'
  elsif menu_link_url contains '/collections/family-swimsuits'
    assign custom_product_handle = 'blue-tropical-floral-family-matching-beach-dress-and-shirt-set'
    assign custom_image_index = 1
    assign card_label = 'Pool-day favorite'
  elsif menu_link_url contains '/collections/family-pajamas'
    assign custom_product_handle = 'family-matching-christmas-fair-isle-pajamas-festive-red-green-holiday-pajama-set-for-adults-kids-pets'
    assign custom_image_index = 0
    assign card_label = 'Cozy classic'
  elsif menu_link_url contains '/collections/new-women-outfits'
    assign card_asset = 'family-mega-menu-promo.jpg'
    assign fallback_collection = collections['matching-outfits']
    if fallback_collection == blank
      assign fallback_collection = collections['family-matching-outfits']
    endif
    if fallback_collection != blank
      assign menu_link_url = fallback_collection.url
    endif
    assign menu_link_display_title = 'Family Matching'
    assign card_description = 'Start with family matching outfits, then branch into matching family vacation outfits, matching beach swimsuits, or daddy and me shirts.'
  endif

  if custom_product_handle != blank
    assign custom_product = all_products[custom_product_handle]
    if custom_product != blank
      if custom_image_index != blank and custom_product.media[custom_image_index] != blank
        assign menu_image = custom_product.media[custom_image_index].preview_image | default: custom_product.media[custom_image_index]
      elsif custom_product.featured_media != blank
        assign menu_image = custom_product.featured_media.preview_image | default: custom_product.featured_media
      elsif custom_product.featured_image != blank
        assign menu_image = custom_product.featured_image
      endif
    endif
  endif

  if menu_image == blank and linked_object != blank
    if linked_object.image != blank
      assign menu_image = linked_object.image
    elsif linked_object.featured_image != blank
      assign menu_image = linked_object.featured_image
    elsif linked_object.products != blank and linked_object.products.first != blank
      assign menu_image = linked_object.products.first.featured_media.preview_image | default: linked_object.products.first.featured_image
    endif
  endif

  case menu_handle
    when 'family-swimsuits'
      assign fallback_collection = collections['family-swimsuits']
    when 'family-sets'
      assign fallback_collection = collections['family-sets']
    when 'family-tops'
      assign fallback_collection = collections['family-tops']
    when 'family-sweaters'
      assign fallback_collection = collections['family-sweaters']
    when 'family-pajamas'
      assign fallback_collection = collections['family-pajamas']
    when 'matching-outfits', 'family-matching', 'family-matching-outfits'
      assign fallback_collection = collections['matching-outfits']
      if fallback_collection == blank
        assign fallback_collection = collections['family-matching-outfits']
      endif
      if fallback_collection != blank
        assign menu_link_url = fallback_collection.url
      endif
  endcase

  if menu_image == blank and fallback_collection != blank
    if fallback_collection.image != blank
      assign menu_image = fallback_collection.image
    elsif fallback_collection.featured_image != blank
      assign menu_image = fallback_collection.featured_image
    elsif fallback_collection.products.first != blank
      assign menu_image = fallback_collection.products.first.featured_media.preview_image | default: fallback_collection.products.first.featured_image
    endif
  endif

  assign card_classes = 'mega-menu__visual-card'
  if card_kind == 'promo'
    assign card_classes = card_classes | append: ' mega-menu__visual-card--promo'
  else
    assign card_classes = card_classes | append: ' mega-menu__visual-card--feature'
  endif

  assign menu_image_alt = menu_link_title
  if menu_image != blank and menu_image.alt != blank
    assign menu_image_alt = menu_image.alt | escape
  endif
-%}

<a href="{{ menu_link_url }}" class="{{ card_classes }}">
  <span class="mega-menu__visual-media{% if card_asset == blank and menu_image == blank %} mega-menu__visual-media--placeholder{% endif %}">
    {%- if card_asset != blank -%}
      <img
        src="{{ card_asset | asset_url }}"
        class="mega-menu__visual-image"
        loading="lazy"
        alt="{{ menu_image_alt }}"
        width="{{ image_width }}"
        height="{{ image_height }}"
      >
    {%- elsif menu_image != blank -%}
      {{
        menu_image
        | image_url: width: image_width, height: image_height, crop: image_crop
        | image_tag:
          class: 'mega-menu__visual-image',
          widths: '320, 480, 640, 900, 1200, 1600',
          sizes: image_sizes,
          loading: 'lazy',
          alt: menu_image_alt
      }}
    {%- else -%}
      <span class="mega-menu__visual-placeholder-text">{{ menu_link_title }}</span>
    {%- endif -%}
  </span>
  <span class="mega-menu__visual-overlay"></span>
  <span class="mega-menu__visual-content">
    <span class="mega-menu__visual-label">{{ card_label }}</span>
    <span class="mega-menu__visual-title">{{ menu_link_display_title }}</span>
    {%- if card_description != blank -%}
      <span class="mega-menu__visual-description">{{ card_description }}</span>
    {%- endif -%}
    <span class="mega-menu__visual-cta">{{ card_cta }}</span>
  </span>
</a>
