{% comment %}
  Renders an article card for a given blog with settings to either show the image or not.

  Accepts:
  - blog: {Object} Blog object
  - article: {Object} Article object
  - media_aspect_ratio: {String} The setting changes the aspect ratio of the article image, if shown
  - media_height: {String} The setting changes the height of the article image. Overrides media_aspect_ratio.
  - show_image: {String} The setting either show the article image or not. If it's not included it will show the image by default
  - show_date: {String} The setting either show the article date or not. If it's not included it will not show the image by default
  - show_author: {String} The setting either show the article author or not. If it's not included it will not show the author by default
  - show_badge: {String} The setting either show the blog badge or not.
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)

  Usage:
  {% render 'article-card' blog: blog, article: article, show_image: section.settings.show_image %}
{% endcomment %}

{%- if article and article != empty -%}
  {%- liquid
    assign ratio = media_aspect_ratio | default: 1.25
    assign article_title = article.title | escape
    assign article_excerpt = article.excerpt | strip_html
    assign article_image_alt = article.image.alt | default: article.title
    assign article_fallback_image_url = blank
    assign article_fallback_image_width = blank
    assign article_fallback_image_height = blank
    assign article_fallback_image_alt = blank
    assign render_article_media = false
    assign use_article_fallback = false

    if blog.handle == 'news' or article.url contains '/blogs/news/'
      assign use_article_fallback = true
    endif

    if article_excerpt == blank
      assign article_excerpt = article.content | strip_html
    endif

    if show_image == true
      if use_article_fallback or article.image == blank
        capture article_fallback_image_url
          render 'article-featured-image-fallback', article: article, field: 'url'
        endcapture
        capture article_fallback_image_width
          render 'article-featured-image-fallback', article: article, field: 'width'
        endcapture
        capture article_fallback_image_height
          render 'article-featured-image-fallback', article: article, field: 'height'
        endcapture
        capture article_fallback_image_alt
          render 'article-featured-image-fallback', article: article, field: 'alt'
        endcapture
        assign article_fallback_image_url = article_fallback_image_url | strip
        assign article_fallback_image_width = article_fallback_image_width | strip
        assign article_fallback_image_height = article_fallback_image_height | strip
        assign article_fallback_image_alt = article_fallback_image_alt | strip
        if article_fallback_image_url != blank
          assign render_article_media = true
        endif
      elsif article.image
        assign render_article_media = true
      endif
    endif
  -%}
  <div class="article-card-wrapper card-wrapper underline-links-hover">
    <article
      class="card article-card{% if media_height and media_height != 'adapt' %} article-card__image--{{ media_height }}{% endif %}{% if render_article_media %} card--media{% else %} card--text{% endif %}"
      aria-labelledby="Article-{{ article.id }}"
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%; --article-card-media-ratio: {{ ratio }};"
    >
      {%- if render_article_media -%}
        <div
          class="card__inner article-card__inner ratio"
          style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%; --article-card-media-ratio: {{ ratio }};"
        >
          <a href="{{ article.url }}" class="article-card__image-wrapper card__media">
            {%- if use_article_fallback and article_fallback_image_url != blank -%}
              <div class="article-card__image article-card__image--fallback media media--hover-effect">
                {% comment %}theme-check-disable RemoteAsset{% endcomment %}
                <img
                  src="{{ article_fallback_image_url }}"
                  alt="{{ article_fallback_image_alt | default: article.title | escape }}"
                  class="motion-reduce"
                  {% unless lazy_load == false %}
                    loading="lazy"
                  {% endunless %}
                  width="{{ article_fallback_image_width | default: 1200 }}"
                  height="{{ article_fallback_image_height | default: 1500 }}"
                >
                {% comment %}theme-check-enable RemoteAsset{% endcomment %}
              </div>
            {%- elsif article.image -%}
              <div class="article-card__image media media--hover-effect">
                {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
                <img
                  srcset="
                    {%- if article.image.width >= 165 -%}{{ article.image | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if article.image.width >= 360 -%}{{ article.image | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if article.image.width >= 533 -%}{{ article.image | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if article.image.width >= 720 -%}{{ article.image | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if article.image.width >= 1000 -%}{{ article.image | image_url: width: 1000 }} 1000w,{%- endif -%}
                    {%- if article.image.width >= 1500 -%}{{ article.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                    {{ article.image | image_url }} {{ article.image.width }}w
                  "
                  src="{{ article.image | image_url: width: 720 }}"
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 120px) / 2), calc(100vw - 48px)"
                  alt="{{ article_image_alt | escape }}"
                  class="motion-reduce"
                  {% unless lazy_load == false %}
                    loading="lazy"
                  {% endunless %}
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
                {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
              </div>
            {%- elsif article_fallback_image_url != blank -%}
              <div class="article-card__image article-card__image--fallback media media--hover-effect">
                {% comment %}theme-check-disable RemoteAsset{% endcomment %}
                <img
                  src="{{ article_fallback_image_url }}"
                  alt="{{ article_fallback_image_alt | default: article.title | escape }}"
                  class="motion-reduce"
                  {% unless lazy_load == false %}
                    loading="lazy"
                  {% endunless %}
                  width="{{ article_fallback_image_width | default: 1200 }}"
                  height="{{ article_fallback_image_height | default: 1500 }}"
                >
                {% comment %}theme-check-enable RemoteAsset{% endcomment %}
              </div>
            {%- endif -%}
          </a>
        </div>
      {%- endif -%}

      <div class="card__content article-card__content">
        <div class="card__information">
          {%- if show_date or show_author -%}
            <div class="article-card__meta caption-with-letter-spacing">
              {%- if show_date -%}
                <span class="{% if show_author %}circle-divider{% endif %}">
                  {{ article.published_at | time_tag: format: 'date' }}
                </span>
              {%- endif -%}
              {%- if show_author -%}
                <span>{{ article.author }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <h3 id="Article-{{ article.id }}" class="card__heading article-card__heading{% if show_excerpt %} h2{% endif %}">
            <a href="{{ article.url }}" class="full-unstyled-link">
              {{ article_title }}
            </a>
          </h3>

          {%- if show_excerpt and article_excerpt != blank -%}
            <p class="article-card__excerpt rte-width">
              {{ article_excerpt | truncatewords: 26 }}
            </p>
          {%- endif -%}

          <div class="article-card__footer">
            <span class="article-card__read-time">{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | at_least: 1 }} min read</span>
            <a href="{{ article.url }}" class="article-card__read-more link">Read article &rarr;</a>
          </div>
        </div>

        {%- if show_badge -%}
          <div class="card__badge {{ settings.badge_position }}">
            <span class="badge color-{{ settings.color_schemes | first }}">{{ 'blogs.article.blog' | t }}</span>
          </div>
        {%- endif -%}
      </div>
    </article>
  </div>
{%- endif -%}
