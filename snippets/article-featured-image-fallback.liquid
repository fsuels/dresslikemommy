{%- liquid
  assign article_source = article.title | append: ' ' | append: article.handle | downcase
  assign image_key = 'FAMILY_MATCHING'

  if article_source contains 'swimsuit' or article_source contains 'swimwear' or article_source contains 'bathing suit' or article_source contains 'beach' or article_source contains 'pool'
    assign image_key = 'SWIM'
  elsif article_source contains 'vacation' or article_source contains 'cruise' or article_source contains 'resort' or article_source contains 'travel' or article_source contains 'summer' or article_source contains 'july' or article_source contains 'june' or article_source contains 'august'
    assign image_key = 'VACATION'
  elsif article_source contains 'daddy' or article_source contains 'father' or article_source contains 'dad'
    assign image_key = 'DADDY'
  elsif article_source contains 'valentine' or article_source contains 'heart' or article_source contains 'love' or article_source contains 'couple'
    assign image_key = 'COUPLES'
  elsif article_source contains 'christmas' or article_source contains 'holiday' or article_source contains 'pajama' or article_source contains 'winter' or article_source contains 'cold' or article_source contains 'cozy' or article_source contains 'january' or article_source contains 'december'
    assign image_key = 'PAJAMAS'
  elsif article_source contains 'easter' or article_source contains 'mother' or article_source contains 'mothers day' or article_source contains 'mother s day' or article_source contains 'mom day'
    assign image_key = 'MOMMY'
  elsif article_source contains 'spring' or article_source contains 'floral' or article_source contains 'march' or article_source contains 'april'
    assign image_key = 'MOMMY'
  elsif article_source contains '4th of july' or article_source contains 'fourth' or article_source contains 'patriotic' or article_source contains 'independence'
    assign image_key = 'SWIM'
  elsif article_source contains 'school' or article_source contains 'back to'
    assign image_key = 'MOMMY'
  elsif article_source contains 'dress' or article_source contains 'mommy' or article_source contains 'mother daughter'
    assign image_key = 'MOMMY'
  elsif article_source contains 'photo' or article_source contains 'portrait' or article_source contains 'picture'
    assign image_key = 'FAMILY_PHOTO'
  endif

  assign image_asset = 'home-cat-family-matching.jpg'
  assign image_width = 1200
  assign image_height = 1500
  assign image_alt = article.title | default: 'Dress Like Mommy Style Journal article image'

  case image_key
    when 'MOMMY'
      assign image_asset = 'home-cat-mommy-and-me.jpg'
      assign image_width = 1200
      assign image_height = 1500
    when 'DADDY'
      assign image_asset = 'home-cat-daddy-and-me.jpg'
      assign image_width = 1200
      assign image_height = 1500
    when 'SWIM'
      assign image_asset = 'home-cat-swimsuits.jpg'
      assign image_width = 1200
      assign image_height = 1500
    when 'VACATION'
      assign image_asset = 'family-mega-menu-vacation-outfits.jpg'
      assign image_width = 960
      assign image_height = 1200
    when 'PAJAMAS'
      assign image_asset = 'home-cat-pajamas.jpg'
      assign image_width = 1200
      assign image_height = 1500
    when 'COUPLES'
      assign image_asset = 'home-promo-hawaiian-family.png'
      assign image_width = 972
      assign image_height = 1619
    when 'FAMILY_PHOTO'
      assign image_asset = 'home-cat-photo-days.png'
      assign image_width = 1003
      assign image_height = 1568
    when 'FAMILY_MATCHING'
      assign image_asset = 'home-cat-family-matching.jpg'
      assign image_width = 1200
      assign image_height = 1500
  endcase

  assign image_url = image_asset | asset_url
  assign image_url_origin = request.origin | default: shop.url
  if image_url_origin == blank
    assign image_origin_source = canonical_url | default: request.url | default: shop.url
    if image_origin_source contains '://'
      assign image_origin_protocol = image_origin_source | split: '://' | first
      assign image_origin_without_protocol = image_origin_source | split: '://' | last
      assign image_origin_host = image_origin_without_protocol | split: '/' | first
      if image_origin_protocol != blank and image_origin_host != blank
        assign image_url_origin = image_origin_protocol | append: '://' | append: image_origin_host
      endif
    endif
  endif
  if image_url_origin == blank and shop.permanent_domain != blank
    assign image_url_origin = 'https://' | append: shop.permanent_domain
  endif
  if image_url_origin == blank and request.host != blank
    assign image_url_origin = 'https://' | append: request.host
  endif
  assign image_url_prefix = image_url | slice: 0, 2
  assign image_url_prefix_one = image_url | slice: 0, 1
  if image_url contains '://'
    assign image_url = image_url
  elsif image_url_prefix == '//'
    assign image_url = 'https:' | append: image_url
  elsif image_url contains '/cdn/'
    assign image_url = 'https://www.dresslikemommy.com' | append: image_url
  elsif image_url_prefix_one == '/'
    if image_url_origin == blank
      assign image_url_origin = 'https://www.dresslikemommy.com'
    endif
    assign image_url = image_url_origin | append: image_url
  endif

  case field
    when 'key'
      echo image_key
    when 'width'
      echo image_width
    when 'height'
      echo image_height
    when 'alt'
      echo image_alt
    else
      echo image_url
  endcase
-%}
