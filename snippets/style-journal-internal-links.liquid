            <span class="collection-hero__journal-link-caption">{{ guide_link_2_caption | escape }}</span>
          </a>
        {%- endif -%}
        {%- if guide_link_3_url != blank -%}
          <a
            href="{{ guide_link_3_url }}"
            class="collection-hero__journal-link"
            data-style-journal-link="true"
            data-style-journal-link-type="article"
            data-style-journal-link-placement="collection_guide"
            data-style-journal-source-collection-handle="{{ collection_context_handle | escape }}"
            data-style-journal-destination-handle="{{ guide_link_3_handle | escape }}"
            data-style-journal-destination-title="{{ guide_link_3_title | escape }}"
          >
            <span class="collection-hero__journal-link-title">{{ guide_link_3_title | escape }}</span>
            <span class="collection-hero__journal-link-caption">{{ guide_link_3_caption | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
