            data-style-journal-destination-handle="{{ related_article_3.handle | escape }}"
            data-style-journal-destination-title="{{ related_article_3.title | escape }}"
          >
            {%- render 'article-card',
              blog: journal_blog,
              article: related_article_3,
              media_height: 'medium',
              media_aspect_ratio: 1.2,
              show_image: true,
              show_date: true,
              show_author: false,
              show_excerpt: true
            -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}
{%- elsif mode == 'collection_guide_links' -%}
  {%- if guide_link_1_url != blank or guide_link_2_url != blank or guide_link_3_url != blank -%}
