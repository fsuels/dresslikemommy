            data-style-journal-link-placement="collection_guide"
            data-style-journal-source-collection-handle="{{ collection_context_handle | escape }}"
            data-style-journal-destination-handle="{{ guide_link_1_handle | escape }}"
            data-style-journal-destination-title="{{ guide_link_1_title | escape }}"
