        when 'no', 'nb'
          echo 'Matchende halloweenpysjamaser og koselige gensere til hele familien – til knask eller knep, filmkvelder og julebilder.'
        when 'pl'
          echo 'Pasujące piżamy na Halloween i przytulne swetry dla całej rodziny – na „cukierek albo psikus”, wieczory filmowe i świąteczne zdjęcia.'
        when 'cs'
