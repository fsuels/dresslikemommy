        when 'el'
          echo 'Αγοράστε πιτζάμες Halloween'
        when 'ro'
          echo 'Cumpără pijamale de Halloween'
        when 'fi'
          echo 'Osta halloween-pyjamia'
        else
          echo 'Shop Halloween Pajamas'
      endcase

    when 'halloween_winter:cta_secondary'
      case lang
        when 'es'
          echo 'Comprar suéteres acogedores'
        when 'fr'
          echo 'Acheter des pulls douillets'
        when 'de'
          echo 'Kuschelige Pullover kaufen'
        when 'it'
          echo 'Acquista i maglioni accoglienti'
        when 'nl'
          echo 'Shop knusse truien'
        when 'pt'
          echo 'Comprar suéteres aconchegantes'
        when 'da'
          echo 'Se hyggelige sweatre'
        when 'sv'
          echo 'Handla mysiga tröjor'
        when 'no', 'nb'
          echo 'Kjøp koselige gensere'
        when 'pl'
          echo 'Kup przytulne swetry'
        when 'cs'
          echo 'Nakupujte útulné svetry'
        when 'ja'
