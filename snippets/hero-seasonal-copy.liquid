      endcase

    when 'halloween_winter:cta_tertiary'
      case lang
        when 'es'
          echo 'Comprar ropa a juego para la familia'
        when 'fr'
          echo 'Acheter des tenues assorties pour la famille'
        when 'de'
          echo 'Partnerlooks für die Familie kaufen'
        when 'it'
          echo 'Acquista abbigliamento coordinato per la famiglia'
        when 'nl'
          echo 'Shop bijpassende gezinsoutfits'
        when 'pt'
          echo 'Comprar roupas combinando para a família'
        when 'da'
          echo 'Se matchende familietøj'
        when 'sv'
          echo 'Handla matchande familjekläder'
        when 'no', 'nb'
          echo 'Kjøp matchende familieantrekk'
        when 'pl'
          echo 'Kup dopasowane stroje rodzinne'
        when 'cs'
          echo 'Nakupujte sladěné rodinné oblečení'
        when 'ja'
          echo '家族のおそろい服を見る'
        when 'ko'
          echo '패밀리룩 보기'
        when 'ru'
          echo 'Купить семейную одежду в едином стиле'
        when 'ar'
          echo 'تسوق ملابس عائلية متناسقة'
        when 'he'
          echo 'לקניית בגדים תואמים למשפחה'
        when 'hi'
          echo 'परिवार के लिए मेल खाते कपड़े खरीदें'
        when 'el'
          echo 'Αγοράστε ασορτί οικογενειακά ρούχα'
        when 'ro'
          echo 'Cumpără ținute asortate pentru familie'
        when 'fi'
          echo 'Osta yhteensopivia perheasuja'
        else
          echo 'Shop Family Matching Outfits'
      endcase

    when 'halloween_winter:alt_1'
      case lang
        when 'es'
          echo 'Familias con pijamas de Halloween a juego en ventanas arqueadas bajo una luna creciente'
        when 'fr'
          echo 'Familles en pyjamas d’Halloween assortis dans des fenêtres en arche sous un croissant de lune'
        when 'de'
          echo 'Familien in passenden Halloween-Schlafanzügen in Bogenfenstern unter einer Mondsichel'
        when 'it'
          echo 'Famiglie in pigiami di Halloween coordinati in finestre ad arco sotto una falce di luna'
        when 'nl'
          echo 'Gezinnen in bijpassende Halloween-pyjama’s in boogramen onder een maansikkel'
        when 'pt'
          echo 'Famílias com pijamas de Halloween combinando em janelas em arco sob uma lua crescente'
        when 'da'
          echo 'Familier i matchende halloweenpyjamasser i buede vinduer under en halvmåne'
        when 'sv'
          echo 'Familjer i matchande halloweenpyjamasar i välvda fönster under en månskära'
        when 'no', 'nb'
          echo 'Familier i matchende halloweenpysjamaser i buede vinduer under en månesigd'
        when 'pl'
          echo 'Rodziny w pasujących piżamach na Halloween w łukowych oknach pod sierpem księżyca'
        when 'cs'
          echo 'Rodiny ve sladěných halloweenských pyžamech v obloukových oknech pod srpkem měsíce'
        when 'ja'
          echo '三日月の下、アーチ窓に並ぶおそろいのハロウィンパジャマを着た家族'
        when 'ko'
          echo '초승달 아래 아치형 창 속, 할로윈 파자마를 맞춰 입은 가족들'
        when 'ru'
          echo 'Семьи в одинаковых пижамах на Хэллоуин в арочных окнах под полумесяцем'
        when 'ar'
          echo 'عائلات ببيجامات هالوين متناسقة داخل نوافذ مقوسة تحت هلال'
        when 'he'
          echo 'משפחות בפיג׳מות האלווין תואמות בחלונות קשתיים מתחת לירח חרמש'
        when 'hi'
          echo 'अर्धचंद्र के नीचे मेहराबदार खिड़कियों में मैचिंग हैलोवीन पायजामे पहने परिवार'
        when 'el'
