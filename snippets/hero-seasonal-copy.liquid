      endcase

    when 'halloween_winter:alt_2'
      case lang
        when 'es'
          echo 'Familias con suéteres de punto crema y rojo a juego en ventanas arqueadas en una noche nevada'
        when 'fr'
          echo 'Familles en pulls en maille crème et rouge assortis dans des fenêtres en arche par une nuit enneigée'
        when 'de'
          echo 'Familien in passenden Strickpullovern in Creme und Rot in Bogenfenstern in einer verschneiten Nacht'
        when 'it'
          echo 'Famiglie in maglioni coordinati color crema e rossi in finestre ad arco in una notte di neve'
        when 'nl'
          echo 'Gezinnen in bijpassende crème en rode gebreide truien in boogramen op een besneeuwde avond'
        when 'pt'
          echo 'Famílias com suéteres de tricô creme e vermelhos combinando em janelas em arco numa noite de neve'
        when 'da'
          echo 'Familier i matchende strikbluser i creme og rød i buede vinduer en snefyldt aften'
        when 'sv'
          echo 'Familjer i matchande stickade tröjor i crème och rött i välvda fönster en snöig kväll'
        when 'no', 'nb'
          echo 'Familier i matchende strikkegensere i krem og rødt i buede vinduer en snørik kveld'
        when 'pl'
          echo 'Rodziny w pasujących kremowych i czerwonych swetrach w łukowych oknach w śnieżną noc'
        when 'cs'
          echo 'Rodiny ve sladěných krémových a červených pletených svetrech v obloukových oknech za zasněžené noci'
        when 'ja'
          echo '雪の夜、アーチ窓に並ぶクリーム色と赤のおそろいニットを着た家族'
        when 'ko'
          echo '눈 내리는 밤 아치형 창 속, 크림색과 빨간색 니트를 맞춰 입은 가족들'
        when 'ru'
          echo 'Семьи в одинаковых кремовых и красных вязаных свитерах в арочных окнах снежной ночью'
        when 'ar'
          echo 'عائلات بكنزات محبوكة متناسقة باللونين الكريمي والأحمر داخل نوافذ مقوسة في ليلة مثلجة'
        when 'he'
          echo 'משפחות בסוודרים סרוגים תואמים בצבעי שמנת ואדום בחלונות קשתיים בליל שלג'
        when 'hi'
          echo 'बर्फ़ीली रात में मेहराबदार खिड़कियों में क्रीम और लाल मैचिंग स्वेटर पहने परिवार'
        when 'el'
          echo 'Οικογένειες με ασορτί πλεκτά πουλόβερ σε κρεμ και κόκκινο σε τοξωτά παράθυρα μια χιονισμένη νύχτα'
        when 'ro'
