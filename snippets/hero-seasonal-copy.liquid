{%- comment -%}
  Pre-translated seasonal copy for sections/hero-banner.liquid.

  Translate & Adapt keeps serving the old translation of a section setting after
  its English source changes, so seasonal hero copy that must match the art and
  links in every storefront language lives here instead of in section settings.

  Usage:
  {%- capture text -%}{%- render 'hero-seasonal-copy', edition: 'halloween_winter', key: 'heading', lang: 'es' -%}{%- endcapture -%}

  Keys: eyebrow, heading, subheading, cta_primary, cta_secondary, cta_tertiary,
  alt_1 and alt_2 (slide alt text; empty for English, which uses the slide's image_alt).
  `lang` is the two-letter language code (pt-BR -> pt). Unknown languages fall back to English.
  Output is plain text; escape it where it is rendered.
{%- endcomment -%}
{%- liquid
  assign copy_id = edition | append: ':' | append: key
  case copy_id
    when 'halloween_winter:eyebrow'
      case lang
        when 'es'
          echo 'Especial Halloween e invierno'
        when 'fr'
          echo 'La sélection Halloween & hiver'
        when 'de'
          echo 'Die Halloween- & Winter-Edition'
        when 'it'
          echo 'Speciale Halloween e inverno'
        when 'nl'
          echo 'De Halloween- & wintereditie'
        when 'pt'
          echo 'Edição Halloween e inverno'
        when 'da'
          echo 'Halloween- og vinterudvalget'
        when 'sv'
          echo 'Halloween- och vinterutvalet'
        when 'no', 'nb'
          echo 'Halloween- og vinterutvalget'
        when 'pl'
          echo 'Kolekcja na Halloween i zimę'
        when 'cs'
          echo 'Výběr na Halloween a zimu'
        when 'ja'
          echo 'ハロウィン＆ウィンターコレクション'
        when 'ko'
          echo '할로윈 & 윈터 에디션'
        when 'ru'
          echo 'Подборка к Хэллоуину и зиме'
        when 'ar'
          echo 'تشكيلة الهالوين والشتاء'
        when 'he'
          echo 'קולקציית האלווין וחורף'
        when 'hi'
          echo 'हैलोवीन और विंटर कलेक्शन'
        when 'el'
