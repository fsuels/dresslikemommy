          echo 'Familii în pijamale de Halloween asortate, în ferestre arcuite sub o semilună'
        when 'fi'
          echo 'Perheitä yhteensopivissa halloween-pyjamissa kaarevissa ikkunoissa kuunsirpin alla'
        else
          # English: the slide block's own image_alt is used.
