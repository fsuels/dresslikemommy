        when 'fi'
          echo 'Halloween- ja talvimallisto'
        else
          echo 'The Halloween & Winter Edit'
      endcase

    when 'halloween_winter:heading'
      case lang
        when 'es'
          echo 'Noches de miedo. Mañanas de nieve. Familias a juego.'
        when 'fr'
          echo 'Nuits frissonnantes. Matins enneigés. Familles assorties.'
        when 'de'
          echo 'Gruselige Nächte. Verschneite Morgen. Familien im Partnerlook.'
        when 'it'
          echo 'Notti da brivido. Mattine di neve. Famiglie coordinate.'
        when 'nl'
          echo 'Griezelige nachten. Besneeuwde ochtenden. Bijpassende gezinnen.'
        when 'pt'
          echo 'Noites assustadoras. Manhãs de neve. Famílias combinando.'
        when 'da'
          echo 'Uhyggelige nætter. Snedækkede morgener. Matchende familier.'
        when 'sv'
          echo 'Läskiga nätter. Snöiga morgnar. Matchande familjer.'
        when 'no', 'nb'
          echo 'Skumle netter. Snødekte morgener. Matchende familier.'
        when 'pl'
          echo 'Straszne noce. Śnieżne poranki. Rodzina w pasujących strojach.'
        when 'cs'
          echo 'Strašidelné noci. Zasněžená rána. Sladěné rodiny.'
        when 'ja'
          echo 'ドキドキの夜も、雪の朝も。家族みんなでおそろい。'
        when 'ko'
          echo '으스스한 밤. 눈 내리는 아침. 함께 입는 패밀리룩.'
        when 'ru'
          echo 'Жуткие ночи. Снежные утра. Вся семья в одном стиле.'
        when 'ar'
          echo 'ليالٍ مخيفة. صباحات مثلجة. عائلة بإطلالة متناسقة.'
        when 'he'
          echo 'לילות מפחידים. בקרים מושלגים. משפחה בלוק תואם.'
        when 'hi'
          echo 'डरावनी रातें। बर्फ़ीली सुबहें। पूरा परिवार मैचिंग।'
        when 'el'
          echo 'Τρομακτικές νύχτες. Χιονισμένα πρωινά. Ασορτί οικογένειες.'
        when 'ro'
          echo 'Nopți înfricoșătoare. Dimineți cu zăpadă. Familii asortate.'
        when 'fi'
          echo 'Karmivia öitä. Lumisia aamuja. Koko perhe samassa tyylissä.'
        else
          echo 'Spooky nights. Snowy mornings. Matching families.'
      endcase

    when 'halloween_winter:subheading'
      case lang
        when 'es'
          echo 'Pijamas de Halloween a juego y suéteres acogedores para toda la familia: para pedir dulces, noches de película y fotos navideñas.'
        when 'fr'
          echo 'Pyjamas d’Halloween assortis et pulls douillets pour toute la famille, pour la chasse aux bonbons, les soirées cinéma et les photos des fêtes.'
        when 'de'
          echo 'Passende Halloween-Schlafanzüge und kuschelige Pullover für die ganze Familie – für Süßes oder Saures, Filmabende und Festtagsfotos.'
        when 'it'
          echo 'Pigiami di Halloween coordinati e maglioni accoglienti per tutta la famiglia, per dolcetto o scherzetto, serate film e foto delle feste.'
        when 'nl'
