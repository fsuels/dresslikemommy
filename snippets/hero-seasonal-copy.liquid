        when 'he'
          echo 'פיג׳מות האלווין תואמות וסוודרים נעימים לכל המשפחה – לאיסוף ממתקים, לערבי סרטים ולתמונות החג.'
        when 'hi'
          echo 'पूरे परिवार के लिए मेल खाते हैलोवीन पायजामे और आरामदायक स्वेटर — ट्रिक‑ऑर‑ट्रीट, मूवी नाइट्स और त्योहारों की तस्वीरों के लिए।'
        when 'el'
          echo 'Ασορτί πιτζάμες Halloween και ζεστά πουλόβερ για όλη την οικογένεια, για «φάρσα ή κέρασμα», βραδιές ταινιών και γιορτινές φωτογραφίες.'
        when 'ro'
          echo 'Pijamale de Halloween asortate și pulovere călduroase pentru toată familia – pentru „păcăleală sau dulciuri”, seri de film și fotografii de sărbători.'
        when 'fi'
          echo 'Yhteensopivat halloween-pyjamat ja kodikkaat neuleet koko perheelle – karkkikierroksille, leffailtoihin ja juhlakuviin.'
        else
          echo 'Matching Halloween pajamas and cozy family sweaters for trick‑or‑treat, movie nights, and holiday photos.'
      endcase

    when 'halloween_winter:cta_primary'
      case lang
        when 'es'
          echo 'Comprar pijamas de Halloween'
        when 'fr'
          echo 'Acheter des pyjamas d’Halloween'
        when 'de'
          echo 'Halloween-Schlafanzüge kaufen'
        when 'it'
          echo 'Acquista i pigiami di Halloween'
        when 'nl'
          echo 'Shop Halloween-pyjama’s'
        when 'pt'
          echo 'Comprar pijamas de Halloween'
        when 'da'
          echo 'Se halloweenpyjamasser'
        when 'sv'
          echo 'Handla halloweenpyjamasar'
        when 'no', 'nb'
          echo 'Kjøp halloweenpysjamaser'
        when 'pl'
          echo 'Kup piżamy na Halloween'
        when 'cs'
          echo 'Nakupujte halloweenská pyžama'
        when 'ja'
          echo 'ハロウィンパジャマを見る'
        when 'ko'
          echo '할로윈 파자마 보기'
        when 'ru'
