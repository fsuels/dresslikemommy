{%- comment -%}
  Related style guides for collection pages (2026-09-29). Links each mapped
  collection to 2-3 live articles in the `news` blog (internal links + a path
  from the product grid to buying advice). Article url/title are localized by
  Shopify. Heading translations are inline because locales/*.json are owned by
  another lane; English is the fallback. Renders nothing when the collection is
  unmapped or none of its articles exist.
  Usage: {% render 'collection-related-guides', collection: collection %}
{%- endcomment -%}
{%- liquid
  assign crg_handles = ''
  case collection.handle
    when 'christmas-pajamas'
      assign crg_handles = 'matching-family-christmas-pajamas-guide-2026,matching-family-pajamas-sizing-newborn-to-adult,family-christmas-card-photo-ideas'
    when 'christmas-sweaters', 'family-sweaters'
      assign crg_handles = 'matching-family-christmas-sweaters-guide-2026,one-family-outfit-for-thanksgiving-and-christmas,family-christmas-card-photo-ideas'
    when 'matching-family-sweatshirts'
      assign crg_handles = 'mommy-and-me-winter-sweatshirts-and-loungewear,matching-family-christmas-shirts,matching-family-shirts-for-pictures'
    when 'family-tops'
      assign crg_handles = 'matching-family-shirts-for-pictures,matching-family-christmas-shirts'
    when 'matching-family-christmas-outfits'
      assign crg_handles = 'family-christmas-photo-outfits-2026,babys-first-christmas-matching-family-outfits,matching-family-christmas-shirts'
    when 'mommy-and-me'
      assign crg_handles = 'mommy-and-me-matching-outfit-ideas,mommy-and-me-outfits-for-every-budget,mommy-and-me-winter-sweatshirts-and-loungewear'
    when 'daddy-me', 'daddy-and-me', 'daddy-me-shirts'
      assign crg_handles = 'daddy-and-me-matching-outfits-the-ultimate-guide,father-and-son-matching-button-up-shirts,daddy-daughter-dance-matching-outfits'
    when 'couples'
      assign crg_handles = 'matching-couples-christmas-pajamas-and-sweaters,new-years-eve-matching-family-outfits'
    when 'family-pajamas', 'pajamas'
      assign crg_handles = 'family-matching-pajamas-our-top-picks-for-cozy-nights,matching-family-pajamas-sizing-newborn-to-adult,matching-family-christmas-pajamas-guide-2026'
    when 'swimsuits', 'family-swimsuits'
      assign crg_handles = 'best-matching-swimsuits-for-the-whole-family,mother-daughter-matching-swimsuits-complete-guide-for-summer'
    when 'dresses', 'mother-daughter-matching-dresses'
      assign crg_handles = 'mother-daughter-matching-dresses-guide,mommy-and-me-matching-outfit-ideas,mommy-and-me-summer-dress-guide'
    when 'matching-family-vacation-outfits', 'family-sets', 'matching-hawaiian-outfits'
      assign crg_handles = 'matching-family-hawaiian-outfits,matching-family-cruise-outfits'
    when 'halloween-family-pajamas'
      assign crg_handles = 'halloween-family-matching-costume-ideas,matching-family-outfits-for-pumpkin-patch-photos'
    when 'thanksgiving-family-outfits'
      assign crg_handles = 'thanksgiving-family-matching-outfit-ideas,one-family-outfit-for-thanksgiving-and-christmas,best-matching-outfits-for-thanksgiving-dinner'
    when 'family-photo-outfits'
      assign crg_handles = 'what-to-wear-for-family-photos-matching-outfit-ideas,matching-family-shirts-for-pictures,fall-family-photo-outfits-for-november'
    when 'fall-winter'
      assign crg_handles = 'fall-family-matching-outfits,best-matching-family-outfits-for-winter'
    when 'matching-outfits', 'new-women-outfits'
      assign crg_handles = 'the-complete-guide-to-family-matching-outfits,what-to-wear-for-family-photos-matching-outfit-ideas'
  endcase

  assign crg_articles = ''
  assign crg_count = 0
  if crg_handles != blank
    assign crg_list = crg_handles | split: ','
    for crg_handle in crg_list
      if crg_count < 3
        assign crg_key = 'news/' | append: crg_handle
        assign crg_article = articles[crg_key]
        if crg_article != blank
          assign crg_count = crg_count | plus: 1
          assign crg_articles = crg_articles | append: crg_handle | append: ','
        endif
      endif
    endfor
  endif

  assign crg_prod_handles = ''
  case collection.handle
    when 'mommy-and-me', 'dresses', 'mother-daughter-matching-dresses', 'matching-outfits', 'new-women-outfits'
      assign crg_prod_handles = 'elegant-matching-family-outfits-light-blue-halter-dresses-casual-t-shirt-set-for-summer,tiered-smocked-mommy-and-me-dresses'
  endcase
  assign crg_prod_found = ''
  assign crg_prod_count = 0
  if crg_prod_handles != blank
    assign crg_ph_list = crg_prod_handles | split: ','
    for crg_ph in crg_ph_list
      assign crg_prod = all_products[crg_ph]
      if crg_prod != blank
        assign crg_prod_count = crg_prod_count | plus: 1
        assign crg_prod_found = crg_prod_found | append: crg_ph | append: ','
      endif
    endfor
  endif
-%}
{%- if crg_count > 0 or crg_prod_count > 0 -%}
  {%- liquid
    assign crg_lang = request.locale.iso_code | default: localization.language.iso_code | default: 'en' | downcase | split: '-' | first
    if crg_lang == 'nb'
      assign crg_lang = 'no'
    endif
  -%}
  {{ 'section-collection-seo.css' | asset_url | stylesheet_tag }}
  <section class="collection-related-guides collection-seo-rich page-width page-width--narrow" style="padding-bottom: 3.2rem;">
    <h2 class="collection-seo-rich__eyebrow">
      {%- case crg_lang -%}
        {%- when 'es' -%}Guías de estilo
        {%- when 'fr' -%}Guides de style
        {%- when 'de' -%}Stilratgeber
        {%- when 'it' -%}Guide di stile
        {%- when 'nl' -%}Stijlgidsen
        {%- when 'pt' -%}Guias de estilo
        {%- when 'da' -%}Stilguides
        {%- when 'sv' -%}Stilguider
        {%- when 'no' -%}Stilguider
        {%- when 'pl' -%}Poradniki stylizacji
        {%- when 'cs' -%}Stylové průvodce
        {%- when 'ja' -%}スタイルガイド
        {%- when 'ko' -%}스타일 가이드
        {%- when 'ru' -%}Гиды по стилю
        {%- when 'ar' -%}أدلة الأناقة
        {%- when 'he' -%}מדריכי סטייל
        {%- when 'hi' -%}स्टाइल गाइड
        {%- when 'el' -%}Οδηγοί στυλ
        {%- when 'ro' -%}Ghiduri de stil
        {%- when 'fi' -%}Tyylioppaat
        {%- else -%}Style guides
      {%- endcase -%}
    </h2>
    <div class="collection-seo-rich__links" style="margin-top: 1.2rem;">
      {%- assign crg_found = crg_articles | split: ',' -%}
      {%- for crg_handle in crg_found -%}
        {%- if crg_handle != blank -%}
          {%- assign crg_key = 'news/' | append: crg_handle -%}
          {%- assign crg_article = articles[crg_key] -%}
          <a class="collection-seo-rich__link" href="{{ crg_article.url }}">{{ crg_article.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if crg_prod_count > 0 -%}
      <div class="collection-seo-rich__links" style="margin-top: 1.2rem;">
        {%- assign crg_ph_found = crg_prod_found | split: ',' -%}
        {%- for crg_ph in crg_ph_found -%}
          {%- if crg_ph != blank -%}
            {%- assign crg_prod = all_products[crg_ph] -%}
            <a class="collection-seo-rich__link" href="{{ crg_prod.url | within: collection }}">{{ crg_prod.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}
