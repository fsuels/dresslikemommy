{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- capture christmas_handle -%}{%- render 'christmas-season-collection', menu: section.settings.menu -%}{%- endcapture -%}
    {%- assign christmas_handle = christmas_handle | strip -%}
    {%- if christmas_handle != blank -%}
      {%- assign christmas_is_current = false -%}
      {%- if collection.handle == christmas_handle -%}
        {%- assign christmas_is_current = true -%}
      {%- endif -%}
      <li>
        <a
          id="HeaderMenu-seasonal-christmas"
          href="{% render 'storefront-localized-url', url: collections[christmas_handle].url %}"
          class="header__menu-item list-menu__item link link--text focus-inset"
          {% if christmas_is_current %}
            aria-current="page"
          {% endif %}
        >
          <span
            {%- if christmas_is_current %}
              class="header__active-menu-item"
            {% endif %}
          >
            {{- 'sections.home_category_copy.christmas' | t -}}
          </span>
        </a>
      </li>
    {%- endif -%}
    {%- for link in section.settings.menu.links -%}
      {%- if section.settings.hide_blog_link_in_primary_nav and link.url contains '/blogs/' -%}
        {% continue %}
      {%- endif -%}
      {%- capture link_is_visible -%}
        {%- render 'nav-link-visible', link: link -%}
      {%- endcapture -%}
      {%- assign link_is_visible = link_is_visible | strip -%}
      {%- if link_is_visible != 'true' -%}
        {% continue %}
      {%- endif -%}
      {%- capture visible_child_count_raw -%}
        {%- render 'nav-link-visible-child-count', link: link -%}
      {%- endcapture -%}
      {%- liquid
        assign nav_link_title = link.title | escape
        assign nav_link_url = link.url
        assign normalized_link_title = link.title | strip | downcase
        assign use_family_visual_mega_menu = false
        assign family_hub_destination_visible = false
        assign skip_nav_link = false
        assign visible_child_count = visible_child_count_raw | plus: 0
        if link.url contains '/blogs/'
          assign nav_link_title = 'storefront.journal.title' | t
        endif
        if link.handle == 'family-matching' or link.handle == 'matching-outfits' or link.handle == 'family-matching-outfits' or normalized_link_title == 'family matching' or normalized_link_title == 'family matching outfits'
          assign use_family_visual_mega_menu = true
          assign nav_link_title = 'sections.home_category_copy.family_matching' | t
          assign family_hub_collection = collections['new-women-outfits']
          if family_hub_collection == blank
            assign family_hub_collection = collections['matching-outfits']
          endif
          if family_hub_collection == blank
            assign family_hub_collection = collections['family-matching-outfits']
          endif
          if family_hub_collection != blank
            assign nav_link_url = family_hub_collection.url
            capture family_hub_destination_visible_raw
              render 'collection-storefront-visible', collection_resource: family_hub_collection
            endcapture
            assign family_hub_destination_visible_raw = family_hub_destination_visible_raw | strip
            if family_hub_destination_visible_raw == 'true'
              assign family_hub_destination_visible = true
            endif
          else
            assign nav_link_url = '/collections/new-women-outfits'
          endif
        endif
        if use_family_visual_mega_menu and family_hub_destination_visible == false and visible_child_count == 0
          assign skip_nav_link = true
        endif
      -%}
      {%- if skip_nav_link -%}
        {% continue %}
      {%- endif -%}
      {%- liquid
        assign dlm_mega_key = blank
        assign dlm_link_current = link.current
        assign normalized_link_url = link.url | split: '?' | first
        if use_family_visual_mega_menu and family_hub_destination_visible
          assign dlm_mega_key = 'family'
        elsif link.handle == 'shop' or normalized_link_title == 'shop' or normalized_link_url == '/' or normalized_link_url == '/collections/all' or normalized_link_url == routes.root_url or normalized_link_url == routes.all_products_collection_url
          assign dlm_mega_key = 'shop'
          assign nav_link_url = routes.all_products_collection_url | append: '?sort_by=created-descending'
          assign dlm_link_current = false
          if collection.handle == 'all'
            assign dlm_link_current = true
          endif
        elsif normalized_link_url contains '/collections/mommy-and-me'
          assign dlm_mega_key = 'mommy'
        elsif normalized_link_url contains '/collections/daddy-me' or normalized_link_url contains '/collections/daddy-and-me'
          assign dlm_mega_key = 'daddy'
        endif
      -%}
      <li{% if dlm_mega_key != blank %} class="dlm-nav__item" data-dlm-mega{% endif %}>
        {%- if dlm_mega_key != blank -%}
          {%- capture dlm_hub_url -%}{% render 'storefront-localized-url', url: nav_link_url %}{%- endcapture -%}
          {%- assign dlm_hub_url = dlm_hub_url | strip -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ dlm_hub_url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if dlm_link_current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if dlm_link_current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- nav_link_title -}}
            </span>
          </a>
          <button
            type="button"
            class="dlm-nav__toggle"
            aria-expanded="false"
            aria-controls="DlmMega-{{ dlm_mega_key }}"
            aria-label="{{ 'storefront.mega_menu.toggle' | t: name: nav_link_title }}"
          >
            <svg aria-hidden="true" focusable="false" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div id="DlmMega-{{ dlm_mega_key }}" class="dlm-mega" data-dlm-mega-panel>
            {%- render 'dlm-mega-panel', key: dlm_mega_key, mode: 'desktop', label: nav_link_title, hub_url: dlm_hub_url -%}
          </div>
        {%- elsif visible_child_count > 0 -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- nav_link_title -}}
                </span>
                {% render 'icon-caret' %}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                  <ul
                    class="mega-menu__list page-width{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}"
                    role="list"
                  >
                    {%- for childlink in link.links -%}
                      {%- capture childlink_is_visible -%}
                        {%- render 'nav-link-visible', link: childlink -%}
                      {%- endcapture -%}
                      {%- assign childlink_is_visible = childlink_is_visible | strip -%}
                      {%- if childlink_is_visible != 'true' -%}
                        {% continue %}
                      {%- endif -%}
                      {%- capture childlink_visible_grandchild_count_raw -%}
                        {%- render 'nav-link-visible-child-count', link: childlink -%}
                      {%- endcapture -%}
                      {%- capture childlink_destination_is_visible -%}
                        {%- render 'nav-link-destination-visible', link: childlink -%}
                      {%- endcapture -%}
                      {%- assign childlink_destination_is_visible = childlink_destination_is_visible | strip -%}
                      {%- assign childlink_visible_grandchild_count = childlink_visible_grandchild_count_raw | plus: 0 -%}
                      <li>
                        {%- if childlink_destination_is_visible == 'true' -%}
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                            href="{% render 'storefront-localized-url', url: childlink.url %}"
                            class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                            {% if childlink.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ childlink.title | escape }}
                          </a>
                        {%- else -%}
                          <span class="mega-menu__link mega-menu__link--level-2">
                            {{ childlink.title | escape }}
                          </span>
                        {%- endif -%}
                        {%- if childlink_visible_grandchild_count > 0 -%}
                          <ul class="list-unstyled" role="list">
                            {%- for grandchildlink in childlink.links -%}
                              {%- capture grandchildlink_is_visible -%}
                                {%- render 'nav-link-visible', link: grandchildlink -%}
                              {%- endcapture -%}
                              {%- assign grandchildlink_is_visible = grandchildlink_is_visible | strip -%}
                              {%- if grandchildlink_is_visible != 'true' -%}
                                {% continue %}
                              {%- endif -%}
                              <li>
                                <a
                                  id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                  href="{% render 'storefront-localized-url', url: grandchildlink.url %}"
                                  class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                  {% if grandchildlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{% render 'storefront-localized-url', url: nav_link_url %}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- nav_link_title -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  <div class="dlm-mega-scrim" aria-hidden="true"></div>
</nav>
