{%- liquid
  assign normalized_label = icon_label | default: '' | strip | handleize
  assign caption_key = blank

  case normalized_label
    when 'mommy-me'
      assign caption_key = 'caption-mommy-me'
    when 'family-matching'
      assign caption_key = 'caption-family-matching'
    when 'pajamas'
      assign caption_key = 'caption-pajamas'
    when 'matching-dresses'
      assign caption_key = 'caption-matching-dresses'
    when 'swimsuits'
      assign caption_key = 'caption-swimsuits'
    when 'daddy-me'
      assign caption_key = 'caption-daddy-me'
    when 'vacation'
      assign caption_key = 'caption-vacation'
    when 'photo-days'
      assign caption_key = 'caption-photo-days'
    when 'birthdays'
      assign caption_key = 'caption-birthdays'
    when 'beach-days'
      assign caption_key = 'caption-beach-days'
  endcase
-%}
{%- if caption_key != blank -%}
  {%- render 'home-category-localized-copy', copy_key: caption_key, fallback: '' -%}
{%- endif -%}
