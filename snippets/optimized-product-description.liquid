{% comment %}
  Sanitizes product description HTML for faster render on PDPs.

  Accepts:
  - description_html: Raw product description HTML
{% endcomment %}

{%- liquid
  assign optimized_description = description_html | default: ''

  if optimized_description != blank
    capture optimized_description
      render 'description-glued-letter-fix', html: optimized_description, locale: request.locale.iso_code
    endcapture
    assign optimized_description = optimized_description | remove: '<script src="//s3.amazonaws.com/cashe-js/17e542e29d504c7411.js"></script>'
    assign optimized_description = optimized_description | remove: "<script src='//s3.amazonaws.com/cashe-js/17e542e29d504c7411.js'></script>"
    assign optimized_description = optimized_description | remove: '<script src="https://s3.amazonaws.com/cashe-js/17e542e29d504c7411.js"></script>'
    assign optimized_description = optimized_description | remove: "<script src='https://s3.amazonaws.com/cashe-js/17e542e29d504c7411.js'></script>"
    assign optimized_description = optimized_description | remove: '<script src="http://s3.amazonaws.com/cashe-js/17e542e29d504c7411.js"></script>'
    assign optimized_description = optimized_description | remove: "<script src='http://s3.amazonaws.com/cashe-js/17e542e29d504c7411.js'></script>"
    assign optimized_description = optimized_description | remove: '<meta content="text/html;charset=UTF-8" http-equiv="Content-Type">'
    assign optimized_description = optimized_description | remove: '<a data-discover="true" href="https://admin.shopify.com/store/dresslikemommy-com/products" data-tracking="monorail:admin_page_breadcrumbs_click/1.0" aria-label="Products" class="Polaris-Breadcrumbs__IconWrapper Polaris-Breadcrumbs__IconWrapperLink" data-polaris-unstyled="true"><span class="Polaris-Breadcrumbs__IconBlock"></span></a>'
    assign optimized_description = optimized_description | replace: '<strong>Print reference:</strong>', '<strong>Pattern:</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Referencia de impresión:</strong>', '<strong>Patrón:</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Referencia de estampa:</strong>', '<strong>Estampa:</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Referência de estampa:</strong>', '<strong>Estampa:</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Riferimento stampa:</strong>', '<strong>Motivo:</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Referință imprimeu:</strong>', '<strong>Model:</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Referință de imprimare:</strong>', '<strong>Model:</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Référence imprimé :</strong>', '<strong>Motif :</strong>'
    assign optimized_description = optimized_description | replace: '<strong>Druckreferenz:</strong>', '<strong>Muster:</strong>'
    assign optimized_description = optimized_description | replace: 'based on the attached vendor size-chart image', 'based on the size chart'
    assign optimized_description = optimized_description | replace: 'based on the attached vendor size chart image', 'based on the size chart'
    assign optimized_description = optimized_description | replace: 'attached vendor size-chart image', 'size chart'
    assign optimized_description = optimized_description | replace: 'attached vendor size chart image', 'size chart'
    assign optimized_description = optimized_description | replace: 'Lightweight woven-look fabric; exact fiber composition was not visible in the supplied chart or image.', 'Lightweight woven-look fabric with an easy warm-weather drape.'
    assign optimized_description = optimized_description | replace: 'Tela liviana con apariencia de tejido; La composición exacta de la fibra no era visible en el cuadro o imagen suministrados.', 'Tela ligera con caída fácil para clima cálido.'
    assign optimized_description = optimized_description | replace: 'Tecido leve com aparência tecida; a composição exata da fibra não estava visível no gráfico ou imagem fornecidos.', 'Tecido leve com caimento fácil para dias quentes.'
    assign optimized_description = optimized_description | replace: 'Tessuto leggero dall’aspetto intrecciato; la composizione esatta della fibra non era visibile nella tabella o nell’immagine fornite.', 'Tessuto leggero con una caduta facile per il clima caldo.'
    assign optimized_description = optimized_description | replace: 'Țesătură ușoară cu aspect țesut; compoziția exactă a fibrei nu era vizibilă în tabelul sau imaginea furnizată.', 'Țesătură ușoară, cu cădere lejeră pentru vreme caldă.'
    assign optimized_description = optimized_description | replace: 'white  daisy embroidery', 'white daisy embroidery'
    assign optimized_description = optimized_description | replace: '<p>The attached chart publishes YC8970 as the top and YC8971 as the pants, so this draft keeps the shopper picker honest with a Type choice. The size guide is keyed to the same child and mother size labels shoppers select, with dashes where a piece is not charted in that size.</p>', '<p>Choose the top or pants in the picker, then tap a size to see the matching measurements before you add pieces to cart.</p>'
    assign optimized_description = optimized_description | replace: 'The attached chart publishes YC8970 as the top and YC8971 as the pants, so this draft keeps the shopper picker honest with a Type choice. The size guide is keyed to the same child and mother size labels shoppers select, with dashes where a piece is not charted in that size.', 'Choose the top or pants in the picker, then tap a size to see the matching measurements before you add pieces to cart.'
    assign optimized_description = optimized_description | replace: '<li> <strong>Mother-daughter sizing:</strong> Chart-backed child and mother rows only; no dad or boy rows were invented.</li>', '<li><strong>Mother-daughter sizing:</strong> Child and mother sizes are shown separately so each person can get her own fit.</li>'
    assign optimized_description = optimized_description | replace: '<li><strong>Mother-daughter sizing:</strong> Chart-backed child and mother rows only; no dad or boy rows were invented.</li>', '<li><strong>Mother-daughter sizing:</strong> Child and mother sizes are shown separately so each person can get her own fit.</li>'
    assign optimized_description = optimized_description | replace: 'Chart-backed child and mother rows only; no dad or boy rows were invented.', 'Child and mother sizes are shown separately so each person can get her own fit.'
    assign optimized_description = optimized_description | remove: '<li> <strong>Chart-backed variants:</strong> Every Shopify variant maps back to a visible YC8970 or YC8971 size row.</li>'
    assign optimized_description = optimized_description | remove: '<li><strong>Chart-backed variants:</strong> Every Shopify variant maps back to a visible YC8970 or YC8971 size row.</li>'
    assign optimized_description = optimized_description | replace: '<strong>Chart-backed variants:</strong>', '<strong>Fit details:</strong>'
    assign optimized_description = optimized_description | replace: 'Every Shopify variant maps back to a visible YC8970 or YC8971 size row.', 'Each option uses the visible size guide so you can compare before adding to cart.'
    unless request.locale.iso_code == 'en'
      capture optimized_description
        render 'description-duplicate-size-chart-fix', html: optimized_description, locale: request.locale.iso_code
      endcapture
      comment
        Translated size charts often keep the English age unit in the size cell. Show the number only
        (the Age column already says what it is) and repair leftover English words under the chart.
      endcomment
      assign optimized_description = optimized_description | replace: ' Years</td>', '</td>'
      assign optimized_description = optimized_description | replace: '<p>Height ist die ', '<p>Die Körpergröße ist die '
      assign optimized_description = optimized_description | replace: '<p>Height es la ', '<p>La altura es la '
      assign optimized_description = optimized_description | replace: '<p>Height は', '<p>身長は'
      assign optimized_description = optimized_description | replace: '<p>Height — ', '<p>Рост — '
      assign optimized_description = optimized_description | replace: '<th>Halto (cm)</th>', '<th>Altura (cm)</th>'
    endunless
    assign optimized_description = optimized_description | replace: '<img ', '<img loading="lazy" decoding="async" fetchpriority="low" '
  endif

  # Older descriptions hotlink third-party image URLs. Serve the store's own
  # copy instead: Shopify Files "dlm-pd-<image id>.jpg". New listings must use
  # Shopify-hosted images; upload the copy first if one of these URLs reappears.
  if optimized_description contains 'cbu01.alicdn.com/img/ibank/'
    assign normalized_description = optimized_description | replace: 'http://cbu01.alicdn.com', 'https://cbu01.alicdn.com'
    assign description_parts = normalized_description | split: 'https://cbu01.alicdn.com/img/ibank/'
    assign optimized_description = ''
    for description_part in description_parts
      if forloop.first
        assign optimized_description = description_part
        continue
      endif
      assign source_name = description_part | split: '.jpg' | first
      assign source_tail = source_name | append: '.jpg'
      assign image_id = source_name | split: '_!!' | first
      assign hosted_url = 'dlm-pd-' | append: image_id | append: '.jpg' | file_url
      assign rest = description_part | remove_first: source_tail
      assign optimized_description = optimized_description | append: hosted_url | append: rest
    endfor
  endif
-%}

{{ optimized_description }}
