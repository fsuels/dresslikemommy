{%- liquid
  assign collection_handle = collection.handle | default: ''
  assign recovery_redirect_url = recovery_redirect_url | default: blank

  assign mommy_hub_url = collections['mommy-and-me'].url | default: '/collections/mommy-and-me'
  assign family_hub_collection = collections['matching-outfits']
  if family_hub_collection == blank
    assign family_hub_collection = collections['new-women-outfits']
  endif
  if family_hub_collection == blank
    assign family_hub_collection = collections['family-matching-outfits']
  endif
  assign family_hub_url = family_hub_collection.url | default: '/collections/matching-outfits'
  assign pajamas_url = collections['pajamas'].url | default: '/collections/pajamas'
  assign swimsuits_url = collections['swimsuits'].url | default: '/collections/swimsuits'
  assign all_collections_url = routes.collections_url | default: '/collections'

  assign recovery_eyebrow = 'Keep shopping'
  assign recovery_title = 'This collection is empty right now'
  assign recovery_copy = 'Try one of these collections instead.'
  assign primary_button_label = 'Browse the best match'
  assign primary_button_url = recovery_redirect_url | default: family_hub_url
  assign secondary_button_label = 'Browse Mommy & Me'
  assign secondary_button_url = mommy_hub_url
  assign tertiary_button_label = 'Browse all collections'
  assign tertiary_button_url = all_collections_url

  case collection_handle
    when 'family-swimsuits'
      assign recovery_title = 'Shop matching swimsuits'
      assign recovery_copy = 'Our matching swimsuits are in the Swimsuits collection.'
      assign primary_button_label = 'Shop Swimsuits'
      assign primary_button_url = recovery_redirect_url | default: swimsuits_url
      assign secondary_button_label = 'Browse Family Matching'
      assign secondary_button_url = family_hub_url
      assign tertiary_button_label = 'Browse Mommy & Me'
      assign tertiary_button_url = mommy_hub_url
    when 'family-pajamas'
      assign recovery_title = 'Shop matching pajamas'
      assign recovery_copy = 'Our matching pajamas are in the Pajamas collection.'
      assign primary_button_label = 'Shop Pajamas'
      assign primary_button_url = recovery_redirect_url | default: pajamas_url
      assign secondary_button_label = 'Browse Family Matching'
      assign secondary_button_url = family_hub_url
      assign tertiary_button_label = 'Browse Mommy & Me'
      assign tertiary_button_url = mommy_hub_url
    when 'matching-outfits', 'family-matching-outfits', 'new-women-outfits'
      assign recovery_title = 'More matching looks to explore'
      assign recovery_copy = 'Start with one of these collections.'
      assign primary_button_label = 'Shop Mommy & Me'
      assign primary_button_url = mommy_hub_url
      assign secondary_button_label = 'Shop Pajamas'
      assign secondary_button_url = pajamas_url
      assign tertiary_button_label = 'Browse all collections'
      assign tertiary_button_url = all_collections_url
    when 'mommy-and-me'
      assign recovery_title = 'More Mommy & Me looks to explore'
      assign recovery_copy = 'Start with one of these collections.'
      assign primary_button_label = 'Shop Pajamas'
      assign primary_button_url = pajamas_url
      assign secondary_button_label = 'Browse Family Matching'
      assign secondary_button_url = family_hub_url
      assign tertiary_button_label = 'Browse all collections'
      assign tertiary_button_url = all_collections_url
    else
      if collection_handle contains 'family-'
        assign recovery_title = 'Keep browsing Family Matching'
        assign recovery_copy = 'More matching family outfits are in the Family Matching collection.'
        assign primary_button_label = 'Browse Family Matching'
        assign primary_button_url = recovery_redirect_url | default: family_hub_url
        assign secondary_button_label = 'Shop Pajamas'
        assign secondary_button_url = pajamas_url
        assign tertiary_button_label = 'Browse Mommy & Me'
        assign tertiary_button_url = mommy_hub_url
      elsif collection_handle contains 'mommy' or collection_handle == 'dresses' or collection_handle == 'swimsuits' or collection_handle == 'tops' or collection_handle == 'sweaters' or collection_handle == 'bottoms' or collection_handle == 'leggings' or collection_handle == 'pants' or collection_handle == 'formal-dresses' or collection_handle == 'maxi-dresses' or collection_handle == 'midi-dresses' or collection_handle == 'mini-dresses' or collection_handle == 'sundresses' or collection_handle == 'jumpsuits' or collection_handle == 'rompers' or collection_handle == 'skirts' or collection_handle == 'pajamas'
        assign recovery_title = 'Keep browsing Mommy & Me'
        assign recovery_copy = 'More matching mom and kid outfits are in the Mommy & Me collection.'
        assign primary_button_label = 'Browse Mommy & Me'
        assign primary_button_url = recovery_redirect_url | default: mommy_hub_url
        assign secondary_button_label = 'Shop Pajamas'
        assign secondary_button_url = pajamas_url
        assign tertiary_button_label = 'Browse Family Matching'
        assign tertiary_button_url = family_hub_url
      endif
  endcase
-%}

{%- if recovery_redirect_url != blank and recovery_redirect_url != collection.url -%}
  <script>
    window.location.replace({{ recovery_redirect_url | json }});
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0; url={{ recovery_redirect_url | escape }}">
  </noscript>
{%- endif -%}

<div class="collection-empty-recovery">
  <p class="collection-empty-recovery__eyebrow">{{ recovery_eyebrow }}</p>
  <h3 class="collection-empty-recovery__title">{{ recovery_title }}</h3>
  <p class="collection-empty-recovery__copy">{{ recovery_copy }}</p>
  <div class="collection-empty-recovery__actions">
    {%- if primary_button_url != blank -%}
      <a href="{{ primary_button_url }}" class="button">{{ primary_button_label }}</a>
    {%- endif -%}
    {%- if secondary_button_url != blank -%}
      <a href="{{ secondary_button_url }}" class="button button--secondary">{{ secondary_button_label }}</a>
    {%- endif -%}
    {%- if tertiary_button_url != blank -%}
      <a href="{{ tertiary_button_url }}" class="button button--secondary">{{ tertiary_button_label }}</a>
    {%- endif -%}
  </div>
</div>
