{% comment %}
  Renders collection-driven internal links beneath the PDP description.

  Accepts:
  - product: Product object
{% endcomment %}

{%- liquid
  assign internal_link_locale = request.locale.iso_code | default: 'en' | downcase | split: '-' | first
  assign in_matching_hawaiian_outfits = false
  assign in_matching_family_vacation_outfits = false
  assign in_mother_daughter_matching_dresses = false
  assign in_pajamas = false
  assign in_mommy_and_me = false
  assign pajama_label = 'Shop all Pajamas'
  assign family_matching_collection = collections['matching-outfits']
  if family_matching_collection == blank
    assign family_matching_collection = collections['new-women-outfits']
  endif
  if family_matching_collection == blank
    assign family_matching_collection = collections['family-matching-outfits']
  endif
  assign new_pajama_drop_collection = collections['new-pajama-drop']

  for product_collection in product.collections
    case product_collection.handle
      when 'matching-hawaiian-outfits'
        assign in_matching_hawaiian_outfits = true
      when 'matching-family-vacation-outfits'
        assign in_matching_family_vacation_outfits = true
      when 'mother-daughter-matching-dresses'
        assign in_mother_daughter_matching_dresses = true
      when 'pajamas'
        assign in_pajamas = true
      when 'mommy-and-me'
        assign in_mommy_and_me = true
    endcase
  endfor

  if in_mommy_and_me
    assign pajama_label = 'Shop all Mommy & Me Pajamas'
  endif

  if in_pajamas == false
    assign normalized_product_title = product.title | default: '' | downcase
    assign normalized_product_handle = product.handle | default: '' | downcase
    if normalized_product_title contains 'pajama'
      assign in_pajamas = true
    elsif normalized_product_handle contains 'pajama' or normalized_product_handle contains 'pjs'
      assign in_pajamas = true
    endif
  endif

  comment
    GSC 2026-11-27: Google lands "matching family shirts / sweaters / sweatshirts" (and the local equivalents)
    on single products, so those product pages link to the category hub with that wording (most specific first).
    The rule uses the handle and collection membership so it works when product titles are translated.
  endcomment
  assign hub_handle = blank
  assign hub_holiday_sweaters = false
  assign product_collection_handles = product.collections | map: 'handle'
  assign hub_product_handle = product.handle | default: '' | downcase
  if in_pajamas == false and hub_product_handle contains 'family'
    if product_collection_handles contains 'matching-family-sweatshirts'
      assign hub_handle = 'matching-family-sweatshirts'
    elsif product_collection_handles contains 'family-sweaters'
      assign hub_handle = 'family-sweaters'
      if product_collection_handles contains 'christmas-sweaters'
        assign hub_holiday_sweaters = true
      endif
    elsif product_collection_handles contains 'family-tops'
      assign hub_handle = 'family-tops'
    endif
  endif

  assign hub_prefix = blank
  assign hub_suffix = '.'
  case internal_link_locale
    when 'en'
      assign hub_prefix = 'Browse all '
      assign hub_suffix = ' to compare designs and choose a size for each person.'
      assign hub_sweatshirts = 'matching family sweatshirts and hoodies'
      assign hub_sweaters = 'matching family sweaters'
      assign hub_shirts = 'matching family shirts'
      assign hub_holiday_prefix = 'Shopping for December photos? See our '
      assign hub_holiday = 'family holiday sweaters for Christmas'
    when 'es'
      assign hub_prefix = 'Compara modelos y elige la talla de cada persona: '
      assign hub_sweatshirts = 'sudaderas familiares a juego'
      assign hub_sweaters = 'suéteres familiares'
      assign hub_shirts = 'camisetas familiares a juego'
      assign hub_holiday_prefix = 'Para las fotos de diciembre: '
      assign hub_holiday = 'suéteres navideños para la familia'
    when 'de'
      assign hub_prefix = 'Modelle vergleichen und für jede Person die Größe wählen: '
      assign hub_sweatshirts = 'Familien-Sweatshirts im Partnerlook'
      assign hub_sweaters = 'Familienpullover'
      assign hub_shirts = 'Familien-Shirts im Partnerlook'
      assign hub_holiday_prefix = 'Für Fotos im Dezember: '
      assign hub_holiday = 'Weihnachtspullover für Familie und Geschwister'
    when 'fr'
      assign hub_prefix = 'Comparez les modèles et choisissez une taille pour chaque personne : '
      assign hub_sweatshirts = 'sweats famille assortis'
      assign hub_sweaters = 'pulls assortis pour la famille'
      assign hub_shirts = 't-shirts et chemises assortis pour la famille'
      assign hub_holiday_prefix = 'Pour les photos de décembre : '
      assign hub_holiday = 'pulls de Noël assortis pour la famille'
    when 'it'
      assign hub_prefix = 'Confronta i modelli e scegli la taglia di ogni persona: '
      assign hub_sweatshirts = 'felpe coordinate famiglia'
      assign hub_sweaters = 'maglioni coordinati per la famiglia'
      assign hub_shirts = 'magliette famiglia coordinate'
      assign hub_holiday_prefix = 'Per le foto di dicembre: '
      assign hub_holiday = 'maglioni natalizi per la famiglia'
    when 'cs'
      assign hub_prefix = 'Porovnejte vzory a vyberte velikost pro každého: '
      assign hub_sweatshirts = 'rodinné mikiny'
      assign hub_sweaters = 'rodinné svetry'
      assign hub_shirts = 'rodinná trička'
      assign hub_holiday_prefix = 'Na prosincové fotky: '
      assign hub_holiday = 'vánoční svetry pro celou rodinu'
    when 'ro'
      assign hub_prefix = 'Comparați modelele și alegeți mărimea pentru fiecare: '
      assign hub_sweatshirts = 'hanorace pentru familie'
      assign hub_sweaters = 'pulovere asortate pentru familie'
      assign hub_shirts = 'tricouri asortate pentru familie'
      assign hub_holiday_prefix = 'Pentru fotografiile din decembrie: '
      assign hub_holiday = 'pulovere de Crăciun pentru familie'
    else
      assign hub_handle = blank
  endcase

  case hub_handle
    when 'matching-family-sweatshirts'
      assign hub_label = hub_sweatshirts
    when 'family-sweaters'
      assign hub_label = hub_sweaters
    when 'family-tops'
      assign hub_label = hub_shirts
  endcase

  assign should_render_internal_links = false
  if hub_handle != blank
    assign should_render_internal_links = true
  endif
  if internal_link_locale == 'en'
    if in_matching_hawaiian_outfits or in_matching_family_vacation_outfits or in_mother_daughter_matching_dresses or in_pajamas
      assign should_render_internal_links = true
    endif
  endif
-%}

{%- if should_render_internal_links -%}
  <div class="product__description rte quick-add-hidden product-copy" data-product-internal-links>
    {%- if in_pajamas and internal_link_locale == 'en' -%}
      {%- if collections['pajamas'] != blank -%}
        <p>Keep browsing with <a href="{{ collections['pajamas'].url }}">{{ pajama_label | escape }}</a> for the full pajama lineup in one place.</p>
      {%- endif -%}
      {%- if family_matching_collection != blank -%}
        <p>Want more coordinated outfits beyond bedtime? <a href="{{ family_matching_collection.url }}">Shop Family Matching</a> for dresses, vacation sets, swimsuits, and more.</p>
      {%- endif -%}
      {%- if new_pajama_drop_collection != blank -%}
        <p>Looking for more prints? <a href="{{ new_pajama_drop_collection.url }}">Shop the Mommy and Me Pajama Sets</a> for more matching pajama styles in one place.</p>
      {%- endif -%}
    {%- endif -%}
    {%- if hub_handle != blank and collections[hub_handle] != blank -%}
      <p>{{ hub_prefix }}<a href="{{ collections[hub_handle].url }}">{{ hub_label }}</a>{{ hub_suffix }}</p>
      {%- if hub_holiday_sweaters and collections['christmas-sweaters'] != blank -%}
        <p>{{ hub_holiday_prefix }}<a href="{{ collections['christmas-sweaters'].url }}">{{ hub_holiday }}</a>.</p>
      {%- endif -%}
    {%- endif -%}
    {%- if internal_link_locale == 'en' and in_matching_hawaiian_outfits and collections['matching-hawaiian-outfits'] != blank -%}
      <p>Part of our <a href="{{ collections['matching-hawaiian-outfits'].url }}">{{ collections['matching-hawaiian-outfits'].title | escape }}</a> collection for luaus, beach photos, and tropical vacations.</p>
    {%- endif -%}
    {%- if internal_link_locale == 'en' and in_matching_family_vacation_outfits and collections['matching-family-vacation-outfits'] != blank -%}
      <p>See more <a href="{{ collections['matching-family-vacation-outfits'].url }}">{{ collections['matching-family-vacation-outfits'].title | escape }}</a> for coordinated travel looks, resort dinners, and family photo days.</p>
    {%- endif -%}
    {%- if internal_link_locale == 'en' and in_mother_daughter_matching_dresses and collections['mother-daughter-matching-dresses'] != blank -%}
      <p>Browse the full <a href="{{ collections['mother-daughter-matching-dresses'].url }}">{{ collections['mother-daughter-matching-dresses'].title | escape }}</a> collection for photo-ready outfits, holidays, and special occasions.</p>
    {%- endif -%}
  </div>
{%- endif -%}
