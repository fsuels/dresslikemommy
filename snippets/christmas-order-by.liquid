{%- comment -%}
  Christmas order-by estimate. Renders a hidden line; assets/dlm-delivery-dates.js
  fills in two dates and shows it only while an order placed today could still
  arrive by 23 December under the site's own delivery estimate (same window as
  delivery-estimate-copy, plus made-to-order days, plus 5 days: worst case is 7 calendar days
  (policy: up to 5 business days before shipping) + 14 days carrier transit = 21, against the window maximum of 16;
  keep in step with POLICY_HANDLING_BUFFER_DAYS in assets/dlm-holiday-order-by.js).
  It is an estimate, never a promise.
  The visible estimate (delivery-estimate-copy) is now transit + 5 days (US 12-19); this line deliberately still
  uses the locale window's maximum (16) + 5 = 21 days, which is not earlier than the visible 19-day maximum.
  Needs: `is_christmas` (true/false). Optional: `extra_days` (made-to-order days).
  Removes itself after the last order date, and Liquid stops rendering it after 7 Dec.
  The dated estimate renders for United States shoppers only (carrier transit evidence is US-only);
  every other country sees one neutral line with no date and no arrival promise.
{%- endcomment -%}
{%- liquid
  assign cob_mmdd = 'now' | date: '%m%d' | plus: 0
  if is_christmas and cob_mmdd >= 1101 and cob_mmdd <= 1207 and localization.country.iso_code != 'US'
    comment
      The dated estimate is backed by carrier transit evidence for the United States only.
      Every other country gets one neutral line: no date and no arrival promise.
    endcomment
    assign cob_other = 'products.additional_info.christmas_order_by_other' | t
    if cob_other == blank or cob_other contains 'translation missing'
      assign cob_other = 'Ordering for Christmas? Delivery times vary by country, so order as early as you can.'
    endif
    echo '<p class="dlm-christmas-order-by" data-dlm-christmas-neutral>'
    echo cob_other | escape_once
    echo '</p>'
  elsif is_christmas and cob_mmdd >= 1101 and cob_mmdd <= 1207
    assign cob_window = 'products.additional_info.standard_delivery_window' | t
    if cob_window == blank or cob_window contains 'translation missing' or cob_window contains 'business days'
      assign cob_window = '12-16 days'
    endif
    assign cob_text = 'products.additional_info.christmas_order_by' | t: order_date: '{order}', arrive_date: '{arrive}'
    if cob_text == blank or cob_text contains 'translation missing'
      assign cob_text = 'Estimate: order by {order} to arrive by {arrive}. Not a guarantee.'
    endif
    assign cob_extra = extra_days | plus: 0
    assign cob_max = cob_window | split: ' ' | first | split: '-' | last | plus: 0
    assign cob_max = cob_max | plus: cob_extra | plus: 5
    echo '<p class="dlm-christmas-order-by" hidden data-dlm-christmas-order-by data-max-days="'
    echo cob_max
    echo '" data-text="'
    echo cob_text | escape_once
    echo '"></p>'
  endif
-%}
