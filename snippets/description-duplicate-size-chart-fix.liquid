{%- comment -%}
  Many translated descriptions carry two size charts: the translated one (correct size names) and an
  appended "fallback from source" copy with the same rows and numbers, which the size guide reads and
  which often names the sizes wrong ("Kid 2 years" on the 6-month row). When both have the same number
  of rows, show one chart: the fallback table (the format the size guide parses) with the translated
  chart's size names. When the two sides do not match: if the translated side has fewer or older
  tables (a stale single chart with other rows) it is hidden and the fallback shows; if the translated
  side has more tables than the fallback (the fallback is partial) the fallback is hidden. Product data
  is unchanged.
  - html: translated product description HTML
  - locale: request locale ISO code
{%- endcomment -%}
{%- liquid
  assign chart_html = html
  assign marker = '<!-- DLM localized size-chart fallback from source -->'
  if chart_html contains marker
    assign halves = chart_html | split: marker
    if halves.size == 2
      assign head = halves[0]
      assign tail = halves[1]
      assign head_tables = head | split: '<table'
      assign tail_tables = tail | split: '<table'
      assign drop_side = ''
      if head_tables.size == 2 and tail_tables.size == 2
        assign named_table = head_tables[1] | split: '</table>' | first
        assign source_table = tail_tables[1] | split: '</table>' | first
        assign named_rows = named_table | split: '<tr'
        assign source_rows = source_table | split: '<tr'
        if named_rows.size == source_rows.size and source_rows.size > 2
          assign merged_table = source_rows[0]
          for source_row in source_rows offset: 1
            assign named_row = named_rows[forloop.index]
            assign merged_row = source_row
            if source_row contains '<td' and named_row contains '<td'
              assign source_cells = source_row | split: '<td'
              assign named_cells = named_row | split: '<td'
              assign source_label = source_cells[1] | split: '</td>' | first
              assign named_label = named_cells[1] | split: '</td>' | first
              assign old_cell = '<td' | append: source_label | append: '</td>'
              assign new_cell = '<td' | append: named_label | append: '</td>'
              assign merged_row = source_row | replace_first: old_cell, new_cell
            endif
            assign merged_table = merged_table | append: '<tr' | append: merged_row
          endfor
          assign head_after = head_tables[1] | remove_first: named_table | remove_first: '</table>'
          assign tail_after = tail_tables[1] | remove_first: source_table
          assign chart_html = head_tables[0] | append: head_after | append: marker | append: tail_tables[0] | append: '<table' | append: merged_table | append: tail_after
        else
          assign drop_side = 'head'
        endif
      elsif head_tables.size >= 2 and tail_tables.size >= 2
        if head_tables.size > tail_tables.size
          assign drop_side = 'tail'
        elsif head_tables.size == 2
          assign drop_side = 'head'
        endif
      endif
      if drop_side != ''
        assign drop_parts = head_tables
        if drop_side == 'tail'
          assign drop_parts = tail_tables
        endif
        assign kept = drop_parts[0]
        for part in drop_parts offset: 1
          assign dropped_table = part | split: '</table>' | first
          assign after_table = part | remove_first: dropped_table | remove_first: '</table>'
          assign kept = kept | append: after_table
        endfor
        if drop_side == 'head'
          assign chart_html = kept | append: marker | append: tail
        else
          assign chart_html = head | append: marker | append: kept
        endif
      endif
    endif
  endif
  # Size-chart polish, applied to each size-chart table in the description (product data is unchanged):
  # - Czech: decimal comma (7,5 kg) and Czech plural for ages (1 rok, 2-4 roky, 5+ let).
  # - Every language: columns whose cells are all a dash (for example Pants or Hips on a sweater) are
  #   hidden with CSS only, so the table markup the size guide reads is not changed.
  if chart_html contains '<table' and chart_html contains 'size-chart'
    assign sc_tables = chart_html | split: '<table'
    assign sc_out = sc_tables[0]
    assign sc_css = ''
    for sc_seg in sc_tables offset: 1
      assign sc_idx = forloop.index
      assign sc_body = sc_seg | split: '</table>' | first
      assign sc_rest = sc_seg | slice: sc_body.size, sc_seg.size
      assign sc_open = sc_body | split: '>' | first
      if sc_open contains 'size-chart'
        if locale == 'cs'
          assign sc_body = sc_body | replace: '.5', ',5' | replace: ' 1 let', ' 1 rok' | replace: ' 2 let', ' 2 roky' | replace: ' 3 let', ' 3 roky' | replace: ' 4 let', ' 4 roky' | replace: '-2 let', '-2 roky' | replace: '-3 let', '-3 roky' | replace: '-4 let', '-4 roky' | replace: '–2 let', '–2 roky' | replace: '–3 let', '–3 roky' | replace: '–4 let', '–4 roky'
        endif
        assign sc_safe = true
        if sc_body contains 'colspan' or sc_body contains 'rowspan'
          assign sc_safe = false
        endif
        assign sc_filled = ','
        assign sc_cols = 0
        assign sc_data_rows = 0
        if sc_safe
          assign sc_rows = sc_body | split: '<tr'
          for sc_row in sc_rows offset: 1
            if sc_row contains '<td'
              if sc_row contains '<th'
                assign sc_safe = false
                break
              endif
              assign sc_data_rows = sc_data_rows | plus: 1
              assign sc_cells = sc_row | split: '<td'
              assign sc_n = sc_cells.size | minus: 1
              if sc_n > sc_cols
                assign sc_cols = sc_n
              endif
              for sc_cell in sc_cells offset: 1
                assign sc_text = sc_cell | split: '</td>' | first | strip_html | split: '>' | last | strip
                if sc_text == blank
                  assign sc_text = '-'
                endif
                if sc_text != '-' and sc_text != '–' and sc_text != '—' and sc_text != '--'
                  assign sc_mark = ',' | append: forloop.index | append: ','
                  unless sc_filled contains sc_mark
                    assign sc_filled = sc_filled | append: forloop.index | append: ','
                  endunless
                endif
              endfor
            endif
          endfor
        endif
        if sc_safe and sc_data_rows >= 2 and sc_cols >= 3
          assign sc_hide = ''
          for sc_i in (2..sc_cols)
            assign sc_mark = ',' | append: sc_i | append: ','
            unless sc_filled contains sc_mark
              assign sc_hide = sc_hide | append: sc_i | append: ','
            endunless
          endfor
          if sc_hide != ''
            assign sc_key = 'dlmsc' | append: sc_idx
            assign sc_hide_list = sc_hide | split: ','
            for sc_h in sc_hide_list
              assign sc_css = sc_css | append: 'table[data-dlm-sc="' | append: sc_key | append: '"] tr > :nth-child(' | append: sc_h | append: '){display:none}'
            endfor
            assign sc_open_new = ' data-dlm-sc="' | append: sc_key | append: '"'
            assign sc_body = sc_open_new | append: sc_body
          endif
        endif
      endif
      assign sc_out = sc_out | append: '<table' | append: sc_body | append: sc_rest
    endfor
    if sc_css != ''
      assign sc_out = sc_out | append: '<style>' | append: sc_css | append: '</style>'
    endif
    assign chart_html = sc_out
  endif
  if locale == 'ja'
    assign chart_html = chart_html | replace: 'M神父', 'パパ M' | replace: 'L神父', 'パパ L' | replace: '<td>S 父</td>', '<td>パパ S</td>' | replace: '<td>ファーザー XL</td>', '<td>パパ XL</td>' | replace: '<td>ファーザー 2XL</td>', '<td>パパ 2XL</td>' | replace: '<td>マザー XS</td>', '<td>ママ XS</td>' | replace: '<td>母さん</td>', '<td>ママ S</td>' | replace: '<td>母M</td>', '<td>ママ M</td>' | replace: '<td>マザー L</td>', '<td>ママ L</td>'
  endif
  echo chart_html
-%}
