{% comment %}
  Resolves SEO-focused product image alt text while preserving any existing image-specific copy.

  Accepts:
  - product: Product object
  - media: Product media object (optional)
  - collection: Collection object (optional)
{% endcomment %}

{%- liquid
  assign resolved_product = product
  assign resolved_media = media
  assign resolved_collection = collection
  assign current_collection_handle = collection.handle | default: ''
  assign fallback_title = fallback_title | default: '' | strip
  assign resolved_product_title = resolved_product.title | default: '' | strip
  assign resolved_collection_title = resolved_collection.title | default: '' | strip
  assign resolved_context_title = fallback_title
  if resolved_context_title == blank and resolved_product_title != blank
    assign resolved_context_title = resolved_product_title
  elsif resolved_context_title == blank and resolved_collection_title != blank
    assign resolved_context_title = resolved_collection_title
  endif
  assign raw_alt = ''

  if resolved_media != blank
    assign raw_alt = resolved_media.alt | default: resolved_media.preview_image.alt | default: ''
  elsif resolved_product != blank and resolved_product.featured_media != blank
    assign raw_alt = resolved_product.featured_media.alt | default: resolved_product.featured_media.preview_image.alt | default: ''
  endif
  assign raw_alt = raw_alt | strip

  capture product_context_text
    echo current_collection_handle
    echo ' '
    echo resolved_context_title
    echo ' '
    if resolved_product != blank
      echo resolved_product.title
      echo ' '
      echo resolved_product.type
      echo ' '
      echo resolved_product.handle
      echo ' '
      if resolved_product.collections != blank
        for product_collection in resolved_product.collections
          echo product_collection.handle
          echo ' '
          echo product_collection.title
          echo ' '
        endfor
      endif
    endif
  endcapture
  assign product_context_text = product_context_text | downcase | strip

  assign audience_phrase = 'family matching looks'
  if current_collection_handle == 'swimsuits' or current_collection_handle == 'dresses' or current_collection_handle == 'mommy-and-me' or product_context_text contains 'mommy' or product_context_text contains 'mother-daughter' or product_context_text contains 'mother daughter' or product_context_text contains 'daughter'
    assign audience_phrase = 'mother-daughter matching looks'
  endif

  if current_collection_handle == 'matching-outfits' or current_collection_handle == 'family-matching' or current_collection_handle == 'family-matching-outfits' or current_collection_handle == 'family-swimsuits' or current_collection_handle == 'family-sets' or current_collection_handle == 'new-women-outfits' or product_context_text contains 'family'
    assign audience_phrase = 'family matching looks'
  endif

  if current_collection_handle == 'couples' or product_context_text contains 'couple'
    assign audience_phrase = 'couples matching looks'
  endif

  if current_collection_handle == 'daddy-me' or current_collection_handle == 'daddy-me-t-shirts' or current_collection_handle == 'daddy-me-shirts' or product_context_text contains 'daddy' or product_context_text contains 'father-son' or product_context_text contains 'dad and son'
    assign audience_phrase = 'daddy and me looks'
  endif

  assign product_type_phrase = 'outfit'
  if current_collection_handle == 'family-swimsuits' or current_collection_handle == 'swimsuits' or product_context_text contains 'swimsuit' or product_context_text contains 'bathing suit'
    assign product_type_phrase = 'swimsuit'
  elsif current_collection_handle == 'trunks' or product_context_text contains 'swim trunk'
    assign product_type_phrase = 'swim trunks'
  elsif product_context_text contains 'button-down' or product_context_text contains 'button up' or product_context_text contains 'button-up'
    assign product_type_phrase = 'button-down shirt'
  elsif product_context_text contains 'dress shirt'
    assign product_type_phrase = 'dress shirt'
  elsif product_context_text contains 'hawaiian'
    assign product_type_phrase = 'Hawaiian shirt'
  elsif current_collection_handle == 'dresses' or product_context_text contains 'dress'
    assign product_type_phrase = 'dress'
  elsif product_context_text contains 'pajama'
    assign product_type_phrase = 'pajamas'
  elsif product_context_text contains 'sweater' or product_context_text contains 'cardigan' or product_context_text contains 'jacket'
    assign product_type_phrase = 'sweater'
  elsif product_context_text contains 'shirt' or product_context_text contains 'tee' or product_context_text contains 't-shirt' or product_context_text contains 'top'
    assign product_type_phrase = 'top'
  elsif product_context_text contains 'romper'
    assign product_type_phrase = 'romper'
  elsif product_context_text contains 'jumpsuit'
    assign product_type_phrase = 'jumpsuit'
  elsif product_context_text contains 'skirt'
    assign product_type_phrase = 'skirt'
  elsif product_context_text contains 'legging'
    assign product_type_phrase = 'leggings'
  endif

  assign product_type_phrase_downcase = product_type_phrase | downcase
  assign raw_alt_downcase = raw_alt | downcase
  assign context_has_swim_terms = false
  capture context_swim_text
    echo current_collection_handle
    echo ' '
    echo resolved_context_title
    echo ' '
    echo resolved_collection_title
    echo ' '
    if fallback_title == blank and resolved_product != blank
      echo resolved_product.title
      echo ' '
      echo resolved_product.type
      echo ' '
      echo resolved_product.handle
      echo ' '
      if resolved_product.collections != blank
        for product_collection in resolved_product.collections
          echo product_collection.handle
          echo ' '
          echo product_collection.title
          echo ' '
        endfor
      endif
    endif
  endcapture
  assign context_swim_text = context_swim_text | downcase | strip
  if context_swim_text contains 'swim' or context_swim_text contains 'bathing suit' or context_swim_text contains 'bikini' or context_swim_text contains 'rash guard' or context_swim_text contains 'swim trunk'
    assign context_has_swim_terms = true
  endif
  assign raw_alt_has_swim_terms = false
  if raw_alt_downcase contains 'swim' or raw_alt_downcase contains 'bathing suit' or raw_alt_downcase contains 'bikini' or raw_alt_downcase contains 'rash guard' or raw_alt_downcase contains 'swim trunk'
    assign raw_alt_has_swim_terms = true
  endif
  assign raw_alt_is_generic = false
  if raw_alt_downcase == 'image' or raw_alt_downcase == 'photo' or raw_alt_downcase == 'product' or raw_alt_downcase == 'product image' or raw_alt_downcase == 'collection image' or raw_alt_downcase == 'banner image' or raw_alt_downcase == 'hero image' or raw_alt_downcase == 'featured image'
    assign raw_alt_is_generic = true
  endif

  assign resolved_alt = raw_alt
  assign should_replace_alt = false
  if resolved_alt == blank or raw_alt_is_generic
    assign should_replace_alt = true
  elsif raw_alt_has_swim_terms and context_has_swim_terms == false
    assign should_replace_alt = true
  endif

  if should_replace_alt
    assign resolved_alt = resolved_context_title | default: resolved_product_title | default: product_type_phrase | default: audience_phrase
    assign resolved_alt_downcase = resolved_alt | downcase
    if fallback_title == blank and resolved_alt_downcase contains product_type_phrase_downcase
    elsif fallback_title == blank and resolved_context_title != blank
      assign resolved_alt = resolved_context_title | append: ' ' | append: product_type_phrase
    endif
  elsif raw_alt_downcase contains 'matching' and raw_alt_downcase contains product_type_phrase_downcase and raw_alt_downcase contains audience_phrase
    assign resolved_alt = raw_alt
  endif

  echo resolved_alt | strip | strip_newlines | replace: '  ', ' ' | truncate: 140, ''
-%}
