{%- comment -%}
  One neutral sentence for destinations without carrier transit evidence (see snippets/dlm-transit-map.liquid):
  no dates and no numbers. Kept here, not in locales/*.json, so it does not depend on every locale file
  carrying the key (it.json is edited by another session). Falls back to English for an unlisted locale.
{%- endcomment -%}
{%- liquid
  assign dvc_locale = request.locale.iso_code
  case dvc_locale
    when 'ar'
      echo 'تختلف مدة التوصيل حسب الدولة.'
    when 'cs'
      echo 'Doba doručení se liší podle země.'
    when 'da'
      echo 'Leveringstiden varierer fra land til land.'
    when 'de'
      echo 'Die Lieferzeiten sind je nach Land unterschiedlich.'
    when 'el'
      echo 'Οι χρόνοι παράδοσης διαφέρουν ανά χώρα.'
    when 'es'
      echo 'Los plazos de entrega varían según el país.'
    when 'fi'
      echo 'Toimitusajat vaihtelevat maittain.'
    when 'fr'
      echo 'Les délais de livraison varient selon le pays.'
    when 'he'
      echo 'זמני המשלוח משתנים בהתאם למדינה.'
    when 'hi'
      echo 'डिलीवरी का समय देश के अनुसार अलग-अलग होता है।'
    when 'hr-HR'
      echo 'Rokovi dostave razlikuju se ovisno o zemlji.'
    when 'hu'
      echo 'A szállítási idő országonként eltérő.'
    when 'id'
      echo 'Waktu pengiriman berbeda-beda di setiap negara.'
    when 'it'
      echo 'I tempi di consegna variano a seconda del paese.'
    when 'ja'
      echo 'お届けまでの日数は国によって異なります。'
    when 'ko'
      echo '배송 기간은 국가에 따라 다릅니다.'
    when 'lt-LT'
      echo 'Pristatymo laikas skiriasi priklausomai nuo šalies.'
    when 'nb'
      echo 'Leveringstiden varierer fra land til land.'
    when 'nl'
      echo 'De levertijden verschillen per land.'
    when 'no'
      echo 'Leveringstiden varierer fra land til land.'
    when 'pl'
      echo 'Czas dostawy różni się w zależności od kraju.'
    when 'pt-BR'
      echo 'Os prazos de entrega variam de acordo com o país.'
    when 'pt-PT'
      echo 'Os prazos de entrega variam consoante o país.'
    when 'ro-RO'
      echo 'Timpii de livrare diferă în funcție de țară.'
    when 'ro'
      echo 'Timpii de livrare diferă în funcție de țară.'
    when 'ru'
      echo 'Сроки доставки зависят от страны.'
    when 'sk-SK'
      echo 'Doba doručenia sa líši podľa krajiny.'
    when 'sl-SI'
      echo 'Dobavni roki se razlikujejo glede na državo.'
    when 'sv'
      echo 'Leveranstiderna varierar mellan länder.'
    when 'th'
      echo 'ระยะเวลาจัดส่งแตกต่างกันไปตามประเทศ'
    when 'tr'
      echo 'Teslimat süreleri ülkeye göre değişir.'
    when 'vi'
      echo 'Thời gian giao hàng khác nhau tùy theo quốc gia.'
    when 'zh-CN'
      echo '送达时间因国家/地区而异。'
    when 'zh-TW'
      echo '送達時間依國家/地區而異。'
    else
      echo 'Delivery times vary by country.'
  endcase
-%}
