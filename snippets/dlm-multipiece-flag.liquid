{%- comment -%}
  Prints "true" when one size of the product is a multi-piece garment or a set (two-piece
  swimsuits, bikinis, pajama sets, "sets"), where the words "per piece" could be read as each
  piece being charged separately. Reads title, type and the untranslated tags.
  Needs: product.
{%- endcomment -%}
{%- liquid
  assign mpf_tags = product.tags | join: ' '
  assign mpf_probe = ' ' | append: product.title | append: ' ' | append: product.type | append: ' ' | append: mpf_tags | downcase | append: ' '
  assign mpf_words = 'two-piece,two piece,2-piece,2 piece,bikini,tankini,pajama,pyjama, set , sets , set—, set -' | split: ','
  assign mpf_hit = false
  for mpf_word in mpf_words
    if mpf_probe contains mpf_word
      assign mpf_hit = true
      break
    endif
  endfor
  if mpf_hit
    echo 'true'
  endif
-%}
