{%- comment -%}
  PDP "Perfect for" occasion-based persuasion (CRO Step 10).

  Sits between the buy column and the long description on matching-set
  products. Helps the shopper emotionally justify the purchase ("oh
  yes, family photos are coming up") instead of relying on the long
  description to do that work.

  Render rules:
    - Only when has_matching_set_context is true (computed by
      sections/main-product.liquid).
    - Honestly themed by a section setting so Frank can edit copy in
      the theme editor without changing locale files.

  Inputs (all optional):
    - has_matching_set_context: boolean passed from parent
    - occasions: pipe-separated string fallback (e.g.
      "Family photos|Vacation dinners|Birthday outings")
{%- endcomment -%}

{%- liquid
  assign occ_show = false
  if has_matching_set_context
    assign occ_show = true
  endif

  assign occ_title = 'products.product.occasions.title' | t
  assign occ_title_check = occ_title | downcase
  if occ_title == blank or occ_title_check contains 'translation missing'
    assign occ_title = 'Perfect for'
  endif

  assign occ_list_raw = section.settings.occasion_list | default: occasions | default: blank
  if occ_list_raw == blank
    assign occ_list_raw = 'Family photos|Vacation dinners|Birthday outings|Mommy-and-me summer days'
  endif

  assign occ_items = occ_list_raw | split: '|'
-%}

{%- if occ_show and occ_items.size > 0 -%}
  <style>
    .dlm-pdp-occasions {
      margin: 14px 0 8px;
      padding: 12px 14px;
      background: #fbfdfc;
      border: 1px solid #e7eee9;
      border-radius: 12px;
      color: #1f2937;
    }
    .dlm-pdp-occasions__title {
      margin: 0 0 6px;
      font-size: 0.78em;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
      color: #1D8656;
    }
    .dlm-pdp-occasions__list {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 4px;
      font-size: 0.92em;
      line-height: 1.4;
      color: #1f2937;
    }
    .dlm-pdp-occasions__item {
      display: inline-flex;
      align-items: center;
    }
    .dlm-pdp-occasions__item + .dlm-pdp-occasions__item::before {
      content: '·';
      margin: 0 8px;
      color: #b8c5be;
    }
    @media (max-width: 480px) {
      .dlm-pdp-occasions { padding: 11px 12px; margin: 12px 0 6px; }
      .dlm-pdp-occasions__list { font-size: 0.88em; }
    }
  </style>

  <aside class="dlm-pdp-occasions" aria-label="{{ occ_title | escape }}" style="margin:14px 0 8px;padding:12px 14px;background:#fbfdfc;border:1px solid #e7eee9;border-radius:12px;color:#1f2937;">
    <p class="dlm-pdp-occasions__title" style="margin:0 0 6px;font-size:0.78em;letter-spacing:0.08em;text-transform:uppercase;font-weight:700;color:#1D8656;">{{ occ_title }}</p>
    <ul class="dlm-pdp-occasions__list" style="margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:6px 4px;font-size:0.92em;line-height:1.4;color:#1f2937;">
      {%- for item in occ_items -%}
        {%- assign trimmed = item | strip -%}
        {%- if trimmed != blank -%}
          <li class="dlm-pdp-occasions__item" style="display:inline-flex;align-items:center;list-style:none;">{%- unless forloop.first -%}<span aria-hidden="true" style="margin:0 8px;color:#b8c5be;">·</span>{%- endunless -%}{{ trimmed }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </aside>
{%- endif -%}
