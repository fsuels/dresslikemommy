    when 'mommy-and-me'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.mommy_and_me'
      assign body_description_key = 'sections.collection_seo.body.mommy_and_me_html'
    when 'mommy-and-me-easter-dresses', 'easter-matching-outfits', 'spring-matching-outfits'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.spring_matching'
      assign body_description_key = 'sections.collection_seo.body.spring_matching_html'
    when 'dresses', 'mother-daughter-matching-dresses'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.dresses'
      assign body_description_key = 'sections.collection_seo.body.dresses_html'
    when 'maxi-dresses'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.maxi_dresses'
      assign body_description_key = 'sections.collection_seo.body.maxi_dresses_html'
    when 'swimsuits'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.swimsuits'
      assign body_description_key = 'sections.collection_seo.body.swimsuits_html'
    when 'family-swimsuits'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.family_swimsuits'
      assign body_description_key = 'sections.collection_seo.body.family_swimsuits_html'
    when 'family-sets', 'matching-family-vacation-outfits'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.family_sets'
      assign body_description_key = 'sections.collection_seo.body.family_sets_html'
    when 'new-women-outfits'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.new_women_outfits'
      assign body_description_key = 'sections.collection_seo.body.new_women_outfits_html'
    when 'matching-outfits', 'family-matching', 'family-matching-outfits'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.family_matching'
      assign body_description_key = 'sections.collection_seo.body.family_matching_html'
    when 'daddy-me', 'daddy-and-me'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.daddy_me'
      assign body_description_key = 'sections.collection_seo.body.daddy_me_html'
    when 'daddy-me-t-shirts'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.daddy_me_tshirts'
      assign body_description_key = 'sections.collection_seo.body.daddy_me_tshirts_html'
    when 'daddy-me-shirts'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.daddy_me_shirts'
      assign body_description_key = 'sections.collection_seo.body.daddy_me_shirts_html'
    when 'couples'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.couples'
      assign body_description_key = 'sections.collection_seo.body.couples_html'
    when 'matching-couples-t-shirts'
      assign meta_description_key = 'sections.collection_seo.meta_descriptions.couples_tshirts'
      assign body_description_key = 'sections.collection_seo.body.couples_tshirts_html'
  endcase

  comment
    The translated sections.collection_seo.meta_descriptions.all strings promise
    fast shipping; non-English /collections/all uses the neutral fallback instead.
  endcomment
  if collection_handle == 'all' and seo_lang != 'en'
    assign meta_description_key = ''
  endif

  capture generated_meta_description
    if head_meta_description != blank
      echo head_meta_description
    elsif meta_description_key != blank
      echo meta_description_key | t
    elsif request.locale.iso_code != 'en'
      echo 'storefront.collection_fallback_description' | t: title: effective_display_title
    elsif collection_handle == 'all'
      echo 'Shop all matching outfits in one place, including mommy and me, daddy and me, couples, and family sets. Standard shipping included.'
    elsif collection_handle == 'mommy-and-me'
      echo 'Shop mommy and me outfits, dresses, swimsuits, and matching sets for birthdays, family photos, vacations, and everyday twinning moments.'
    elsif collection_handle == 'mommy-and-me-easter-dresses' or collection_handle == 'easter-matching-outfits' or collection_handle == 'spring-matching-outfits'
      echo 'Shop mommy and me Easter dresses and spring matching outfits for church, brunch, egg hunts, family photos, and other seasonal celebrations.'
    elsif collection_handle == 'dresses' or collection_handle == 'mother-daughter-matching-dresses'
      echo 'Shop mommy and me dresses and mother daughter matching dresses for photos, parties, vacations, and polished everyday wear.'
    elsif collection_handle == 'maxi-dresses'
      echo 'Shop mommy and me maxi dresses and matching maxi dresses for photos, travel, celebrations, and easy polished everyday wear.'
    elsif collection_handle == 'swimsuits'
      echo 'Shop matching family swimsuits and mom and daughter matching swimsuits for beach trips, pool days, cruises, and coordinated summer photos.'
    elsif collection_handle == 'family-swimsuits'
      echo 'Shop matching family bathing suits and family swimwear for beach vacations, pool days, cruises, and coordinated summer photos.'
    elsif collection_handle == 'family-sets' or collection_handle == 'matching-family-vacation-outfits'
      echo 'Shop matching family vacation outfits and beach sets for cruises, resort trips, family photos, and coordinated summer travel looks.'
    elsif collection_handle == 'new-women-outfits'
      echo 'Shop family matching outfits: coordinated dress-and-shirt sets, matching tops and sweaters in adult and kids sizes for family photos, trips and holidays.'
    elsif collection_handle == 'matching-outfits' or collection_handle == 'family-matching' or collection_handle == 'family-matching-outfits'
      echo 'Shop matching outfits for mom, dad and kids: mommy and me dresses, daddy and me shirts, pajamas and swimwear for photos, vacations and holidays.'
    elsif collection_handle == 'daddy-me' or collection_handle == 'daddy-and-me'
      echo "Shop daddy and me shirts, t-shirts, tees, and matching outfits for family photos, Father's Day, vacations, and easy everyday coordination."
    elsif collection_handle == 'daddy-me-t-shirts'
      echo "Shop daddy and me shirts and matching tees for Father's Day, vacations, birthdays, photos, and easy everyday outfits for dads and kids."
    elsif collection_handle == 'daddy-me-shirts'
      echo 'Shop dad and son matching shirts, including button-up, dress shirt, and Hawaiian styles for vacations, photos, parties, and polished family outfits.'
    elsif collection_handle == 'couples'
      echo 'Shop couples matching outfits with coordinated sets, tops, pajamas, and vacation-ready looks for date nights, gifts, trips, and everyday wear.'
    elsif collection_handle == 'matching-couples-t-shirts'
      echo 'Shop couples matching shirts and couple t-shirts for date nights, trips, concerts, holidays, gifts, and easy everyday coordinated looks.'
    else
      echo 'Shop '
      echo effective_display_title | downcase
      echo ' at Dress Like Mommy. Coordinated styles with comfortable fits for photos, holidays, and everyday wear.'
    endif
  endcapture
  assign generated_meta_description = generated_meta_description | strip | strip_newlines | replace: '  ', ' '

  assign head_lead = ''
  assign head_guide_html = ''
  if head_guide != blank
    if field == 'hero_summary' or field == 'body_description'
      case head_guide
        when 'mommy-and-me'
          capture head_lead
            render 'collection-guide-mommy-and-me', field: 'lead'
          endcapture
          if field == 'body_description'
            capture head_guide_html
              render 'collection-guide-mommy-and-me', field: 'guide'
            endcapture
          endif
        when 'christmas-pajamas'
          capture head_lead
            render 'collection-guide-christmas-pajamas', field: 'lead'
          endcapture
          if field == 'body_description'
            capture head_guide_html
              render 'collection-guide-christmas-pajamas', field: 'guide', show_styles: head_show_styles
            endcapture
          endif
        when 'daddy-me'
          capture head_lead
            render 'collection-guide-daddy-me', field: 'lead'
          endcapture
          if field == 'body_description'
            capture head_guide_html
              render 'collection-guide-daddy-me', field: 'guide'
            endcapture
          endif
        when 'swimsuits'
          capture head_lead
            render 'collection-guide-swimsuits', field: 'lead'
          endcapture
          if field == 'body_description'
            capture head_guide_html
              render 'collection-guide-swimsuits', field: 'guide'
            endcapture
          endif
        when 'family-pajamas'
          capture head_lead
            render 'collection-guide-family-pajamas', field: 'lead'
          endcapture
          if field == 'body_description'
            capture head_guide_html
              render 'collection-guide-family-pajamas', field: 'guide'
            endcapture
          endif
      endcase
      assign head_lead = head_lead | strip
      assign head_guide_html = head_guide_html | strip
    endif
  endif

  if en_term_guide and head_lead == blank
    capture head_lead
      render 'collection-guide-english-terms', handle: collection_handle, field: 'lead'
    endcapture
    assign head_lead = head_lead | strip
  endif

  capture generated_body_description
    if head_lead != blank
      echo '<p>'
      echo head_lead
      echo '</p>'
      echo head_guide_html
    elsif seo_lang == 'en' and collection_handle == 'new-women-outfits'
      echo '<p>Matching family outfits put the whole family in one print or color story, so your photos look planned without anyone wearing an identical piece. Most sets pair a dress for mom and daughter with a coordinating shirt for dad and son, and each person is sized separately, with many styles running from baby to adult sizes.</p>'
    elsif body_description_key != blank
      capture translated_body_description
        echo body_description_key | t: title: effective_display_title
      endcapture
      assign translated_body_description = translated_body_description | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&'
      echo translated_body_description
    elsif request.locale.iso_code != 'en'
      echo 'storefront.collection_fallback_body_html' | t: title: effective_display_title
    elsif collection_handle == 'mommy-and-me'
      echo '<p>Shop our '
      echo effective_display_title | escape
      echo ' for birthdays, family photos, vacations, and easy everyday twinning, with dresses, swimsuits, and matching sets all in one place.</p>'
      echo '<p>Start with dresses for portraits and special occasions, move into swimsuits for beach and pool days, and use the broader outfit mix to build a matching wardrobe that works across seasons instead of only one event.</p>'
    elsif collection_handle == 'mommy-and-me-easter-dresses' or collection_handle == 'easter-matching-outfits' or collection_handle == 'spring-matching-outfits'
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' with pastel palettes, spring florals, and occasion-ready looks built for church, brunch, egg hunts, family photos, and other seasonal celebrations.</p>'
      echo '<p>These styles are designed for shoppers who already know the moment they are dressing for and want matching outfits that feel polished, comfortable, and easy to wear again through the rest of spring.</p>'
    elsif collection_handle == 'dresses'
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' for family photos, celebrations, and polished everyday moments, with coordinated dresses in separate sizes for mom and daughter.</p>'
    elsif collection_handle == 'maxi-dresses'
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' for flowing matching styles that feel graceful, easy to wear, and ready for photos, travel, celebrations, and polished everyday moments.</p>'
    elsif collection_handle == 'swimsuits'
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' for beach trips, pool days, cruises, and sunny family photos, with one-pieces, bikinis and rash guards in separate sizes for mom and daughter.</p>'
      echo '<p>Add matching trunks when dad and son want to join the same print or color story.</p>'
    elsif collection_handle == 'family-swimsuits'
      echo '<p>Discover '
      echo effective_display_title | escape
      echo ' for beach vacations, pool days, cruises, and summer photos, when moms, dads, girls, and boys all want to coordinate around one print or color story.</p>'
      echo '<p>Use this page when the whole family wants matching swimwear first, then round out the look with trunks, cover-ups, and related mommy-and-me swim options for a fuller trip wardrobe.</p>'
    elsif collection_handle == 'family-sets' or collection_handle == 'matching-family-vacation-outfits'
      echo '<p>Explore '
      echo effective_display_title | escape
      echo ' with coordinated looks designed for family vacations, beach trips, cruises, travel photos, and warm-weather outings. These sets help you create a clear family palette without forcing every person into the exact same piece.</p>'
      echo '<p>Use this page for matching family vacation outfits and matching family beach outfits, then branch into broader family matching collections when you need more seasonal or non-travel-specific options.</p>'
    elsif collection_handle == 'new-women-outfits'
      echo '<p>Family matching outfits for moms, dads and kids: coordinated dress-and-shirt sets, matching button-up tops, tees and sweaters in the same print, so the whole family looks put together for photos, trips and holidays. Most styles offer adult and kids sizes as separate options, so you can pick the right fit for each person.</p>'
    elsif collection_handle == 'matching-outfits' or collection_handle == 'family-matching' or collection_handle == 'family-matching-outfits'
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' for family photos, travel, birthdays, holidays, and easy everyday twinning. It is the best place to start when you want to compare coordinated looks across the family before narrowing into dresses, swimwear, or vacation sets.</p>'
    elsif collection_handle == 'daddy-me' or collection_handle == 'daddy-and-me'
      echo '<p>Explore '
      echo effective_display_title | escape
      echo " for family photos, vacations, Father's Day gifts, and everyday coordination, with matching tees, casual tops, and dressier shirt options.</p>"
      echo '<p>Pick tees for casual days and button-up or Hawaiian shirts for photos and dressier occasions, and check the size chart on each product page for dad and each child.</p>'
    elsif collection_handle == 'daddy-me-t-shirts'
      echo '<p>Shop '
      echo effective_display_title | escape
      echo " when you want casual, giftable matching tops for dads and kids that work for Father's Day, birthdays, family trips, and quick photo moments.</p>"
      echo '<p>Start here for slogan tees and easy graphic styles, then move into dress shirts or Hawaiian sets if the occasion calls for a sharper look or a more vacation-ready outfit.</p>'
    elsif collection_handle == 'daddy-me-shirts'
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' in button-up, dress shirt, and Hawaiian styles: collared father-son looks for portraits, dinners, beach trips, weddings, and other polished occasions.</p>'
      echo '<p>Compared with casual tees, these styles lean more structured and photo-ready, making them a stronger fit when you want matching outfits that still look elevated.</p>'
    elsif collection_handle == 'couples'
      echo '<p>Explore '
      echo effective_display_title | escape
      echo ' for date nights, vacations, holiday gifting, engagement photos, and everyday coordination.</p>'
      echo '<p>Start with easy tees or lounge sets, then build a more complete outfit around the trip, occasion, or photo moment you are shopping for.</p>'
    elsif collection_handle == 'matching-couples-t-shirts'
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' for a casual, giftable matching look on trips, holidays, concerts, date nights, and photos.</p>'
      echo '<p>Want more than matching tees? See the couples collection for fuller coordinated outfits.</p>'
    else
      echo '<p>Browse '
      echo effective_display_title | escape
      echo ' with '
      echo product_examples_short | escape
      echo ' chosen for '
      echo occasion_label | escape
      echo '.</p>'
    endif
  endcapture
  assign generated_body_description = generated_body_description | strip

  assign generated_hero_summary = generated_body_description
  if generated_body_description contains '</p>'
    assign generated_hero_summary = generated_body_description | split: '</p>' | first | append: '</p>'
  endif
  if generated_hero_summary contains '. '
    assign generated_hero_summary = generated_hero_summary | split: '. ' | first | append: '.</p>'
  endif

  comment
    Head-term guides supply their own one-sentence lead. The translated body
    strings for these two handles open with search-demand wording
    ("for shoppers searching ..."), so their hero uses the meta description.
  endcomment
  if head_lead != blank
    assign generated_hero_summary = '<p>' | append: head_lead | append: '</p>'
  elsif collection_handle == 'matching-couples-t-shirts' or collection_handle == 'daddy-me-shirts'
    if generated_meta_description != blank
      assign hero_meta_escaped = generated_meta_description | escape
      assign generated_hero_summary = '<p>' | append: hero_meta_escaped | append: '</p>'
    endif
  endif

  case field
    when 'display_title'
      echo effective_display_title | strip
    when 'meta_title'
      echo effective_meta_title | strip
    when 'meta_description'
      echo generated_meta_description | truncate: 155, ''
    when 'hero_summary'
      echo generated_hero_summary
    when 'body_description'
      echo generated_body_description
    when 'force_theme_seo'
      if force_theme_seo
        echo 'true'
      endif
  endcase
-%}
