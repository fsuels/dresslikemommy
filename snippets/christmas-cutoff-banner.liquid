{%- comment -%}
  Christmas order-by line near the top of the home page and the Christmas
  collection pages (handle contains "christmas"). It is the same sentence and the
  same date as the PDP value strip: assets/dlm-holiday-order-by.js fills the slot
  from its own COPY table (every language) and its own cutoff maths, and hides the
  slot once the cutoff has passed or the window cannot be parsed. The dated line is for United States shoppers only;
  every other country gets one neutral line from the locale key products.additional_info.christmas_order_by_other
  (no date, no arrival promise), marked data-dlm-neutral so the script leaves it alone. No date and no
  wording lives here. Liquid only decides whether to reserve the space (1 Nov to
  3 Dec) so there is no layout shift; the script is the source of truth for the date.
  Window (US only): derived from snippets/dlm-transit-map.liquid, see the comment below.
  Needs: `link_to_collection` (true on the home page: links to the Christmas matching outfits).
{%- endcomment -%}
{%- liquid
  assign xcb_mmdd = 'now' | date: '%m%d' | plus: 0
  if xcb_mmdd >= 1101 and xcb_mmdd <= 1203
    assign xcb_window = ''
    if localization.country.iso_code == 'US'
      comment
        Cutoff basis for the script (window max + its 5-day buffer = 21 calendar days: 7 days of handling
        plus the US carrier transit maximum from the map). Built from snippets/dlm-transit-map.liquid;
        a country outside the US gets no window attribute at all.
      endcomment
      capture xcb_transit
        render 'dlm-transit-map', country: 'US'
      endcapture
      assign xcb_parts = xcb_transit | strip | split: '-'
      assign xcb_lo = xcb_parts[0] | plus: 5
      assign xcb_hi = xcb_parts[1] | plus: 2
      assign xcb_window = xcb_lo | append: '-' | append: xcb_hi | append: ' days'
    endif
    assign xcb_tag = 'span'
    assign xcb_href = ''
    if link_to_collection
      assign xcb_collection = collections['matching-family-christmas-outfits']
      if xcb_collection != blank
        assign xcb_tag = 'a'
        assign xcb_href = xcb_collection.url
      endif
    endif
    assign xcb_neutral = false
    if localization.country.iso_code != 'US'
      assign xcb_neutral = true
      assign xcb_other = 'products.additional_info.christmas_order_by_other' | t
      if xcb_other == blank or xcb_other contains 'translation missing'
        assign xcb_other = 'Ordering for Christmas? Delivery times vary by country, so order as early as you can.'
      endif
    endif
    echo '<div class="dlm-xmas-banner" data-dlm-xmas-banner'
    if xcb_neutral
      echo ' data-dlm-neutral data-dlm-holiday-order-by="neutral"'
    endif
    if xcb_window != blank
      echo ' data-dlm-christmas-window="'
      echo xcb_window | escape
      echo '"'
    endif
    echo '><div class="page-width"><p class="dlm-xmas-banner__row">'
    echo '<svg class="dlm-xmas-banner__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>'
    if xcb_tag == 'a'
      echo '<a class="dlm-xmas-banner__text" data-dlm-holiday-text href="'
      echo xcb_href
      echo '">'
      if xcb_neutral
        echo xcb_other | escape_once
      endif
      echo '</a>'
    else
      echo '<span class="dlm-xmas-banner__text" data-dlm-holiday-text>'
      if xcb_neutral
        echo xcb_other | escape_once
      endif
      echo '</span>'
    endif
    echo '</p></div></div>'
  endif
-%}
{%- if xcb_mmdd >= 1101 and xcb_mmdd <= 1203 -%}
<style>
  .dlm-xmas-banner { min-height: 4.4rem; padding: 0.7rem 0; color: #146642; font-size: 1.3rem; line-height: 1.45; }
  .dlm-xmas-banner[hidden] { display: none; }
  .dlm-xmas-banner__row { display: flex; align-items: flex-start; justify-content: center; gap: 0.6rem; margin: 0; }
  .dlm-xmas-banner__icon { flex: 0 0 1.5rem; width: 1.5rem; height: 1.5rem; margin-top: 0.1rem; }
  .dlm-xmas-banner__text { min-width: 0; color: inherit; }
  .dlm-xmas-banner a.dlm-xmas-banner__text { text-decoration: underline; text-underline-offset: 2px; }
  .dlm-xmas-banner:not([data-dlm-holiday-order-by]) .dlm-xmas-banner__row { visibility: hidden; }
  @media screen and (min-width: 750px) {
    .dlm-xmas-banner { min-height: 3.4rem; font-size: 1.4rem; }
  }
</style>
{%- endif -%}
