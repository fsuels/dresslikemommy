                            render 'product-image-alt', product: try_product, media: icon_image, collection: block.settings.collection, fallback_title: icon_label
                          endcapture
                          assign icon_image_alt = icon_image_alt | strip
                          assign fallback_icon_found = true
                        endif
                      endunless
                    endfor
                  endif
                -%}
                {%- capture icon_caption -%}
                  {%- render 'home-category-card-caption', icon_label: icon_label -%}
                {%- endcapture -%}
                {%- assign icon_caption = icon_caption | strip -%}
                <li class="category-icons__item" data-homepage-collection-card {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.collection.url }}" class="category-icons__link">
                    <div class="category-icons__image-wrap">
                      {%- if icon_image != blank -%}
                        <img
                          src="{{ icon_image | image_url: width: 900 }}"
                          alt="{{ icon_image_alt | escape }}"
                          loading="eager"
                          width="360"
                          height="450"
                          data-homepage-collection-image
                          data-homepage-collection-image-key="{{ icon_image_key | escape }}"
                        >
                      {%- else -%}
                        {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                    <span class="category-icons__text">
                      <span class="category-icons__label">{{ icon_label }}</span>
                      {%- if icon_caption != blank -%}
                        <span class="category-icons__caption">{{ icon_caption }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                  {%- if homepage_collection_image_candidate_count > 1 -%}
                    <script type="application/json" class="homepage-collection-card__image-candidates">
                      {{- homepage_collection_image_candidates_json -}}
                    </script>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- else -%}
      <ul class="category-icons__scroll" role="list" aria-label="{{ section.settings.title | default: 'Shop by category' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            {%- liquid
              assign icon_label = block.settings.custom_label | default: block.settings.collection.title
              assign icon_image = blank
              assign icon_image_alt = icon_label
              assign icon_image_key = blank
              assign products = block.settings.collection.products
              assign product_count = products.size
              assign featured_collection_count = block.settings.collection.products_count | default: product_count
              assign homepage_collection_image_candidate_count = 0
              assign homepage_collection_image_candidates_json = blank

