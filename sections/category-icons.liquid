                      assign candidate_media_id = candidate_media.id | default: candidate_product.id
                      assign candidate_key = 'image-' | append: candidate_media_id
                      assign candidate_key_token = '|' | append: candidate_key | append: '|'

                      if emitted_candidate_keys contains candidate_key_token
                        continue
                      endif

                      capture candidate_alt
                        render 'product-image-alt', product: candidate_product, media: candidate_media, collection: block.settings.collection, fallback_title: icon_label
                      endcapture
                      assign candidate_alt = candidate_alt | strip

                      if homepage_collection_image_candidate_count > 0
                        echo ','
                      endif

                      echo '{'
                      echo '"key":'
                      echo candidate_key | json
                      echo ',"src":'
                      echo candidate_media | image_url: width: 900 | json
                      echo ',"alt":'
                      echo candidate_alt | json
                      echo ',"width":360,"height":450'
                      echo '}'

                      assign emitted_candidate_keys = emitted_candidate_keys | append: candidate_key | append: '|'
                      assign homepage_collection_image_candidate_count = homepage_collection_image_candidate_count | plus: 1

                      if icon_image == blank
                        unless used_collection_image_keys contains candidate_key_token
                          assign icon_image = candidate_media
                          assign icon_image_key = candidate_key
                          assign icon_image_alt = candidate_alt
                          assign used_collection_image_keys = used_collection_image_keys | append: candidate_key | append: '|'
                        endunless
                      endif
                    endfor

                    echo ']'
                  endcapture
                  assign homepage_collection_image_candidates_json = homepage_collection_image_candidates_json | strip

                  if icon_image == blank and product_count > 0
                    assign start_index = rotation_seed | plus: forloop.index | modulo: product_count
                    assign fallback_icon_found = false

                    for i in (0..product_count)
                      unless fallback_icon_found
                        assign try_index = start_index | plus: i | modulo: product_count
                        assign try_product = products[try_index]

                        if try_product != blank and try_product.featured_image != blank
