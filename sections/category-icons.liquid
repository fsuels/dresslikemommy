{% schema %}
{
  "name": "Category Icons",
  "tag": "section",
  "class": "section section-category-icons",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "display_mode",
      "options": [
        { "value": "single", "label": "Single path" },
        { "value": "grouped", "label": "Group by category and occasion" }
      ],
      "default": "single",
      "label": "Layout"
    },
    {
      "type": "text",
      "id": "category_heading",
      "default": "Shop by category",
      "label": "Category heading"
    },
    {
      "type": "url",
      "id": "category_heading_link",
      "label": "Category heading link"
    },
    {
      "type": "text",
      "id": "occasion_heading",
      "default": "Shop by occasion",
      "label": "Occasion heading"
    },
    {
      "type": "url",
      "id": "occasion_heading_link",
      "label": "Occasion heading link"
    },
    {
      "type": "checkbox",
      "id": "show_trust_strip",
      "default": true,
      "label": "Show trust strip"
    },
    {
      "type": "text",
      "id": "trust_item_1",
      "default": "Free shipping on all orders",
      "label": "Trust item 1"
    },
    {
      "type": "text",
      "id": "trust_item_2",
      "default": "Family matching made easy",
      "label": "Trust item 2"
    },
    {
      "type": "text",
      "id": "trust_item_3",
      "default": "Helpful sizing support",
      "label": "Trust item 3"
    },
    {
      "type": "text",
      "id": "trust_item_4",
      "default": "Responds within 1 business day",
      "label": "Trust item 4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "collection_icon",
      "name": "Collection icon",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Custom label",
          "info": "Overrides collection title"
        },
        {
          "type": "select",
          "id": "browse_path",
          "label": "Browse path",
          "default": "category",
          "options": [
            { "value": "category", "label": "Category" },
            { "value": "occasion", "label": "Occasion" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Icons",
      "blocks": [
        { "type": "collection_icon" },
        { "type": "collection_icon" },
        { "type": "collection_icon" },
        { "type": "collection_icon" },
        { "type": "collection_icon" },
        { "type": "collection_icon" },
        { "type": "collection_icon" },
        { "type": "collection_icon" }
      ]
    }
  ]
}
{% endschema %}
