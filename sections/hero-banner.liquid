{%- liquid
  assign hero_text_scrim = section.settings.text_scrim_opacity | default: 64 | at_least: section.settings.overlay_opacity
-%}
{%- style -%}
  .hero-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.height }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }
  .hero-banner__slides {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-banner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }
  .hero-banner__slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .hero-banner__slide picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Force center focal point so subjects (mommy + child) aren't trimmed
       on narrower viewports where the container ratio shifts. */
    object-position: center center;
  }
  .hero-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
    pointer-events: none;
  }
  /* Transparent foreground art (e.g. arched photo frames), never cropped. */
  .hero-banner__art {
    position: absolute;
    z-index: 1;
    right: 2%;
    bottom: 1.4rem;
    width: 96%;
    height: 60%;
    object-fit: contain;
    object-position: center bottom;
    pointer-events: none;
  }
  .hero-banner__slide-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
  }
  /* base.css hides every empty link (a:empty { display: none }); keep the click-through overlays. */
  .hero-banner a.hero-banner__slide-link,
  .hero-banner a.hero-banner__surface-link {
    display: block;
  }
  .hero-banner__slide-link:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.95);
    outline-offset: -8px;
  }
  .hero-banner__surface-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .hero-banner__surface-link:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.95);
    outline-offset: -8px;
  }
  .hero-banner__content {
    position: relative;
    z-index: 4;
    text-align: center;
    padding: 40px 20px;
    max-width: 700px;
    pointer-events: none;
  }
  .hero-banner__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 16px;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(240, 196, 128, 0.55);
    border-radius: 999px;
    background: rgba(18, 10, 26, 0.35);
    color: #f4d49b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.2;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }
  .hero-banner__eyebrow-icon {
    flex: none;
    width: 10px;
    height: 10px;
  }
  .hero-banner__heading-break {
    display: none;
  }
  .hero-banner__heading {
    color: {{ section.settings.text_color }};
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 12px;
    text-wrap: balance;
  }
  .hero-banner__subheading {
    color: {{ section.settings.text_color }};
    font-size: clamp(14px, 2.5vw, 18px);
    margin: 0 0 24px;
    opacity: 0.9;
  }
  .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    pointer-events: auto;
  }
  .hero-banner__cta {
    position: relative;
    z-index: 4;
    display: inline-block !important;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    color: {{ section.settings.button_text_color }};
    padding: 16px 40px !important;
    font-size: 12px !important;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px !important;
    transition: transform 0.2s ease, opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    letter-spacing: 2.5px !important;
    text-transform: uppercase !important;
    white-space: nowrap;
  }
  .hero-banner__cta--primary {
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%) !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15) !important;
  }
  .hero-banner__cta--secondary {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .hero-banner__cta:hover {
    transform: translateY(-2px) !important;
    opacity: 0.94;
    box-shadow: 0 8px 25px rgba(232, 93, 58, 0.3) !important;
  }
  .hero-banner__trust {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
    margin-top: 18px;
    pointer-events: auto;
  }
  .hero-banner__trust-line {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    opacity: 0.96;
    text-wrap: balance;
  }
  .hero-banner__trust-rating {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.95;
  }
  .hero-banner__trust-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .hero-banner__trust-pill {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.12);
    color: {{ section.settings.text_color }};
    font-size: 13px;
    font-weight: 600;
    line-height: 1.15;
    text-decoration: none;
    backdrop-filter: blur(10px);
  }
  .hero-banner__controls {
    position: absolute;
    right: 20px;
    bottom: 22px;
    left: 20px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    pointer-events: auto;
  }
  .hero-banner__control,
  .hero-banner__dot {
    border: 0;
    cursor: pointer;
    color: #ffffff;
  }
  .hero-banner__control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.26);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .hero-banner__control:hover {
    background: rgba(0, 0, 0, 0.38);
    transform: translateY(-1px);
  }
  .hero-banner__control:focus-visible,
  .hero-banner__dot:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.96);
    outline-offset: 3px;
  }
  .hero-banner__control .icon {
    width: 14px;
    height: 14px;
  }
  .hero-banner__control--prev .icon {
    transform: rotate(90deg);
  }
  .hero-banner__control--next .icon {
    transform: rotate(-90deg);
  }
  .hero-banner__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 0 4px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(8px);
  }
  .hero-banner__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 999px;
    background: transparent;
  }
  .hero-banner__dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    transition: width 0.2s ease, background-color 0.2s ease;
  }
  .hero-banner__dot[aria-current='true']::before {
    width: 28px;
    background: {{ section.settings.button_color }};
  }

  /* Desktop: text on left side over empty scenery */
  @media screen and (min-width: 750px) {
    .hero-banner__image {
      /* Keep center focal point on desktop too; the per-slide
         offsets (58%/64% etc.) were trimming subjects on the left edge. */
      object-position: center center;
    }
    .hero-banner__content {
      text-align: left;
      margin-left: 5%;
      margin-right: auto;
    }
    .hero-banner__actions {
      justify-content: flex-start;
    }
    .hero-banner__heading {
      text-shadow: 0 2px 12px rgba(0,0,0,0.5), 0 1px 3px rgba(0,0,0,0.3);
    }
    .hero-banner__subheading {
      text-shadow: 0 1px 8px rgba(0,0,0,0.5), 0 1px 2px rgba(0,0,0,0.3);
    }
    /* Art slides: the background may crop (per-slide position), the art never does. */
    .hero-banner__slide--art .hero-banner__image {
      object-position: var(--hero-slide-desktop-position, center center);
    }
    .hero-banner__art {
      right: 3%;
      bottom: 1rem;
      width: 52%;
      height: calc(97% - 1rem);
      object-position: center bottom;
    }
    /* Controls sit centered under the arches, clear of the text column. */
    .hero-banner--art .hero-banner__controls {
      left: auto;
      right: 29%;
      bottom: 0.9rem;
      transform: translateX(50%);
    }
    /* !important: theme-inline-body-static-05.css forces a dark pill on every .hero-banner__cta. */
    .hero-banner--buttons-seasonal .hero-banner__cta--primary {
      background: #fbf2e4 !important;
      color: #24152e !important;
      box-shadow: 0 12px 30px rgba(8, 4, 14, 0.35) !important;
      padding: 16px 32px !important;
      letter-spacing: 2px !important;
    }
    .hero-banner--buttons-seasonal .hero-banner__cta--primary:hover {
      background: #fff9f0 !important;
      box-shadow: 0 14px 34px rgba(240, 190, 110, 0.4) !important;
    }
    .hero-banner--buttons-seasonal .hero-banner__cta--secondary {
      background: rgba(251, 242, 228, 0.08) !important;
      color: #fbf2e4 !important;
      border: 1px solid rgba(251, 242, 228, 0.6) !important;
      box-shadow: none !important;
      padding: 15px 22px !important;
      font-size: 11px !important;
      letter-spacing: 1.8px !important;
      backdrop-filter: blur(8px);
    }
    .hero-banner--buttons-seasonal .hero-banner__cta--secondary:hover {
      background: rgba(251, 242, 228, 0.18) !important;
      box-shadow: 0 10px 26px rgba(240, 190, 110, 0.25) !important;
    }
  }

  /* Narrower desktops/tablets: the width-limited art is shorter, so lift it clear of the controls. */
  @media screen and (min-width: 750px) and (max-width: 1399px) {
    .hero-banner__art {
      bottom: 3.6rem;
      height: calc(97% - 3.6rem);
    }
  }

  /* Long translated labels wrap inside the text column instead of running into the art. */
  @media screen and (min-width: 750px) {
    .hero-banner--art .hero-banner__cta {
      max-width: 100%;
      white-space: normal;
      text-align: center;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .hero-banner__eyebrow {
      letter-spacing: 0.12em;
    }
  }

  {%- if request.page_type == 'index' and section.index == 1 -%}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .hero-banner {
        min-height: clamp(500px, 42vw, 680px);
      }

      #shopify-section-{{ section.id }} .hero-banner__content {
        max-width: min(46rem, 42%);
      }

      #shopify-section-{{ section.id }} .hero-banner--art .hero-banner__content {
        max-width: min(58rem, 43%);
      }

      #shopify-section-{{ section.id }} .hero-banner--art .hero-banner__heading {
        font-size: clamp(30px, 3.3vw, 46px);
        line-height: 1.08;
        letter-spacing: -0.01em;
      }

      #shopify-section-{{ section.id }} .hero-banner--art .hero-banner__heading-break {
        display: inline;
      }

      #shopify-section-{{ section.id }} .hero-banner--art .hero-banner__subheading {
        max-width: 54rem;
        font-size: 17px;
        line-height: 1.55;
      }

      #shopify-section-{{ section.id }} .hero-banner__overlay {
        display: block;
        background: linear-gradient(90deg, rgba(0, 0, 0, {{ hero_text_scrim | divided_by: 100.0 }}) 0%, rgba(0, 0, 0, {{ hero_text_scrim | divided_by: 100.0 }}) 48%, rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 72%);
      }

      #shopify-section-{{ section.id }} .hero-banner__heading {
        font-size: clamp(32px, 4vw, 48px);
      }

    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        margin-bottom: 7rem;
      }

      #shopify-section-{{ section.id }} .hero-banner {
        min-height: clamp(400px, 108vw, 460px);
        overflow: visible;
      }

      #shopify-section-{{ section.id }} .hero-banner__content {
        position: absolute;
        right: 0;
        bottom: -5.75rem;
        left: 0;
        min-height: 0;
        max-width: none;
        padding: 0 1.6rem;
      }

      #shopify-section-{{ section.id }} .hero-banner__actions {
        width: min(100%, 32rem);
        margin: 0 auto;
        gap: 0.75rem;
        padding: 1rem;
        border-radius: 2rem;
        background: rgba(255, 252, 248, 0.92);
        box-shadow: 0 1rem 2.4rem rgba(42, 29, 14, 0.16);
        backdrop-filter: blur(12px);
      }

      #shopify-section-{{ section.id }} .hero-banner__cta {
        min-height: 44px;
        padding: 0.95rem 1.3rem !important;
        font-size: 11px !important;
        letter-spacing: 0.16em !important;
        line-height: 1.2;
      }

      #shopify-section-{{ section.id }} .hero-banner__cta--secondary {
        background: rgba(255, 255, 255, 0.94) !important;
        color: #1f1f1f !important;
        border: 1px solid rgba(31, 31, 31, 0.12) !important;
        box-shadow: 0 0.5rem 1.2rem rgba(16, 17, 17, 0.08) !important;
        font-size: 10px !important;
        letter-spacing: 0.1em !important;
      }

      {%- if section.settings.show_mobile_heading -%}
        /*
          Eyebrow + headline over the top of a fixed-height image stage; the CTA card sits in normal
          flow just below it (overlapping the stage edge by 1rem). Longer translated labels grow the
          section instead of covering the controls or the next section.
        */
        #shopify-section-{{ section.id }} {
          margin-bottom: 1.2rem;
        }

        #shopify-section-{{ section.id }} .hero-banner {
          --hero-stage-h: clamp(410px, 112vw, 480px);
          display: block;
          min-height: 0;
          background: transparent;
        }

        #shopify-section-{{ section.id }} .hero-banner__slides,
        #shopify-section-{{ section.id }} .hero-banner__overlay {
          bottom: auto;
          height: var(--hero-stage-h);
        }

        #shopify-section-{{ section.id }} .hero-banner__slides {
          background-color: {{ section.settings.bg_color }};
        }

        #shopify-section-{{ section.id }} .hero-banner__controls {
          top: calc(var(--hero-stage-h) - 1.4rem - 44px);
          bottom: auto;
        }

        #shopify-section-{{ section.id }} .hero-banner__content {
          position: relative;
          inset: auto;
          display: grid;
          grid-template-rows: calc(var(--hero-stage-h) - 2.4rem) auto;
          justify-items: center;
          width: 100%;
          padding: 1.4rem 1.6rem 0;
        }

        #shopify-section-{{ section.id }} .hero-banner__intro {
          grid-row: 1;
          align-self: start;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        #shopify-section-{{ section.id }} .hero-banner__actions {
          grid-row: 2;
          width: min(100%, 32rem);
          margin: 0 auto;
        }

        #shopify-section-{{ section.id }} .hero-banner__eyebrow {
          display: inline-flex;
          margin-bottom: 0.7rem;
          padding: 0.45rem 0.9rem;
          font-size: 10px;
          letter-spacing: 0.18em;
        }

        @media screen and (max-width: 359px) {
          #shopify-section-{{ section.id }} .hero-banner__eyebrow {
            padding: 0.4rem 0.75rem;
            font-size: 9px;
            letter-spacing: 0.1em;
          }
        }

        #shopify-section-{{ section.id }} .hero-banner__heading {
          position: static !important;
          width: auto;
          height: auto;
          margin: 0;
          overflow: visible;
          clip: auto;
          clip-path: none;
          white-space: normal;
          font-size: clamp(21px, 6vw, 26px);
          line-height: 1.12;
          text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
        }

        #shopify-section-{{ section.id }} .hero-banner__art {
          bottom: 4.6rem;
          height: 57%;
        }
      {%- endif -%}
    }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    .hero-banner__image {
      object-position: var(--hero-slide-mobile-position, 60% 30%);
    }

    .hero-banner__scroll-target-highlight {
      animation: hero-scroll-target-highlight-{{ section.id }} 0.9s ease-out;
    }

    .hero-banner__scroll-target-heading-highlight {
      animation: hero-scroll-target-heading-{{ section.id }} 0.9s ease-out;
    }

    .hero-banner__actions {
      flex-direction: column;
      gap: 8px;
    }

    .hero-banner__cta {
      width: 100%;
      white-space: normal;
    }

    .hero-banner__trust-pills {
      width: 100%;
    }

    .hero-banner__trust-pill {
      flex: 1 1 calc(50% - 10px);
    }

    .hero-banner__eyebrow {
      display: none;
    }

    .hero-banner--art .hero-banner__controls {
      bottom: 1.4rem;
    }

    .hero-banner--buttons-seasonal .hero-banner__cta--primary,
    .hero-banner--buttons-seasonal .hero-banner__cta--primary:hover {
      background: linear-gradient(135deg, #2b1838 0%, #43245a 100%) !important;
    }

    .hero-banner__heading {
      position: absolute !important;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      border: 0;
      font-size: 20px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .hero-banner__subheading {
      display: none;
      font-size: 12px;
    }

    .hero-banner__content {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 100%;
      padding: 42% 20px 24px;
    }

    .hero-banner__controls {
      bottom: 4.6rem;
      gap: 8px;
    }

    .hero-banner__control {
      width: 44px;
      height: 44px;
    }

    .hero-banner__dots {
      gap: 0;
      padding: 0 4px;
    }

    {%- if request.page_type == 'index' and section.index == 1 -%}
      #shopify-section-{{ section.id }} .hero-banner__actions {
        flex-direction: row;
        flex-wrap: nowrap;
        gap: 0.5rem;
        padding: 0.85rem;
      }

      #shopify-section-{{ section.id }} .hero-banner__cta {
        flex: 1 1 0;
        width: auto;
        min-width: 0;
        padding: 0.85rem 0.5rem !important;
        font-size: 10px !important;
        letter-spacing: 0.06em !important;
        /* Long single words in some languages (e.g. Finnish) must wrap, not overflow the pill. */
        hyphens: auto;
        overflow-wrap: anywhere;
        /*
          The three buttons stretch to the tallest label; a full pill radius would turn tall
          buttons into circles and push the first line outside the shape. Center the label and
          use a softer radius.
        */
        display: flex !important;
        align-items: center;
        justify-content: center;
        text-align: center;
        border-radius: 2rem !important;
      }

      #shopify-section-{{ section.id }} .hero-banner__trust {
        display: none;
      }
    {%- endif -%}
  }

  @keyframes hero-scroll-target-highlight-{{ section.id }} {
    0% {
      box-shadow: 0 0 0 0 {{ section.settings.button_color | color_modify: 'alpha', 0 }};
      background-color: transparent;
    }
    45% {
      box-shadow: 0 0 0 0.8rem {{ section.settings.button_color | color_modify: 'alpha', 0.22 }};
      background-color: {{ section.settings.button_color | color_modify: 'alpha', 0.1 }};
    }
    100% {
      box-shadow: 0 0 0 0 {{ section.settings.button_color | color_modify: 'alpha', 0 }};
      background-color: transparent;
    }
  }

  @keyframes hero-scroll-target-heading-{{ section.id }} {
    0% {
      transform: translateY(0);
      letter-spacing: normal;
    }
    40% {
      transform: translateY(-2px);
      letter-spacing: 0.08rem;
      color: {{ section.settings.button_color }};
    }
    100% {
      transform: translateY(0);
      letter-spacing: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner__slide,
    .hero-banner__control,
    .hero-banner__dot::before {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) and (max-width: 749px) {
    .hero-banner__scroll-target-highlight {
      animation: none;
      box-shadow: 0 0 0 0.4rem {{ section.settings.button_color | color_modify: 'alpha', 0.22 }};
    }

    .hero-banner__scroll-target-heading-highlight {
      animation: none;
      color: {{ section.settings.button_color }};
    }
  }
{%- endstyle -%}

{%- liquid
  assign hero_button_link = section.settings.button_link | default: ''
  assign hero_button_scroll_target = blank
  assign hero_button_link_first_char = hero_button_link | slice: 0, 1
  assign hero_secondary_button_link = section.settings.secondary_button_link | default: ''
  assign hero_tertiary_button_link = section.settings.tertiary_button_link | default: ''
  assign hero_button_path_prefix = hero_button_link | slice: 0, 13
  assign hero_secondary_button_path_prefix = hero_secondary_button_link | slice: 0, 13
  assign hero_tertiary_button_path_prefix = hero_tertiary_button_link | slice: 0, 13
  if hero_button_path_prefix == '/collections/'
    assign hero_button_link = hero_button_link | replace_first: '/collections', routes.collections_url
  endif
  if hero_secondary_button_path_prefix == '/collections/'
    assign hero_secondary_button_link = hero_secondary_button_link | replace_first: '/collections', routes.collections_url
  endif
  if hero_tertiary_button_path_prefix == '/collections/'
    assign hero_tertiary_button_link = hero_tertiary_button_link | replace_first: '/collections', routes.collections_url
  endif
  assign hero_button_label = section.settings.button_label
  assign hero_secondary_button_label = section.settings.secondary_button_label
  assign hero_tertiary_button_label = section.settings.tertiary_button_label
  assign hero_language_code = localization.language.iso_code | default: request.locale.iso_code | default: shop.locale | default: 'en' | downcase | split: '-' | first
  if hero_language_code != 'en'
    if hero_button_label == 'Shop Mommy & Me'
      capture hero_button_label
        render 'home-category-localized-copy', copy_key: 'mommy-me', fallback: hero_button_label
      endcapture
      assign hero_button_label = hero_button_label | strip
    endif
    if hero_secondary_button_label == 'Shop Family Matching' or hero_secondary_button_label == 'Shop Family Matching Outfits'
      capture hero_secondary_button_label
        render 'home-category-localized-copy', copy_key: 'family-matching', fallback: hero_secondary_button_label
      endcapture
      assign hero_secondary_button_label = hero_secondary_button_label | strip
    endif
    if hero_tertiary_button_label == 'Shop Daddy & Me'
      capture hero_tertiary_button_label
        render 'home-category-localized-copy', copy_key: 'daddy-me', fallback: hero_tertiary_button_label
      endcapture
      assign hero_tertiary_button_label = hero_tertiary_button_label | strip
    endif
  endif

  assign hero_eyebrow = section.settings.eyebrow | strip
  assign hero_heading = section.settings.heading
  assign hero_heading_html = section.settings.heading
  assign hero_subheading_html = section.settings.subheading
  assign hero_seasonal_copy = section.settings.seasonal_copy | default: 'none'
  if hero_seasonal_copy != 'none'
    # Pre-translated copy: Translate & Adapt would keep serving the previous
    # season's translations of the text settings on non-English routes.
    capture hero_eyebrow
      render 'hero-seasonal-copy', edition: hero_seasonal_copy, key: 'eyebrow', lang: hero_language_code
    endcapture
    capture hero_heading
      render 'hero-seasonal-copy', edition: hero_seasonal_copy, key: 'heading', lang: hero_language_code
    endcapture
    capture hero_subheading
      render 'hero-seasonal-copy', edition: hero_seasonal_copy, key: 'subheading', lang: hero_language_code
    endcapture
    capture hero_button_label
      render 'hero-seasonal-copy', edition: hero_seasonal_copy, key: 'cta_primary', lang: hero_language_code
    endcapture
    capture hero_secondary_button_label
      render 'hero-seasonal-copy', edition: hero_seasonal_copy, key: 'cta_secondary', lang: hero_language_code
    endcapture
    capture hero_tertiary_button_label
      render 'hero-seasonal-copy', edition: hero_seasonal_copy, key: 'cta_tertiary', lang: hero_language_code
    endcapture
    assign hero_eyebrow = hero_eyebrow | strip
    assign hero_heading = hero_heading | strip
    # On desktop each sentence starts a new line ("Spooky nights. / Snowy mornings. / ...").
    assign hero_heading_html = hero_heading | escape | replace: '. ', '.<br class="hero-banner__heading-break"> '
    assign hero_subheading_html = hero_subheading | strip | escape
    assign hero_button_label = hero_button_label | strip
    assign hero_secondary_button_label = hero_secondary_button_label | strip
    assign hero_tertiary_button_label = hero_tertiary_button_label | strip
  endif

  assign hero_heading_tag = 'h2'
  assign hero_image_loading = 'lazy'
  assign hero_image_fetchpriority = 'low'
  assign hero_slide_count = 0

  if request.page_type == 'index' and section.index == 1
    assign hero_heading_tag = 'h1'
  endif

  if section.index == 1
    assign hero_image_loading = 'eager'
    assign hero_image_fetchpriority = 'high'
  endif

  if hero_button_link != blank and hero_button_link_first_char == '#'
    assign hero_button_scroll_target = hero_button_link | remove_first: '#'
  endif

  assign hero_has_art = false
  assign hero_has_slide_links = false
  for block in section.blocks
    if block.type == 'slide'
      assign block_theme_asset = block.settings.theme_asset | strip
      assign block_mobile_theme_asset = block.settings.mobile_theme_asset | strip
      if block.settings.image != blank or block.settings.mobile_image != blank or block_theme_asset != blank or block_mobile_theme_asset != blank
        assign hero_slide_count = hero_slide_count | plus: 1
        assign block_art_theme_asset = block.settings.art_theme_asset | strip
        if block_art_theme_asset != blank
          assign hero_has_art = true
        endif
        if block.settings.link != blank
          assign hero_has_slide_links = true
        endif
      endif
    endif
  endfor

  if hero_slide_count == 0
    assign hero_slide_count = 1
  endif
-%}

<div
  class="hero-banner hero-banner--buttons-{{ section.settings.button_style | default: 'dark' }}{% if hero_has_art %} hero-banner--art{% endif %}"
  id="HeroBanner-{{ section.id }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ hero_heading | strip_html | default: shop.name | escape }}"
  data-autoplay-interval="{{ section.settings.autoplay_interval | default: 5 | times: 1000 }}"
>
  <div class="hero-banner__slides" id="HeroBannerSlides-{{ section.id }}">
    {%- assign hero_rendered_slide_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'slide' -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign slide_image = block.settings.image
        assign slide_mobile_image = block.settings.mobile_image
        assign slide_theme_asset = block.settings.theme_asset | strip
        assign slide_mobile_theme_asset = block.settings.mobile_theme_asset | strip

        if slide_image == blank and slide_theme_asset == blank and slide_mobile_image == blank and slide_mobile_theme_asset == blank
          continue
        endif

        if slide_image == blank and slide_theme_asset == blank
          assign slide_image = slide_mobile_image
          assign slide_theme_asset = slide_mobile_theme_asset
        endif

        if slide_mobile_image == blank and slide_mobile_theme_asset == blank
          assign slide_mobile_image = slide_image
          assign slide_mobile_theme_asset = slide_theme_asset
        endif

        assign slide_desktop_position = block.settings.desktop_object_position | strip
        assign slide_mobile_position = block.settings.mobile_object_position | strip
        if slide_desktop_position == blank
          assign slide_desktop_position = 'center center'
        endif
        if slide_mobile_position == blank
          assign slide_mobile_position = slide_desktop_position
        endif

        assign hero_rendered_slide_index = hero_rendered_slide_index | plus: 1
        assign slide_loading = 'lazy'
        assign slide_fetchpriority = 'low'
        if section.index == 1 and hero_rendered_slide_index == 1
          assign slide_loading = hero_image_loading
          assign slide_fetchpriority = hero_image_fetchpriority
        endif

        assign slide_alt = block.settings.image_alt | default: slide_image.alt | default: slide_mobile_image.alt | default: section.settings.heading | default: shop.name | strip
        if hero_seasonal_copy != 'none' and hero_language_code != 'en'
          # New slide blocks have no Translate & Adapt alt text yet; use the edition's translated alt.
          assign slide_alt_key = 'alt_' | append: hero_rendered_slide_index
          capture slide_seasonal_alt
            render 'hero-seasonal-copy', edition: hero_seasonal_copy, key: slide_alt_key, lang: hero_language_code
          endcapture
          assign slide_alt = slide_seasonal_alt | strip | default: slide_alt
        endif
        assign slide_art_base = block.settings.art_theme_asset | strip
        assign slide_image_alt = slide_alt
        if slide_art_base != blank
          # The art layer carries the description; the sky behind it is decorative.
          assign slide_image_alt = ''
        endif

        assign slide_link = ''
        if hero_has_slide_links
          assign slide_link = block.settings.link | default: ''
          assign slide_link_path_prefix = slide_link | slice: 0, 13
          if slide_link_path_prefix == '/collections/'
            assign slide_link = slide_link | replace_first: '/collections', routes.collections_url
          endif
          if slide_link == blank and hero_button_link_first_char != '#'
            assign slide_link = hero_button_link
          endif
        endif
        assign slide_link_label = slide_alt
        if slide_link == hero_button_link
          assign slide_link_label = hero_button_label
        elsif slide_link == hero_secondary_button_link
          assign slide_link_label = hero_secondary_button_label
        elsif slide_link == hero_tertiary_button_link
          assign slide_link_label = hero_tertiary_button_label
        endif
        assign slide_link_label = slide_link_label | default: slide_alt
        assign slide_desktop_img_width = slide_image.width
        assign slide_desktop_img_height = slide_image.height
        if slide_image == blank
          if slide_theme_asset == 'hero-desktop.jpg' or slide_theme_asset == 'hero-family-boardwalk-premium.jpg' or slide_theme_asset == 'hero-halloween-sky.jpg' or slide_theme_asset == 'hero-winter-sky.jpg'
            assign slide_desktop_img_width = 2400
            assign slide_desktop_img_height = 1000
          endif
        endif
        assign slide_img_width = slide_desktop_img_width | default: 2400
        assign slide_img_height = slide_desktop_img_height | default: 1200
        if slide_mobile_image != blank
          assign slide_img_width = slide_mobile_image.width
          assign slide_img_height = slide_mobile_image.height
          assign slide_mobile_src_width = slide_mobile_image.width | at_most: 1200
        elsif slide_mobile_theme_asset != blank and slide_mobile_theme_asset != slide_theme_asset
          assign slide_img_width = 1200
          assign slide_img_height = 1600
        endif
      -%}
      <div
        class="hero-banner__slide{% if slide_art_base != blank %} hero-banner__slide--art{% endif %}{% if hero_rendered_slide_index == 1 %} is-active{% endif %}"
        id="HeroBannerSlide-{{ section.id }}-{{ hero_rendered_slide_index }}"
        role="group"
        aria-roledescription="slide"
        aria-label="Hero image {{ hero_rendered_slide_index }} of {{ hero_slide_count }}"
        aria-hidden="{% if hero_rendered_slide_index == 1 %}false{% else %}true{% endif %}"
        data-hero-slide
        style="--hero-slide-desktop-position: {{ slide_desktop_position | escape }}; --hero-slide-mobile-position: {{ slide_mobile_position | escape }};"
        {{ block.shopify_attributes }}
      >
        {%- if hero_rendered_slide_index > 1 -%}
          <template data-hero-slide-picture>
        {%- endif -%}
        <picture>
          {%- if slide_image != blank -%}
            <source
              media="(min-width: 750px)"
              srcset="{{ slide_image | image_url: width: 750 }} 750w, {{ slide_image | image_url: width: 1100 }} 1100w, {{ slide_image | image_url: width: 1500 }} 1500w, {{ slide_image | image_url: width: 2000 }} 2000w, {{ slide_image | image_url: width: 2400 }} 2400w"
              sizes="100vw"
              width="{{ slide_desktop_img_width }}"
              height="{{ slide_desktop_img_height }}"
            >
          {%- elsif slide_theme_asset != blank -%}
            <source
              media="(min-width: 750px)"
              srcset="{{ slide_theme_asset | asset_url }}"
              {% if slide_desktop_img_width != blank %}
                width="{{ slide_desktop_img_width }}"
                height="{{ slide_desktop_img_height }}"
              {% endif %}
            >
          {%- endif -%}

          {%- if slide_mobile_image != blank -%}
            <img
              class="hero-banner__image"
              src="{{ slide_mobile_image | image_url: width: 1200 }}"
              srcset="
                {%- if slide_mobile_src_width > 320 -%}{{ slide_mobile_image | image_url: width: 320 }} 320w,{%- endif -%}
                {%- if slide_mobile_src_width > 480 -%}{{ slide_mobile_image | image_url: width: 480 }} 480w,{%- endif -%}
                {%- if slide_mobile_src_width > 750 -%}{{ slide_mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if slide_mobile_src_width > 960 -%}{{ slide_mobile_image | image_url: width: 960 }} 960w,{%- endif -%}
                {{ slide_mobile_image | image_url: width: slide_mobile_src_width }} {{ slide_mobile_src_width }}w
              "
              sizes="100vw"
              alt="{{ slide_image_alt | escape }}"
              loading="{{ slide_loading }}"
              fetchpriority="{{ slide_fetchpriority }}"
              decoding="async"
              width="{{ slide_img_width }}"
              height="{{ slide_img_height }}"
            >
          {%- elsif slide_mobile_theme_asset != blank -%}
            <img
              class="hero-banner__image"
              src="{{ slide_mobile_theme_asset | asset_url }}"
              alt="{{ slide_image_alt | escape }}"
              loading="{{ slide_loading }}"
              fetchpriority="{{ slide_fetchpriority }}"
              decoding="async"
              width="{{ slide_img_width }}"
              height="{{ slide_img_height }}"
            >
          {%- endif -%}
        </picture>
        {%- if slide_art_base != blank -%}
          <img
            class="hero-banner__art"
            src="{{ slide_art_base | append: '-1140.webp' | asset_url }}"
            srcset="{{ slide_art_base | append: '-760.webp' | asset_url }} 760w, {{ slide_art_base | append: '-1140.webp' | asset_url }} 1140w, {{ slide_art_base | append: '-1520.webp' | asset_url }} 1520w"
            sizes="(min-width: 750px) 52vw, 96vw"
            alt="{{ slide_alt | escape }}"
            loading="{{ slide_loading }}"
            fetchpriority="{{ slide_fetchpriority }}"
            decoding="async"
            width="1520"
            height="1100"
            onerror="this.hidden = true;"
          >
        {%- endif -%}
        {%- if hero_rendered_slide_index > 1 -%}
          </template>
        {%- endif -%}
        {%- if slide_link != blank -%}
          <a
            href="{{ slide_link | escape }}"
            class="hero-banner__slide-link"
            aria-label="{{ slide_link_label | strip_html | escape }}"
          ></a>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if hero_rendered_slide_index == 0 -%}
      <div
        class="hero-banner__slide is-active"
        id="HeroBannerSlide-{{ section.id }}-1"
        role="group"
        aria-roledescription="slide"
        aria-label="Hero image 1 of 1"
        aria-hidden="false"
        data-hero-slide
        style="--hero-slide-desktop-position: center center; --hero-slide-mobile-position: 60% 30%;"
      >
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign hero_image_alt = section.settings.image.alt | default: section.settings.heading | default: shop.name
            assign hero_image_width = section.settings.image.width | at_most: 2000
          -%}
          {{
            section.settings.image
            | image_url: width: hero_image_width
            | image_tag:
              class: 'hero-banner__image',
              widths: '480, 640, 750, 960, 1200, 1500, 1800, 2000',
              sizes: '100vw',
              alt: hero_image_alt,
              loading: hero_image_loading,
              fetchpriority: hero_image_fetchpriority,
              decoding: 'async'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hero-banner__image' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="hero-banner__overlay"></div>
  {%- if hero_button_link != blank and hero_button_link_first_char != '#' and hero_has_slide_links == false -%}
    <a
      href="{{ hero_button_link | escape }}"
      class="hero-banner__surface-link"
      aria-label="{{ hero_button_label | default: section.settings.heading | escape }}"
    ></a>
  {%- endif -%}
  <div class="hero-banner__content">
    <div class="hero-banner__intro">
      {%- if hero_eyebrow != blank -%}
        <p class="hero-banner__eyebrow">
          <svg class="hero-banner__eyebrow-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16">
            <path d="M8 0 9.3 6.7 16 8 9.3 9.3 8 16 6.7 9.3 0 8 6.7 6.7Z" fill="currentColor"/>
          </svg>
          <span>{{ hero_eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      {%- if hero_heading_html != blank -%}
        <{{ hero_heading_tag }} class="hero-banner__heading">{{ hero_heading_html }}</{{ hero_heading_tag }}>
      {%- endif -%}
    </div>
    {%- if hero_subheading_html != blank -%}
      <p class="hero-banner__subheading">{{ hero_subheading_html }}</p>
    {%- endif -%}
    <div class="hero-banner__actions">
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ hero_button_link | escape }}"
          class="hero-banner__cta hero-banner__cta--primary"
          id="HeroBannerCta-{{ section.id }}"
          {% if hero_button_scroll_target != blank %}
            data-scroll-target="{{ hero_button_scroll_target }}"
          {% endif %}
        >
          {{ hero_button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_button_label != blank and hero_secondary_button_link != blank -%}
        <a
          href="{{ hero_secondary_button_link | escape }}"
          class="hero-banner__cta hero-banner__cta--secondary"
        >
          {{ hero_secondary_button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.tertiary_button_label != blank and hero_tertiary_button_link != blank -%}
        <a
          href="{{ hero_tertiary_button_link | escape }}"
          class="hero-banner__cta hero-banner__cta--secondary"
        >
          {{ hero_tertiary_button_label | escape }}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_trust -%}
      <div class="hero-banner__trust"{% if section.settings.trust_line != blank %} aria-label="{{ section.settings.trust_line | escape }}"{% else %} aria-label="{{ 'sections.cart.trust.secure_checkout' | t | escape }}"{% endif %}>
        {%- if section.settings.trust_line != blank -%}
          <p class="hero-banner__trust-line">{{ section.settings.trust_line }}</p>
        {%- else -%}
          <div class="hero-banner__trust-pills">
            <a class="hero-banner__trust-pill" href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">
              {{ 'sections.cart.trust.free_shipping' | t }}
            </a>
            <a class="hero-banner__trust-pill" href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">
              {{ 'sections.cart.trust.returns' | t }}
            </a>
            <span class="hero-banner__trust-pill">
              {{ 'sections.cart.trust.secure_checkout' | t }}
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if hero_slide_count > 1 -%}
    <div class="hero-banner__controls" aria-label="Hero image controls">
      <button
        type="button"
        class="hero-banner__control hero-banner__control--prev"
        data-hero-prev
        aria-controls="HeroBannerSlides-{{ section.id }}"
        aria-label="Previous hero image"
      >
        {% render 'icon-caret' %}
      </button>
      <div class="hero-banner__dots" role="group" aria-label="Choose hero image">
        {%- assign hero_dot_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign dot_theme_asset = block.settings.theme_asset | strip
            assign dot_mobile_theme_asset = block.settings.mobile_theme_asset | strip
            assign dot_has_image = false
            if block.type == 'slide'
              if block.settings.image != blank or block.settings.mobile_image != blank or dot_theme_asset != blank or dot_mobile_theme_asset != blank
                assign dot_has_image = true
              endif
            endif
          -%}
          {%- unless dot_has_image -%}
            {%- continue -%}
          {%- endunless -%}
          {%- assign hero_dot_index = hero_dot_index | plus: 1 -%}
          <button
            type="button"
            class="hero-banner__dot"
            data-hero-dot="{{ hero_dot_index | minus: 1 }}"
            aria-controls="HeroBannerSlide-{{ section.id }}-{{ hero_dot_index }}"
            aria-label="Show hero image {{ hero_dot_index }} of {{ hero_slide_count }}"
            aria-current="{% if hero_dot_index == 1 %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
      <button
        type="button"
        class="hero-banner__control hero-banner__control--next"
        data-hero-next
        aria-controls="HeroBannerSlides-{{ section.id }}"
        aria-label="Next hero image"
      >
        {% render 'icon-caret' %}
      </button>
    </div>
  {%- endif -%}
</div>

{%- if hero_slide_count > 1 -%}
  <script>
    (() => {
      const root = document.getElementById('HeroBanner-{{ section.id }}');
      if (!root || root.dataset.heroSliderReady === 'true') return;

      const slides = Array.from(root.querySelectorAll('[data-hero-slide], .hero-banner__slide'));
      const previousButton = root.querySelector('[data-hero-prev]');
      const nextButton = root.querySelector('[data-hero-next]');
      const dots = Array.from(root.querySelectorAll('[data-hero-dot]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const autoplayInterval = Math.max(3000, Number(root.dataset.autoplayInterval) || 5000);
      let activeIndex = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
      let autoplayTimer = null;
      let userPaused = false;
      let slideRequestId = 0;

      if (slides.length < 2 || !previousButton || !nextButton || dots.length < 2) return;

      root.dataset.heroSliderReady = 'true';

      function normalizeIndex(index) {
        return (index + slides.length) % slides.length;
      }

      function stopAutoplay() {
        window.clearTimeout(autoplayTimer);
        autoplayTimer = null;
      }

      function canAutoplay() {
        return !userPaused && !reducedMotion.matches && !root.matches(':hover') && !root.contains(document.activeElement);
      }

      function queueAutoplay() {
        stopAutoplay();
        if (!canAutoplay()) return;

        autoplayTimer = window.setTimeout(() => {
          showSlide(activeIndex + 1);
          queueAutoplay();
        }, autoplayInterval);
      }

      function loadSlideImages(slide) {
        const pictureTemplate = slide.querySelector('template[data-hero-slide-picture]');
        if (pictureTemplate) {
          const picture = pictureTemplate.content.cloneNode(true);
          picture.querySelectorAll('img').forEach((image) => {
            image.loading = 'eager';
          });
          pictureTemplate.replaceWith(picture);
        }
        return Array.from(slide.querySelectorAll('img'));
      }

      async function showSlide(index) {
        const nextIndex = normalizeIndex(index);
        const requestId = ++slideRequestId;
        if (nextIndex === activeIndex) return;

        /* Wait for the background and art to decode; a failed art layer is not fatal (it hides itself). */
        const images = loadSlideImages(slides[nextIndex]);
        const results = await Promise.allSettled(images.map((image) => image.decode()));
        const failed = results.some(
          (result, i) =>
            result.status === 'rejected' &&
            !images[i].classList.contains('hero-banner__art') &&
            (!images[i].complete || images[i].naturalWidth === 0)
        );
        if (failed) return;
        if (requestId !== slideRequestId) return;

        const slideHadFocus = slides[activeIndex].contains(document.activeElement);

        slides[activeIndex].classList.remove('is-active');
        slides[activeIndex].setAttribute('aria-hidden', 'true');
        dots[activeIndex].setAttribute('aria-current', 'false');

        activeIndex = nextIndex;

        slides[activeIndex].classList.add('is-active');
        slides[activeIndex].setAttribute('aria-hidden', 'false');
        dots[activeIndex].setAttribute('aria-current', 'true');

        /*
          Keep keyboard focus when the focused slide link is swapped out (arrow keys). The incoming
          slide is still visibility:hidden at the start of its transition, so focus it a beat later.
        */
        if (slideHadFocus) {
          const nextLink = slides[activeIndex].querySelector('.hero-banner__slide-link');
          if (nextLink) window.setTimeout(() => nextLink.focus({ preventScroll: true }), 80);
        }
      }

      function handleUserNavigation(index) {
        userPaused = true;
        stopAutoplay();
        showSlide(index);
      }

      previousButton.addEventListener('click', () => handleUserNavigation(activeIndex - 1));
      nextButton.addEventListener('click', () => handleUserNavigation(activeIndex + 1));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => handleUserNavigation(Number(dot.dataset.heroDot)));
      });

      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', queueAutoplay);
      root.addEventListener('focusin', stopAutoplay);
      root.addEventListener('focusout', () => {
        window.setTimeout(queueAutoplay, 0);
      });
      root.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

        event.preventDefault();
        handleUserNavigation(activeIndex + (event.key === 'ArrowRight' ? 1 : -1));
      });

      if (typeof reducedMotion.addEventListener === 'function') {
        reducedMotion.addEventListener('change', queueAutoplay);
      }

      function queueInitialAutoplay() {
        const startAutoplay = () => {
          if (userPaused) return;
          queueAutoplay();
        };

        const startWhenIdle = () => {
          window.setTimeout(() => {
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(startAutoplay, { timeout: 3000 });
              return;
            }

            startAutoplay();
          }, 2500);
        };

        if (document.readyState === 'complete') {
          startWhenIdle();
          return;
        }

        window.addEventListener('load', startWhenIdle, { once: true });
      }

      queueInitialAutoplay();
    })();
  </script>
{%- endif -%}

{%- if section.settings.button_label != blank -%}
  <script>
    (() => {
      const cta = document.getElementById('HeroBannerCta-{{ section.id }}');
      if (!cta) return;

      const highlightClass = 'hero-banner__scroll-target-highlight';
      const headingHighlightClass = 'hero-banner__scroll-target-heading-highlight';
      const arrivalCueDurationMs = 900;
      let cueCleanupTimer;
      let observedTarget = null;

      const arrivalObserver = 'IntersectionObserver' in window
        ? new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting || entry.target !== observedTarget) return;
              triggerArrivalCue(entry.target);
              arrivalObserver.unobserve(entry.target);
              observedTarget = null;
            });
          }, { threshold: 0, rootMargin: '-20% 0px -45% 0px' })
        : null;

      function getTargetElement() {
        const href = cta.getAttribute('href') || '';

        if (href.startsWith('#') && href.length > 1) {
          return document.getElementById(href.slice(1));
        }

        const targetId = cta.dataset.scrollTarget;
        return targetId ? document.getElementById(targetId) : null;
      }

      function getHeaderOffset() {
        const header = document.querySelector('#shopify-section-header .section-header')
          || document.querySelector('.section-header');
        if (!header) return 0;
        const { height } = header.getBoundingClientRect();
        return height > 0 ? height : 0;
      }

      function triggerArrivalCue(targetElement) {
        window.clearTimeout(cueCleanupTimer);

        const heading = targetElement.querySelector('.collection-list-title, h1, h2');

        targetElement.classList.remove(highlightClass);
        if (heading) heading.classList.remove(headingHighlightClass);

        /* Restart animations for repeated taps. */
        void targetElement.offsetWidth;

        targetElement.classList.add(highlightClass);
        if (heading) heading.classList.add(headingHighlightClass);

        cueCleanupTimer = window.setTimeout(() => {
          targetElement.classList.remove(highlightClass);
          if (heading) heading.classList.remove(headingHighlightClass);
        }, arrivalCueDurationMs + 100);
      }

      cta.addEventListener('click', (event) => {
        const targetElement = getTargetElement();

        if (!targetElement) {
          /* Graceful fallback: if anchor target doesn't exist, allow default navigation. */
          return;
        }

        event.preventDefault();

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const headerOffset = getHeaderOffset();

        /* Scroll to the browse target while keeping it clear of the sticky header. */
        const heroBanner = cta.closest('.section-hero-banner') || cta.closest('.hero-banner');
        const heroRect = heroBanner ? heroBanner.getBoundingClientRect() : null;
        const heroBottom = heroRect
          ? heroRect.bottom + window.pageYOffset
          : 0;
        const targetRect = targetElement.getBoundingClientRect();
        const targetTop = Math.max(
          heroBottom - headerOffset,
          targetRect.top + window.pageYOffset - headerOffset - 24,
          0
        );

        if (arrivalObserver) {
          if (observedTarget) arrivalObserver.unobserve(observedTarget);
          observedTarget = null;

          if (!prefersReducedMotion) {
            observedTarget = targetElement;
            arrivalObserver.observe(targetElement);
          }
        }

        window.scrollTo({
          top: targetTop,
          behavior: prefersReducedMotion ? 'auto' : 'smooth'
        });

        const href = cta.getAttribute('href') || '';
        if (href.startsWith('#') && window.history && typeof window.history.replaceState === 'function') {
          window.history.replaceState(null, '', href);
        }

        if (prefersReducedMotion) {
          triggerArrivalCue(targetElement);
          return;
        }

        if (!arrivalObserver) {
          window.setTimeout(() => {
            triggerArrivalCue(targetElement);
          }, 550);
        }
      });
    })();
  </script>
{%- endif -%}

