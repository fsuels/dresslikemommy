{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-home-curation.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_block_count = 0
  assign section_anchor_id = section.settings.anchor_id | strip | handleize
  for block in section.blocks
    if block.settings.product != blank
      assign visible_block_count = visible_block_count | plus: 1
    endif
  endfor
-%}

{%- if visible_block_count > 0 -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      --home-spotlight-card-bg: {{ section.settings.card_background }};
      --home-hero-accent: {{ section.settings.accent_color }};
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <section
    class="curated-product-grid color-{{ section.settings.color_scheme }} gradient"
    {% if section_anchor_id != blank %}
      id="{{ section_anchor_id }}"
    {% endif %}
    data-analytics-list-id="curated-product-grid-{{ section.id }}"
    data-analytics-list-name="{{ section.settings.title | escape }}"
  >
    <div class="page-width section-{{ section.id }}-padding">
      <div class="curated-product-grid__header">
        <div class="curated-product-grid__heading-group">
          {%- if section.settings.title != blank -%}
            <h2 class="curated-product-grid__title inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="curated-product-grid__intro rte">
              {{ section.settings.intro }}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a
            class="button button--secondary"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="curated-product-grid__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.product == blank -%}
            {%- continue -%}
          {%- endif -%}
          <div {{ block.shopify_attributes }}>
            {% render 'home-spotlight-card',
              spotlight_product: block.settings.product,
              spotlight_badge: block.settings.badge,
              spotlight_caption: block.settings.caption,
              spotlight_button_label: block.settings.button_label,
              section_id: section.id,
              image_sizes: '(min-width: 990px) 22vw, (min-width: 750px) 42vw, 92vw'
            %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Curated Product Grid",
  "tag": "section",
  "class": "section section-curated-product-grid",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Optional. Adds an HTML id for in-page links."
    },
    {
      "type": "text",
      "id": "title",
      "default": "Most-Loved Matching Sets",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Shop all family sets",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "color",
      "id": "card_background",
      "default": "#FFFDFC",
      "label": "Card background"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#C87932",
      "label": "Accent color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32,
      "unit": "px",
      "label": "Padding bottom"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "default": "Most loved",
          "label": "Badge"
        },
        {
          "type": "textarea",
          "id": "caption",
          "default": "Use this slot for the products shoppers engage with most before purchase.",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop This Look",
          "label": "Button label"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Curated Product Grid"
    }
  ]
}
{% endschema %}
