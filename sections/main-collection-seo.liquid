{% if collection != blank %}
  {%- liquid
    capture collection_seo_display_title
      render 'collection-seo-fallback', collection: collection, field: 'display_title'
    endcapture
    assign collection_seo_display_title = collection_seo_display_title | strip

    capture collection_seo_hero_summary
      render 'collection-seo-fallback', collection: collection, field: 'hero_summary'
    endcapture
    assign collection_seo_hero_summary = collection_seo_hero_summary | strip

    capture collection_seo_body_description
      render 'collection-seo-fallback', collection: collection, field: 'body_description'
    endcapture
    assign collection_seo_body_description = collection_seo_body_description | strip
    assign collection_seo_body_description_render = collection_seo_body_description

    if collection_seo_body_description != blank and collection_seo_hero_summary != blank and collection_seo_body_description contains '</p>'
      assign first_body_paragraph = collection_seo_body_description | split: '</p>' | first | append: '</p>' | strip
      if first_body_paragraph == collection_seo_hero_summary
        assign collection_seo_body_description_render = collection_seo_body_description | replace_first: first_body_paragraph, '' | strip
      endif
    endif

    capture collection_seo_rich_content
      render 'collection-seo-content', collection: collection, field: 'rich_content'
    endcapture
    assign collection_seo_rich_content = collection_seo_rich_content | strip
  -%}

  {% if collection.handle == 'swimsuits' %}
    {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
    {{ 'section-collection-seo.css' | asset_url | stylesheet_tag }}

    {%- liquid
      assign related_family_swim_url = routes.collections_url | append: '/family-swimsuits'
      assign related_trunks_url = routes.collections_url | append: '/trunks'
      assign related_mommy_me_url = routes.collections_url | append: '/mommy-and-me'

      assign faq_question_1 = 'What sizes do your matching swimsuits come in?'
      assign faq_answer_1 = 'Sizing varies by style, so review the available variants and use the size chart on each product page before checkout. This collection covers coordinated swim options for moms and daughters, and some styles also connect you to broader family swim looks.'

      assign faq_question_2 = 'Do you offer family sets for dad too?'
      assign faq_answer_2 = 'Yes. If you want the full family look, shop the matching family swimsuits collection and the trunks collection to add coordinated pieces for dads and boys alongside the main mommy and me swim styles.'

      assign faq_question_3 = 'What is the difference between mommy and me swimsuits and matching family swimwear?'
      assign faq_answer_3 = 'Mommy and me swimsuits usually focus on mom-and-daughter pairings. Matching family swimwear expands that idea so you can build a coordinated look across more family members, including dad and boys when those styles are available.'

      assign faq_question_4 = 'Where should I start if I want boys pieces too?'
      assign faq_answer_4 = 'Start on this swimsuits page if you want the broadest swim assortment first, then use the related family swimsuits and trunks collections to narrow into full-family looks or dad-and-boy add-ons.'
    -%}
  {% endif %}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {% if collection.handle == 'swimsuits' %}
    <section class="collection-seo page-width section-{{ section.id }}-padding">
      <div class="collection-seo__panel color-{{ section.settings.color_scheme }} gradient">
        <div class="collection-seo__content">
          <p class="collection-seo__eyebrow">Swimwear Guide</p>
          <h2 class="collection-seo__title">Coordinated swimwear for moms, daughters, and full-family plans</h2>
          <div class="collection-seo__copy">
            <p>Start here when you want the broadest swim assortment first. This page brings together mom-and-daughter styles, matching family swimsuits, and vacation-ready options without sending you through multiple swim collections.</p>
            <p>Once you know who needs to match, move into the dedicated family swimwear or trunks collections for a tighter edit. For sizing, the fastest path is always the product page and size chart on the style you like best.</p>
          </div>
        </div>

        <aside class="collection-seo__aside" aria-label="Related swim collections">
          <p class="collection-seo__aside-label">Explore related swim collections</p>
          <a href="{{ related_family_swim_url }}" class="collection-seo__link-card">
            <span class="collection-seo__link-title">Family Swimwear</span>
            <span class="collection-seo__link-caption">Go straight to the full-family swim edit when everyone needs to coordinate.</span>
          </a>
          <a href="{{ related_trunks_url }}" class="collection-seo__link-card">
            <span class="collection-seo__link-title">Matching Trunks</span>
            <span class="collection-seo__link-caption">Add dad-and-boy swim pieces when you want a complete beach-day set.</span>
          </a>
          <a href="{{ related_mommy_me_url }}" class="collection-seo__link-card">
            <span class="collection-seo__link-title">Mommy &amp; Me</span>
            <span class="collection-seo__link-caption">Keep the coordinated look going beyond swimwear with matching outfits for other occasions.</span>
          </a>
        </aside>
      </div>

      <div class="collection-seo__faq-card color-{{ section.settings.color_scheme }} gradient">
        <div class="collection-seo__faq-header">
          <p class="collection-seo__eyebrow">Swimsuit FAQs</p>
          <h2 class="collection-seo__faq-title">Quick answers before you order</h2>
        </div>

        <div class="collection-seo__faq-list">
          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_1 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>Sizing varies by style, so review the available variants and use the size chart on each product page before checkout. This collection covers coordinated swim options for moms and daughters, and some styles also connect you to broader family swim looks.</p>
              </div>
            </details>
          </div>

          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_2 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>Yes. If you want the full family look, shop the <a href="{{ related_family_swim_url }}">Matching Family Bathing Suits</a> collection and the <a href="{{ related_trunks_url }}">Trunks</a> collection to add coordinated pieces for dads and boys alongside the main mommy and me swim styles.</p>
              </div>
            </details>
          </div>

          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_3 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>Mommy and me swimsuits usually focus on mom-and-daughter pairings. Matching family swimwear expands that idea so you can build a coordinated look across more family members, including dad and boys when those styles are available.</p>
              </div>
            </details>
          </div>

          <div class="accordion">
            <details>
              <summary>
                <div class="summary__title">
                  <h3 class="accordion__title h4">{{ faq_question_4 }}</h3>
                </div>
                {% render 'icon-caret' %}
              </summary>
              <div class="accordion__content rte">
                <p>Start on this swimsuits page if you want the broadest swim assortment first, then use the <a href="{{ related_family_swim_url }}">Matching Family Bathing Suits</a> and <a href="{{ related_trunks_url }}">Trunks</a> collections to narrow into full-family looks or dad-and-boy add-ons.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": {{ faq_question_1 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_1 | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ faq_question_2 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_2 | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ faq_question_3 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_3 | json }}
          }
        },
        {
          "@type": "Question",
          "name": {{ faq_question_4 | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer_4 | json }}
          }
        }
      ]
    }
    </script>
  {% elsif collection_seo_rich_content != blank %}
    {{ 'section-collection-seo.css' | asset_url | stylesheet_tag }}

    <section class="collection-seo-rich page-width page-width--narrow section-{{ section.id }}-padding">
      <div class="collection-seo-rich__panel rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ collection_seo_rich_content }}
      </div>
    </section>

    {% render 'faq-schema-from-html', content: collection_seo_rich_content %}
  {% elsif collection_seo_body_description_render != blank %}
    {{ 'section-collection-seo.css' | asset_url | stylesheet_tag }}

    <section class="collection-seo-rich page-width page-width--narrow section-{{ section.id }}-padding">
      <div class="collection-seo-rich__panel rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        <div class="collection-seo-rich__intro">
          <p class="collection-seo-rich__eyebrow">Collection Note</p>
          <h2>A closer look at {{ collection_seo_display_title | escape }}</h2>
        </div>
        <div class="collection-seo-rich__copy">
          {{ collection_seo_body_description_render }}
        </div>
      </div>
    </section>

    {% render 'faq-schema-from-html', content: collection_seo_body_description_render %}
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Collection SEO content",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ]
}
{% endschema %}
