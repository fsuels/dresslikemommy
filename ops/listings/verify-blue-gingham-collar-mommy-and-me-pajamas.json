  "data": {
    "product": {
      "id": "gid://shopify/Product/9473846247521",
      "title": "Blue Gingham Collar Mommy and Me Pajamas — Button-Up Set",
      "handle": "blue-gingham-collar-mommy-and-me-pajamas",
