          "part_5_html": "<p><a href=\"{{ daddy_me_url }}\">Quay lại bộ sưu tập Bố và Bé đầy đủ</a> nếu bạn muốn có các tùy chọn áo phông, quần dài và áo sơ mi đẹp hơn ở cùng một nơi.</p>",
          "part_6_html": "<p><a href=\"{{ daddy_me_shirts_url }}\">Cần một cái nhìn sắc nét hơn?</a> Duyệt qua những chiếc áo sơ mi phù hợp với cha và con trai để biết phong cách cài cúc, áo sơ mi và phong cách Hawaii.</p>"
        },
        "daddy_me_shirts": {
          "part_1_html": "<h2>Bố và con trai kết hợp áo sơ mi để cài cúc, áo sơ mi và tìm kiếm kiểu Hawaii</h2>",
          "part_2_html": "<p>Trang đích này được xây dựng dựa trên các truy vấn về áo sơ mi có ý định cao nhất trong cụm bố: bố và con trai phù hợp với áo sơ mi cài cúc, bố và con trai phù hợp với áo sơ mi và cha con trai phù hợp với áo sơ mi Hawaii. Nó được thiết kế dành cho những người mua sắm muốn có nhiều cấu trúc, cổ áo và kiểu dáng phù hợp với mọi dịp hơn là một bộ sưu tập áo thun thông thường có thể mang lại.</p>",
          "part_3_html": "<h3>Những dịp tốt nhất cho những phong cách này</h3>",
          "part_4_html": "<ul><li>Những bức ảnh gia đình, những buổi họp mặt trong kỳ nghỉ, đám cưới, nhà thờ và những bữa tối nơi những chiếc áo sơ mi có cổ trông lịch sự hơn.</li><li>Các chuyến đi biển, du lịch trên biển và du lịch nghỉ dưỡng trong đó áo sơ mi Hawaii hoặc cài cúc tay ngắn phù hợp với bối cảnh.</li><li>Quà tặng sinh nhật và Ngày của Cha khi có vẻ ngoài phù hợp sẽ tạo cảm giác cao cấp chứ không chỉ mang tính mới lạ.</li></ul>",
          "part_5_html": "<h3>Điều này khác với áo phông của bố và tôi như thế nào</h3>",
          "part_6_html": "<p>Mong đợi nhiều loại vải dệt hơn, cổ áo sạch hơn và kiểu dáng đẹp hơn. Nếu mục tiêu là đồ họa nhẹ nhàng thông thường hoặc áo mặc hàng ngày thì bộ sưu tập áo thun là điểm khởi đầu tốt hơn.</p>",
          "part_7_html": "<p><a href=\"{{ daddy_me_url }}\">Duyệt qua bộ sưu tập Bố và Bé đầy đủ</a> để có phạm vi bao phủ trang phục rộng hơn trên áo phông, quần dài và các bộ phối hợp.</p>",
          "part_8_html": "<p><a href=\"{{ daddy_me_tshirts_url }}\">Mua áo bố và em</a> nếu bạn muốn một lựa chọn kết hợp nhẹ nhàng hơn, giản dị hơn.</p>"
        },
        "couples": {
          "part_1_html": "<h2>Cặp đôi kết hợp trang phục đi du lịch, hẹn hò, nghỉ lễ và tặng quà</h2>",
          "part_2_html": "<p>Nhóm từ khóa cặp đôi rộng rãi không chỉ riêng về áo thun. Trang này được thiết kế làm trang đích chính dành cho các cặp đôi kết hợp trang phục và vẻ ngoài phối hợp có thể bao gồm áo, quần áo mặc trong nhà, trang phục đi nghỉ và những bộ đồ thường ngày dành cho anh ấy và cô ấy.</p>",
          "part_3_html": "<h3>Ý định mua sắm phổ biến trong danh mục này</h3>",
          "part_4_html": "<ul><li>Các cặp đôi kết hợp trang phục để đi du lịch, lên kế hoạch cuối tuần và chụp ảnh xã hội.</li><li>Những món quà dành cho anh ấy và cô ấy sẽ tìm kiếm những ngày kỷ niệm, tuần trăng mật và những khoảnh khắc trong kỳ nghỉ.</li><li>Trang phục dễ phối hợp giúp giữ màu sắc và hình in phù hợp mà không tạo ra kiểu dáng từ đầu đến chân giống hệt nhau.</li></ul>",
          "part_5_html": "<h3>Bắt đầu từ đâu</h3>",
          "part_6_html": "<p>Nếu mục tiêu là một bộ trang phục bình thường hàng ngày thì áo phông phù hợp là chiến thắng nhanh nhất. Nếu mục tiêu là một cái nhìn phối hợp đầy đủ hơn, hãy bắt đầu với bộ sưu tập các cặp đôi rộng hơn và hướng ra ngoài dựa trên chuyến đi, mùa hoặc dịp.</p>",
          "part_7_html": "<p><a href=\"{{ couples_url }}\">Mua sắm áo sơ mi đôi và áo phông phù hợp</a> khi bạn muốn có một điểm vào danh mục thông thường dễ dàng.</p>"
        },
        "couples_tshirts": {
          "part_1_html": "<h2>Cặp đôi kết hợp áo sơ mi và áo phông để phối đồ giản dị và có thể làm quà tặng</h2>",
          "part_2_html": "<p>Bộ sưu tập này nhắm đến những người mua sắm đang tìm kiếm áo sơ mi cặp đôi, áo sơ mi đôi, áo phông đôi và những chiếc áo phù hợp khác dễ mặc cho những buổi hẹn hò, chuyến đi, ngày lễ, buổi hòa nhạc và trang phục hàng ngày. Đó là điểm vào tốt nhất khi mục đích của người mua hàng rõ ràng là về áo thun trước tiên.</p>",
          "part_3_html": "<h3>Tại sao người mua hàng chọn áo phông phù hợp</h3>",
          "part_4_html": "<ul><li>Chúng rất dễ được tặng quà vào các dịp kỷ niệm, tuần trăng mật, kỳ nghỉ và chuyến đi chơi theo chủ đề.</li><li>Họ giữ vẻ ngoài phối hợp đơn giản mà không cần mua đầy đủ trang phục.</li><li>Chúng phù hợp với những bức ảnh đời thường, những ngày đi du lịch và trang phục hàng ngày ít ma sát.</li></ul>",
          "part_5_html": "<h3>Bạn đang tìm kiếm nhiều thứ hơn là áo phông?</h3>",
          "part_6_html": "<p>Sử dụng trang trang phục phù hợp với các cặp đôi rộng hơn nếu bạn muốn có một cái nhìn phối hợp mở rộng ra ngoài phần ngọn thành một câu chuyện về trang phục hoàn chỉnh hơn.</p>",
          "part_7_html": "<p><a href=\"{{ couples_url }}\">Duyệt qua tất cả các cặp đôi phù hợp với trang phục</a> để có sự kết hợp rộng rãi hơn giữa vẻ ngoài và sự kiện phối hợp.</p>"
        },
        "spring_matching": {
          "part_1_html": "<h2>Váy Phục Sinh của mẹ và con và trang phục phù hợp với mùa xuân cho những dịp đặc biệt</h2>",
          "part_2_html": "<p>Trang này được xây dựng cho các tìm kiếm về Lễ Phục sinh và mùa xuân mà người mua hàng đã biết về dịp này. Trọng tâm là các bảng màu phấn, hoa, vải nhẹ hơn và những hình bóng sẵn sàng để chụp ảnh phù hợp cho nhà thờ, bữa sáng muộn, săn trứng, chân dung gia đình và các lễ kỷ niệm theo mùa khác.</p>",
          "part_3_html": "<h3>Những khoảnh khắc mùa xuân đẹp nhất để kết hợp trang phục</h3>",
          "part_4_html": "<ul><li>Chủ nhật Phục sinh, nhà thờ, bữa sáng muộn và họp mặt gia đình.</li><li>Ảnh gia đình mùa xuân, tiệc ngoài vườn và mùa Ngày của Mẹ.</li><li>Du lịch, tắm vòi sen và các sự kiện thời tiết ấm áp vẫn cần vẻ ngoài lịch sự.</li></ul>",
          "part_5_html": "<h3>Cách sử dụng trang theo mùa này</h3>",
          "part_6_html": "<p>Bắt đầu với những chiếc váy Phục sinh nếu bạn cần một bộ trang phục sự kiện cụ thể, sau đó sử dụng bộ sưu tập tương tự để tìm những bộ trang phục phù hợp với mùa xuân có thể hoạt động trở lại sau kỳ nghỉ lễ.</p>",
          "part_7_html": "<p><a href=\"{{ mommy_and_me_url }}\">Duyệt qua bộ sưu tập Mẹ và Bé đầy đủ</a> nếu bạn muốn có nhiều phong cách kết hợp quanh năm hơn ngoài dịp lễ Phục sinh và mùa xuân.</p>",
          "part_8_html": "<p><a href=\"{{ dresses_url }}\">Mua sắm váy phù hợp</a> để có bản chỉnh sửa tập trung vào trang phục rộng hơn ngoài phong cách mùa xuân theo mùa.</p>"
        }
      }
    }
